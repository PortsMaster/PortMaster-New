float LinearizeDepth(float depth, float near, float far) 
{
    float z = depth * 2.0 - 1.0; // back to NDC 
    return ((2.0 * near * far) / (far + near - z * (far - near))) / far;	
}

float Map(float value, float min1, float max1, float min2, float max2)
{
	float perc = clamp((value - min1) / (max1 - min1), 0.0, 1.0);
	return perc * (max2 - min2) + min2;
}

// Model transforms here are rotation + uniform scale (mirrors included, where
// the inverse-transpose equals the matrix itself), so the normal matrix is just
// the upper 3x3. Doing the inverse per vertex costs far more than it's worth.
vec3 TransformNormal(vec3 normal, mat4 transform)
{
	return normalize(mat3(transform) * normal);
}