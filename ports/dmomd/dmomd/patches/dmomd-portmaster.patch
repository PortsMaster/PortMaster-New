diff --git a/build-port.lisp b/build-port.lisp
new file mode 100644
index 0000000..b3c6958
--- /dev/null
+++ b/build-port.lisp
@@ -0,0 +1,21 @@
+;;;; build-port.lisp - build the standalone PortMaster binary
+;;;; sbcl --dynamic-space-size 512MB --non-interactive --load build-port.lisp
+
+(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
+
+(defparameter *root* (uiop:pathname-directory-pathname *load-truename*))
+
+(push *root* asdf:*central-registry*)
+(dolist (dir (uiop:subdirectories (merge-pathnames "third-party/" *root*)))
+  (push dir asdf:*central-registry*))
+
+(ql:quickload '(:bordeaux-threads :rl-dmomd))
+
+(format t "~&Shared objects in image:~%~{  ~A~%~}"
+        (mapcar #'sb-alien::shared-object-namestring sb-sys:*shared-objects*))
+
+(sb-ext:save-lisp-and-die (merge-pathnames "dmomd.aarch64" *root*)
+                          :executable t
+                          :toplevel (intern "PORTMASTER-MAIN" "RL-DMOMD")
+                          :save-runtime-options t
+                          :compression (and (member :sb-core-compression *features*) t))
