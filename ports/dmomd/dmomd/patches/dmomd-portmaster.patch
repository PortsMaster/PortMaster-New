 (defparameter *should-stop* nil)
 
+(defun draw-frame ()
+  (clear-background +black+)
+  (unless (null *mode*)
+    (mode-draw *mode*))
+  (when *show-fps* (draw-fps 20 20)))
+
 (defun blit ()
   (with-drawing
-    (clear-background +black+)
-    (unless (null *mode*)
-      (mode-draw *mode*))
-    (when *show-fps* (draw-fps 20 20))))
+    (draw-frame)))
+
+(defun blit-scaled (target)
+  "Draw the frame into the 1280x720 TARGET, then letterbox it onto the real screen."
+  (with-texture-mode (target)
+    (draw-frame))
+  (let* ((sw (get-screen-width))
+         (sh (get-screen-height))
+         (scale (min (/ sw *window-width*) (/ sh *window-height*)))
+         (w (* scale *window-width*))
+         (h (* scale *window-height*)))
+    (with-drawing
+      (clear-background +black+)
+      (draw-texture-pro (render-texture-texture target)
+                        (make-rectangle :x 0 :y 0 :width *window-width* :height (- *window-height*))
+                        (make-rectangle :x (/ (- sw w) 2) :y (/ (- sh h) 2) :width w :height h)
+                        (vec2 0 0)
+                        0.0
+                        +white+))))
+
+(defun run-loop ()
+  (if *portmaster-p*
+      (let ((target (load-render-texture *window-width* *window-height*)))
+        (set-texture-filter (render-texture-texture target) raylib::+texture-filter-bilinear+)
+        (unwind-protect
+             (loop until *should-stop* do
+               (act)
+               (blit-scaled target))
+          (unload-render-texture target)))
+      (loop until *should-stop* do
+        (act)
+        (blit))))
 
