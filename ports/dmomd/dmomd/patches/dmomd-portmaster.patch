+;;; SBCL's GC write barrier relies on its own SIGSEGV handler; native init code
+;;; (GPU driver / SDL) must not be allowed to replace it.
+;;;-----------------------------------------------------------------------------
+#+sbcl
+(defparameter *sbcl-owned-signals*
+  '((4 . "SIGILL") (5 . "SIGTRAP") (7 . "SIGBUS") (8 . "SIGFPE") (11 . "SIGSEGV") (12 . "SIGUSR2")))
+
+#+sbcl
+(defconstant +sigaction-slot-size+ 256)
+
+#+sbcl
+(defun %sigaction (sig new old)
+  (sb-alien:alien-funcall
+   (sb-alien:extern-alien "sigaction" (function sb-alien:int sb-alien:int
+                                                sb-sys:system-area-pointer
+                                                sb-sys:system-area-pointer))
+   sig new old))
+
+#+sbcl
+(defun mapping-containing (address)
+  "The /proc/self/maps line whose range contains ADDRESS, or NIL."
+  (with-open-file (in "/proc/self/maps" :if-does-not-exist nil)
+    (when in
+      (loop for line = (read-line in nil)
+            while line
+            do (let* ((dash (position #\- line))
+                      (space (position #\Space line))
+                      (start (parse-integer line :end dash :radix 16))
+                      (end (parse-integer line :start (1+ dash) :end space :radix 16)))
+                 (when (and (<= start address) (< address end))
+                   (return line)))))))
+
+#+sbcl
+(defun call-preserving-signals (label thunk)
+  "Call THUNK, then restore any SBCL-owned signal handler it replaced.
+Nothing may write to the Lisp heap between THUNK returning and the restore."
+  (let* ((n (length *sbcl-owned-signals*))
+         (before (sb-alien:alien-sap (sb-alien:make-alien (sb-alien:unsigned 8) (* n +sigaction-slot-size+))))
+         (after (sb-alien:alien-sap (sb-alien:make-alien (sb-alien:unsigned 8) (* n +sigaction-slot-size+))))
+         (null (sb-sys:int-sap 0)))
+    (loop for (sig . nil) in *sbcl-owned-signals*
+          for off from 0 by +sigaction-slot-size+
+          do (%sigaction sig null (sb-sys:sap+ before off)))
+    (funcall thunk)
+    (loop for (sig . nil) in *sbcl-owned-signals*
+          for off from 0 by +sigaction-slot-size+
+          do (%sigaction sig null (sb-sys:sap+ after off))
+             (unless (= (sb-sys:sap-ref-64 before off) (sb-sys:sap-ref-64 after off))
+               (%sigaction sig (sb-sys:sap+ before off) null)))
+    (loop for (nil . name) in *sbcl-owned-signals*
+          for off from 0 by +sigaction-slot-size+
+          for old = (sb-sys:sap-ref-64 before off)
+          for new = (sb-sys:sap-ref-64 after off)
+          unless (= old new)
+            do (format t "~&SIGNALS: ~A replaced ~A handler #x~X with #x~X (~A), restored SBCL's~%"
+                       label name old new (or (mapping-containing new) "unknown mapping")))
+    (finish-output)))
+
+#+sbcl
+(defconstant +flag-borderless-windowed-mode+ #x00008000)
+
+#+sbcl
+(defun init-window-preserving-signals (width height title)
+  "InitWindow, then go borderless desktop fullscreen: exclusive fullscreen gets an
+emulated, compositor-stretched mode on Wayland instead of the output's real size."
+  (let ((c-title (sb-alien:alien-sap (sb-alien:make-alien-string title))))
+    (call-preserving-signals
+     "InitWindow"
+     (lambda ()
+       (sb-alien:alien-funcall
+        (sb-alien:extern-alien "InitWindow" (function sb-alien:void sb-alien:int sb-alien:int
+                                                      sb-sys:system-area-pointer))
+        width height c-title)
+       (sb-alien:alien-funcall
+        (sb-alien:extern-alien "SetWindowState" (function sb-alien:void sb-alien:unsigned-int))
+        +flag-borderless-windowed-mode+)))))
+
+;;; standalone binary entry point (PortMaster)
+;;;-----------------------------------------------------------------------------
+#+sbcl
+(defun portmaster-main ()
+  (sb-int:set-floating-point-modes :traps nil)
+  (setf *portmaster-p* t)
+  (handler-bind ((error (lambda (e)
+                          (format *error-output* "~&Fatal error: ~A~%" e)
+                          (sb-debug:print-backtrace :stream *error-output* :count 40)
+                          (finish-output *error-output*)
+                          (sb-ext:exit :code 1 :abort t))))
+    (set-asset-path (merge-pathnames "assets/"
+                                     (uiop:pathname-directory-pathname
+                                      (sb-ext:native-pathname sb-ext:*runtime-pathname*))))
+    (main))
+  (finish-output)
+  (sb-ext:exit :code 0))
 
