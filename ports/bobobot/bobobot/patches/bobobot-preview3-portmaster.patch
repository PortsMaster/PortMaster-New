+
+int XDrawImageString(Display *display, Drawable d, GC gc, int x, int y,
+                     _Xconst char *string, int length)
+{
+  xsdl_drawable *dr = get(d);
+  Uint32 fg, bg;
+  int i, row, col, top;
+  unsigned char bits;
+
+  (void)display;
+  if (dr == NULL)
+    return 1;
+
+  fg = pixval(dr, gc->fg);
+  bg = pixval(dr, gc->bg);
+  top = y - FONT_ASCENT;
+
+  for (i = 0; i < length; i++)
+    for (row = 0; row < FONT_ASCENT + FONT_DESCENT; row++)
+      {
+        bits = font6x13[(unsigned char)string[i]][row];
+        for (col = 0; col < FONT_W; col++)
+          plot(dr, gc, x + i * FONT_W + col, top + row,
+               (bits & (0x80 >> col)) ? fg : bg);
+      }
+
+  touched(d);
+  return 1;
+}
