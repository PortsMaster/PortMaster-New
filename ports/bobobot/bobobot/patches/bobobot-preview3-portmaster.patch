+/* --- Pixmaps and drawing ------------------------------------------------- */
+
+Pixmap XCreatePixmap(Display *display, Drawable d, unsigned int width,
+                     unsigned int height, unsigned int depth)
+{
+  (void)display; (void)d;
+  return new_drawable(width, height, depth);
+}
+
+int XFillRectangle(Display *display, Drawable d, GC gc, int x, int y,
+                   unsigned int width, unsigned int height)
+{
+  xsdl_drawable *dr = get(d);
+  Uint32 v;
+  int j;
+
+  (void)display;
+  if (dr == NULL || (int)width <= 0 || (int)height <= 0)
+    return 1;
+
+  v = pixval(dr, gc->fg);
+  for (j = y; j < y + (int)height; j++)
+    fill_span(dr, gc, x, x + (int)width, j, v);
+
+  touched(d);
+  return 1;
+}
+
+int XDrawPoint(Display *display, Drawable d, GC gc, int x, int y)
+{
+  xsdl_drawable *dr = get(d);
+
+  (void)display;
+  if (dr == NULL)
+    return 1;
+  plot(dr, gc, x, y, pixval(dr, gc->fg));
+  touched(d);
+  return 1;
+}
+
+static void thin_line(xsdl_drawable *dr, GC gc, int x1, int y1, int x2, int y2,
+                      Uint32 v)
+{
+  int dx = abs(x2 - x1), sx = x1 < x2 ? 1 : -1;
+  int dy = -abs(y2 - y1), sy = y1 < y2 ? 1 : -1;
+  int err = dx + dy, e2;
+
+  for (;;)
+    {
+      plot(dr, gc, x1, y1, v);
+      if (x1 == x2 && y1 == y2)
+        break;
+      e2 = 2 * err;
+      if (e2 >= dy)
+        {
+          err += dy;
+          x1 += sx;
+        }
+      if (e2 <= dx)
+        {
+          err += dx;
+          y1 += sy;
+        }
+    }
+}
+
+int XDrawLine(Display *display, Drawable d, GC gc, int x1, int y1, int x2,
+              int y2)
+{
+  xsdl_drawable *dr = get(d);
+  Uint32 v;
+
+  (void)display;
+  if (dr == NULL)
+    return 1;
+
+  v = pixval(dr, gc->fg);
+
+  if (gc->line_width <= 1)
+    thin_line(dr, gc, x1, y1, x2, y2, v);
+  else
+    {
+      /* Wide line, butt caps: a rectangle around the segment. */
+      double dx = x2 - x1, dy = y2 - y1, len = SDL_sqrt(dx * dx + dy * dy);
+      double hw = gc->line_width / 2.0, nx, ny, px[4], py[4];
+
+      if (len == 0)
+        return 1;
+      nx = -dy / len * hw;
+      ny = dx / len * hw;
+      px[0] = x1 + nx; py[0] = y1 + ny;
+      px[1] = x2 + nx; py[1] = y2 + ny;
+      px[2] = x2 - nx; py[2] = y2 - ny;
+      px[3] = x1 - nx; py[3] = y1 - ny;
+      fill_poly(dr, gc, px, py, 4, v);
+    }
+
+  touched(d);
+  return 1;
+}
+
+int XDrawRectangle(Display *display, Drawable d, GC gc, int x, int y,
+                   unsigned int width, unsigned int height)
+{
+  int w = (int)width, h = (int)height;
+  int saved = gc->line_width;
+
+  gc->line_width = 0;
+  XDrawLine(display, d, gc, x, y, x + w, y);
+  XDrawLine(display, d, gc, x + w, y, x + w, y + h);
+  XDrawLine(display, d, gc, x + w, y + h, x, y + h);
+  XDrawLine(display, d, gc, x, y + h, x, y);
+  gc->line_width = saved;
+  return 1;
+}
+
+/* Only full ellipses are used by the game. */
+int XDrawArc(Display *display, Drawable d, GC gc, int x, int y,
+             unsigned int width, unsigned int height, int angle1, int angle2)
+{
+  xsdl_drawable *dr = get(d);
+  double cx, cy, rx, ry, hw, ox, oy, ix, iy, fx, fy;
+  int px, py;
+  Uint32 v;
+
+  (void)display; (void)angle1; (void)angle2;
+  if (dr == NULL)
+    return 1;
+
+  v = pixval(dr, gc->fg);
+  cx = x + width / 2.0;
+  cy = y + height / 2.0;
+  rx = width / 2.0;
+  ry = height / 2.0;
+  hw = (gc->line_width <= 1 ? 1 : gc->line_width) / 2.0;
+  ox = rx + hw; oy = ry + hw;
+  ix = rx - hw; iy = ry - hw;
+
+  for (py = (int)SDL_floor(cy - oy); py <= (int)SDL_ceil(cy + oy); py++)
+    for (px = (int)SDL_floor(cx - ox); px <= (int)SDL_ceil(cx + ox); px++)
+      {
+        fx = px + 0.5 - cx;
+        fy = py + 0.5 - cy;
+        if ((fx * fx) / (ox * ox) + (fy * fy) / (oy * oy) > 1.0)
+          continue;
+        if (ix > 0 && iy > 0 &&
+            (fx * fx) / (ix * ix) + (fy * fy) / (iy * iy) < 1.0)
+          continue;
+        plot(dr, gc, px, py, v);
+      }
+
+  touched(d);
+  return 1;
+}
+
+int XFillPolygon(Display *display, Drawable d, GC gc, XPoint *points,
+                 int npoints, int shape, int mode)
+{
+  xsdl_drawable *dr = get(d);
+  double px[64], py[64];
+  int i, cx = 0, cy = 0;
+
+  (void)display; (void)shape;
+  if (dr == NULL || npoints < 3 || npoints > 64)
+    return 1;
+
+  for (i = 0; i < npoints; i++)
+    {
+      if (mode == CoordModePrevious && i > 0)
+        {
+          cx += points[i].x;
+          cy += points[i].y;
+        }
+      else
+        {
+          cx = points[i].x;
+          cy = points[i].y;
+        }
+      px[i] = cx;
+      py[i] = cy;
+    }
+
+  fill_poly(dr, gc, px, py, npoints, pixval(dr, gc->fg));
+  touched(d);
+  return 1;
+}
+
+int XCopyArea(Display *display, Drawable src, Drawable dest, GC gc,
+              int src_x, int src_y, unsigned int width, unsigned int height,
+              int dest_x, int dest_y)
+{
+  xsdl_drawable *s = get(src), *d = get(dest);
+  int i, j, sx, sy, dx, dy;
+
+  (void)display;
+  if (s == NULL || d == NULL)
+    return 1;
+
+  for (j = 0; j < (int)height; j++)
+    {
+      sy = src_y + j;
+      dy = dest_y + j;
+      if (sy < 0 || sy >= s->h || dy < 0 || dy >= d->h)
+        continue;
+      for (i = 0; i < (int)width; i++)
+        {
+          sx = src_x + i;
+          dx = dest_x + i;
+          if (sx < 0 || sx >= s->w || dx < 0 || dx >= d->w)
+            continue;
+          if (gc->clip_mask != None && !mask_ok(gc, dx, dy))
+            continue;
+          d->px[dy * d->w + dx] = s->px[sy * s->w + sx];
+        }
+    }
+
+  touched(dest);
+  return 1;
+}
