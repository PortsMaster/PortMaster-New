+/* --- Display / window ---------------------------------------------------- */
+
+Display *XOpenDisplay(_Xconst char *name)
+{
+  _XPrivDisplay dpy;
+
+  (void)name;
+
+  if (SDL_InitSubSystem(SDL_INIT_VIDEO | SDL_INIT_EVENTS) < 0)
+    {
+      fprintf(stderr, "xsdl: SDL_Init: %s\n", SDL_GetError());
+      return NULL;
+    }
+
+  fps_log = getenv("BOBOBOT_FPS") != NULL;
+  fps_start = SDL_GetTicks();
+
+  drawables[ROOT_ID].used = 1;
+  drawables[ROOT_ID].w = 0;
+  drawables[ROOT_ID].h = 0;
+  drawables[ROOT_ID].depth = 24;
+
+  memset(&xsdl_visual, 0, sizeof(xsdl_visual));
+#if defined(__cplusplus) || defined(c_plusplus)
+  xsdl_visual.c_class = TrueColor;
+#else
+  xsdl_visual.class = TrueColor;
+#endif
+  xsdl_visual.red_mask = 0xFF0000;
+  xsdl_visual.green_mask = 0x00FF00;
+  xsdl_visual.blue_mask = 0x0000FF;
+  xsdl_visual.bits_per_rgb = 8;
+  xsdl_visual.map_entries = 256;
+
+  memset(&xsdl_screen, 0, sizeof(xsdl_screen));
+  xsdl_screen.root = ROOT_ID;
+  xsdl_screen.root_depth = 24;
+  xsdl_screen.root_visual = &xsdl_visual;
+  xsdl_screen.white_pixel = 0xFFFFFF;
+  xsdl_screen.black_pixel = 0x000000;
+  xsdl_screen.cmap = 1;
+  xsdl_screen.width = 320;
+  xsdl_screen.height = 256;
+
+  dpy = calloc(1, sizeof(*dpy));
+  dpy->screens = &xsdl_screen;
+  dpy->nscreens = 1;
+  dpy->default_screen = 0;
+  xsdl_screen.display = (Display *)dpy;
+  xsdl_display = (Display *)dpy;
+
+  memset(&xsdl_font, 0, sizeof(xsdl_font));
+  xsdl_font.ascent = FONT_ASCENT;
+  xsdl_font.descent = FONT_DESCENT;
+  xsdl_font.min_bounds.width = FONT_W;
+  xsdl_font.max_bounds.width = FONT_W;
+  xsdl_font.max_bounds.ascent = FONT_ASCENT;
+  xsdl_font.max_bounds.descent = FONT_DESCENT;
+
+  return xsdl_display;
+}
+
+Window XCreateWindow(Display *display, Window parent, int x, int y,
+                     unsigned int width, unsigned int height,
+                     unsigned int border_width, int depth, unsigned int class,
+                     Visual *visual, unsigned long valuemask,
+                     XSetWindowAttributes *attributes)
+{
+  xsdl_drawable *w;
+
+  (void)display; (void)parent; (void)x; (void)y; (void)border_width;
+  (void)depth; (void)class; (void)visual; (void)valuemask; (void)attributes;
+
+  xsdl_window_id = new_drawable(width, height, 24);
+  w = get(xsdl_window_id);
+  memset(w->px, 0, (size_t)w->w * w->h * 4);
+  {
+    int i;
+    for (i = 0; i < w->w * w->h; i++)
+      w->px[i] = 0xFF000000u;
+  }
+
+  SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, "0");
+  SDL_SetHint(SDL_HINT_RENDER_VSYNC, "0");
+
+  sdl_window = SDL_CreateWindow("BoboBot", SDL_WINDOWPOS_UNDEFINED,
+                                SDL_WINDOWPOS_UNDEFINED, width * 2, height * 2,
+                                SDL_WINDOW_FULLSCREEN_DESKTOP);
+  if (sdl_window == NULL)
+    {
+      fprintf(stderr, "xsdl: SDL_CreateWindow: %s\n", SDL_GetError());
+      exit(1);
+    }
+
+  sdl_renderer = SDL_CreateRenderer(sdl_window, -1, SDL_RENDERER_ACCELERATED);
+  if (sdl_renderer == NULL)
+    sdl_renderer = SDL_CreateRenderer(sdl_window, -1, 0);
+  if (sdl_renderer == NULL)
+    {
+      fprintf(stderr, "xsdl: SDL_CreateRenderer: %s\n", SDL_GetError());
+      exit(1);
+    }
+
+  SDL_RenderSetLogicalSize(sdl_renderer, width, height);
+
+  sdl_texture = SDL_CreateTexture(sdl_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                  SDL_TEXTUREACCESS_STREAMING, width, height);
+  if (sdl_texture == NULL)
+    {
+      fprintf(stderr, "xsdl: SDL_CreateTexture: %s\n", SDL_GetError());
+      exit(1);
+    }
+
+  SDL_ShowCursor(SDL_DISABLE);
+
+  {
+    SDL_RendererInfo info;
+    int ow, oh;
+    SDL_GetRendererInfo(sdl_renderer, &info);
+    SDL_GetRendererOutputSize(sdl_renderer, &ow, &oh);
+    fprintf(stderr, "(xsdl: %s renderer, %dx%d output)...", info.name, ow, oh);
+  }
+
+  present();
+  return xsdl_window_id;
+}
