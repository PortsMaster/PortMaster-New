+/* --- Bitmaps ------------------------------------------------------------- */
+
+int XReadBitmapFile(Display *display, Drawable d, _Xconst char *filename,
+                    unsigned int *width_return, unsigned int *height_return,
+                    Pixmap *bitmap_return, int *x_hot_return,
+                    int *y_hot_return)
+{
+  FILE *f;
+  char line[512], *p, *end;
+  int w = 0, h = 0, n = 0, bpl, i, b;
+  long val;
+  xsdl_drawable *bm;
+  Pixmap pm;
+
+  (void)display; (void)d;
+
+  f = fopen(filename, "r");
+  if (f == NULL)
+    return BitmapOpenFailed;
+
+  while (fgets(line, sizeof(line), f) != NULL)
+    {
+      if (strstr(line, "#define") != NULL)
+        {
+          p = strrchr(line, ' ');
+          if (p == NULL)
+            continue;
+          if (strstr(line, "_width") != NULL)
+            w = atoi(p + 1);
+          else if (strstr(line, "_height") != NULL)
+            h = atoi(p + 1);
+        }
+      else if (strchr(line, '{') != NULL)
+        break;
+    }
+
+  if (w <= 0 || h <= 0)
+    {
+      fclose(f);
+      return BitmapFileInvalid;
+    }
+
+  pm = new_drawable(w, h, 1);
+  bm = get(pm);
+  bpl = (w + 7) / 8;
+
+  p = strchr(line, '{') + 1;
+  for (;;)
+    {
+      while (*p != '\0')
+        {
+          if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
+            {
+              val = strtol(p, &end, 16);
+              p = end;
+              i = n / bpl;
+              for (b = 0; b < 8; b++)
+                {
+                  int x = (n % bpl) * 8 + b;
+                  if (i < h && x < w)
+                    bm->px[i * w + x] = (val >> b) & 1;
+                }
+              n++;
+            }
+          else
+            p++;
+        }
+      if (n >= bpl * h || fgets(line, sizeof(line), f) == NULL)
+        break;
+      p = line;
+    }
+
+  fclose(f);
+
+  *width_return = w;
+  *height_return = h;
+  *bitmap_return = pm;
+  if (x_hot_return)
+    *x_hot_return = -1;
+  if (y_hot_return)
+    *y_hot_return = -1;
+  return BitmapSuccess;
+}
