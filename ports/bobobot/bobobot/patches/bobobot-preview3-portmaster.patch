+/*
+   xsdl.c
+
+   The subset of Xlib that BoboBot uses, implemented on SDL2 for PortMaster.
+   Pixmaps and the window are plain 32-bit pixel buffers; the window buffer is
+   uploaded to a streaming texture and scaled to the screen when presented.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <SDL.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <X11/keysym.h>
+#include "font6x13.h"
+
+#define MAX_DRAWABLES 512
+#define FONT_W 6
+#define FONT_ASCENT 11
+#define FONT_DESCENT 2
+
+typedef struct
+{
+  int used, w, h, depth;
+  Uint32 *px;
+} xsdl_drawable;
+
+struct _XGC
+{
+  unsigned long fg, bg;
+  int function, line_width;
+  Pixmap clip_mask;
+  int clip_x, clip_y;
+};
+
+static xsdl_drawable drawables[MAX_DRAWABLES];
+static Display *xsdl_display;
+static Screen xsdl_screen;
+static Visual xsdl_visual;
+static Window xsdl_window_id;
+static SDL_Window *sdl_window;
+static SDL_Renderer *sdl_renderer;
+static SDL_Texture *sdl_texture;
+static int window_dirty;
+static Uint32 last_present;
+static XFontStruct xsdl_font;
+static int fps_log, fps_frames;
+static Uint32 fps_start;
+
+#define ROOT_ID 1
+
+
+static xsdl_drawable *get(Drawable d)
+{
+  if (d == 0 || d >= MAX_DRAWABLES || !drawables[d].used)
+    return NULL;
+  return &drawables[d];
+}
+
+static Drawable new_drawable(int w, int h, int depth)
+{
+  int i;
+
+  for (i = 2; i < MAX_DRAWABLES; i++)
+    if (!drawables[i].used)
+      {
+        drawables[i].used = 1;
+        drawables[i].w = w;
+        drawables[i].h = h;
+        drawables[i].depth = depth;
+        drawables[i].px = calloc((size_t)w * h, sizeof(Uint32));
+        if (drawables[i].px == NULL)
+          {
+            fprintf(stderr, "xsdl: out of memory\n");
+            exit(1);
+          }
+        return i;
+      }
+
+  fprintf(stderr, "xsdl: out of drawables\n");
+  exit(1);
+}
+
+static void present(void)
+{
+  xsdl_drawable *w = get(xsdl_window_id);
+
+  if (w == NULL || sdl_renderer == NULL)
+    return;
+
+  SDL_UpdateTexture(sdl_texture, NULL, w->px, w->w * 4);
+  SDL_SetRenderDrawColor(sdl_renderer, 0, 0, 0, 255);
+  SDL_RenderClear(sdl_renderer);
+  SDL_RenderCopy(sdl_renderer, sdl_texture, NULL, NULL);
+  SDL_RenderPresent(sdl_renderer);
+  window_dirty = 0;
+  last_present = SDL_GetTicks();
+
+  if (fps_log)
+    {
+      fps_frames++;
+      if (last_present - fps_start >= 5000)
+        {
+          fprintf(stderr, "xsdl: %.1f presents/s\n",
+                  fps_frames * 1000.0 / (last_present - fps_start));
+          fps_frames = 0;
+          fps_start = last_present;
+        }
+    }
+}
+
+/* Drawing straight to the window without a later XSync/XFlush/XPending
+   (the loading screen) still shows up, like an X server would show it. */
+static void touched(Drawable d)
+{
+  if (d == xsdl_window_id && xsdl_window_id != 0)
+    {
+      window_dirty = 1;
+      if (SDL_GetTicks() - last_present > 50)
+        present();
+    }
+}
+
+static inline int mask_ok(GC gc, int x, int y)
+{
+  xsdl_drawable *m;
+
+  if (gc->clip_mask == None)
+    return 1;
+  m = get(gc->clip_mask);
+  if (m == NULL)
+    return 1;
+  x -= gc->clip_x;
+  y -= gc->clip_y;
+  if (x < 0 || y < 0 || x >= m->w || y >= m->h)
+    return 0;
+  return m->px[y * m->w + x] != 0;
+}
+
+static inline Uint32 pixval(xsdl_drawable *d, unsigned long c)
+{
+  if (d->depth == 1)
+    return c & 1;
+  return 0xFF000000u | (Uint32)(c & 0xFFFFFF);
+}
+
+static inline void plot(xsdl_drawable *d, GC gc, int x, int y, Uint32 v)
+{
+  if (x < 0 || y < 0 || x >= d->w || y >= d->h)
+    return;
+  if (!mask_ok(gc, x, y))
+    return;
+  d->px[y * d->w + x] = v;
+}
+
+static void fill_span(xsdl_drawable *d, GC gc, int x1, int x2, int y, Uint32 v)
+{
+  int x;
+
+  if (y < 0 || y >= d->h)
+    return;
+  if (x1 < 0)
+    x1 = 0;
+  if (x2 > d->w)
+    x2 = d->w;
+  for (x = x1; x < x2; x++)
+    plot(d, gc, x, y, v);
+}
+
+/* Even-odd polygon fill, pixel-centre sampling (what X does for FillPolygon). */
+static void fill_poly(xsdl_drawable *d, GC gc, const double *px, const double *py,
+                      int n, Uint32 v)
+{
+  double miny = 1e9, maxy = -1e9, xs[64], cy, t;
+  int i, j, k, y, nx;
+
+  for (i = 0; i < n; i++)
+    {
+      if (py[i] < miny)
+        miny = py[i];
+      if (py[i] > maxy)
+        maxy = py[i];
+    }
+
+  for (y = (int)SDL_floor(miny); y <= (int)SDL_ceil(maxy); y++)
+    {
+      cy = y + 0.5;
+      nx = 0;
+      for (i = 0, j = n - 1; i < n; j = i++)
+        {
+          if ((py[i] <= cy && py[j] > cy) || (py[j] <= cy && py[i] > cy))
+            {
+              if (nx < 64)
+                xs[nx++] = px[i] + (cy - py[i]) * (px[j] - px[i]) / (py[j] - py[i]);
+            }
+        }
+      for (i = 1; i < nx; i++)
+        for (k = i; k > 0 && xs[k - 1] > xs[k]; k--)
+          {
+            t = xs[k];
+            xs[k] = xs[k - 1];
+            xs[k - 1] = t;
+          }
+      for (i = 0; i + 1 < nx; i += 2)
+        fill_span(d, gc, (int)SDL_ceil(xs[i] - 0.5), (int)SDL_ceil(xs[i + 1] - 0.5),
+                  y, v);
+    }
+}
