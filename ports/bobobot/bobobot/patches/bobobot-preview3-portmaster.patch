+/* --- GCs ----------------------------------------------------------------- */
+
+GC XCreateGC(Display *display, Drawable d, unsigned long valuemask,
+             XGCValues *values)
+{
+  GC gc = calloc(1, sizeof(struct _XGC));
+
+  (void)display; (void)d;
+
+  gc->fg = 0;
+  gc->bg = 1;
+  gc->function = GXcopy;
+  gc->clip_mask = None;
+
+  if (values != NULL)
+    {
+      if (valuemask & GCForeground)
+        gc->fg = values->foreground;
+      if (valuemask & GCBackground)
+        gc->bg = values->background;
+      if (valuemask & GCFunction)
+        gc->function = values->function;
+      if (valuemask & GCLineWidth)
+        gc->line_width = values->line_width;
+    }
+
+  return gc;
+}
+
+int XChangeGC(Display *display, GC gc, unsigned long valuemask,
+              XGCValues *values)
+{
+  (void)display;
+  if (valuemask & GCForeground)
+    gc->fg = values->foreground;
+  if (valuemask & GCBackground)
+    gc->bg = values->background;
+  if (valuemask & GCFunction)
+    gc->function = values->function;
+  if (valuemask & GCLineWidth)
+    gc->line_width = values->line_width;
+  return 1;
+}
