+static const struct
+{
+  const char *name;
+  unsigned char r, g, b;
+} named_colors[] = {
+  { "dark green", 0, 100, 0 },
+  { "green3", 0, 205, 0 },
+  { "green", 0, 255, 0 },
+  { "dark red", 139, 0, 0 },
+  { "red3", 205, 0, 0 },
+  { "red", 255, 0, 0 },
+  { "yellow4", 139, 139, 0 },
