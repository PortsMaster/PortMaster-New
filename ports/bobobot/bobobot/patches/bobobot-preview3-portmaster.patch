+/* --- Events -------------------------------------------------------------- */
+
+#define EVQ 64
+static XEvent evq[EVQ];
+static int evq_head, evq_count;
+
+static KeySym map_key(SDL_Keycode k)
+{
+  if (k >= SDLK_a && k <= SDLK_z)
+    return XK_a + (k - SDLK_a);
+  if (k >= SDLK_0 && k <= SDLK_9)
+    return XK_0 + (k - SDLK_0);
+
+  switch (k)
+    {
+    case SDLK_LEFT: return XK_Left;
+    case SDLK_RIGHT: return XK_Right;
+    case SDLK_UP: return XK_Up;
+    case SDLK_DOWN: return XK_Down;
+    case SDLK_SPACE: return XK_space;
+    case SDLK_TAB: return XK_Tab;
+    case SDLK_ESCAPE: return XK_Escape;
+    case SDLK_RETURN: return XK_Return;
+    case SDLK_KP_ENTER: return XK_KP_Enter;
+    case SDLK_KP_2: return XK_KP_2;
+    case SDLK_KP_4: return XK_KP_4;
+    case SDLK_KP_5: return XK_KP_5;
+    case SDLK_KP_6: return XK_KP_6;
+    case SDLK_KP_8: return XK_KP_8;
+    default: return NoSymbol;
+    }
+}
+
+static void pump(void)
+{
+  SDL_Event e;
+  XEvent *x;
+
+  while (SDL_PollEvent(&e))
+    {
+      if (e.type == SDL_QUIT)
+        exit(0);
+
+      if ((e.type == SDL_KEYDOWN && !e.key.repeat) || e.type == SDL_KEYUP)
+        {
+          KeySym sym = map_key(e.key.keysym.sym);
+
+          if (sym == NoSymbol || evq_count >= EVQ)
+            continue;
+
+          x = &evq[(evq_head + evq_count) % EVQ];
+          memset(x, 0, sizeof(*x));
+          x->xkey.type = (e.type == SDL_KEYDOWN) ? KeyPress : KeyRelease;
+          x->xkey.display = xsdl_display;
+          x->xkey.window = xsdl_window_id;
+          x->xkey.keycode = (unsigned int)sym;
+          evq_count++;
+        }
+    }
+}
+
+int XPending(Display *display)
+{
+  (void)display;
+  if (window_dirty)
+    present();
+  pump();
+  return evq_count;
+}
+
+int XNextEvent(Display *display, XEvent *event)
+{
+  (void)display;
+  if (window_dirty)
+    present();
+  pump();
+  while (evq_count == 0)
+    {
+      SDL_WaitEventTimeout(NULL, 10);
+      pump();
+    }
+  *event = evq[evq_head];
+  evq_head = (evq_head + 1) % EVQ;
+  evq_count--;
+  return 0;
+}
+
+KeySym XLookupKeysym(XKeyEvent *key_event, int index)
+{
+  (void)index;
+  return (KeySym)key_event->keycode;
+}
