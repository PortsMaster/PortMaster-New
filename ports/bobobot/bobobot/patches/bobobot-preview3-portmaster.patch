+Status XAllocColor(Display *display, Colormap colormap, XColor *c)
+{
+  (void)display; (void)colormap;
+  c->pixel = ((unsigned long)(c->red >> 8) << 16) |
+    ((unsigned long)(c->green >> 8) << 8) | (unsigned long)(c->blue >> 8);
+  return 1;
+}
+
+Status XAllocNamedColor(Display *display, Colormap colormap,
+                        _Xconst char *color_name, XColor *screen_def,
+                        XColor *exact_def)
+{
+  size_t i;
+
+  (void)display; (void)colormap;
+  for (i = 0; i < sizeof(named_colors) / sizeof(named_colors[0]); i++)
+    if (SDL_strcasecmp(color_name, named_colors[i].name) == 0)
+      {
+        screen_def->red = named_colors[i].r * 257;
+        screen_def->green = named_colors[i].g * 257;
+        screen_def->blue = named_colors[i].b * 257;
+        screen_def->pixel = ((unsigned long)named_colors[i].r << 16) |
+          ((unsigned long)named_colors[i].g << 8) | named_colors[i].b;
+        *exact_def = *screen_def;
+        return 1;
+      }
+
+  fprintf(stderr, "xsdl: unknown colour '%s'\n", color_name);
+  return 0;
+}
