#!/bin/bash
# Set GAMEDIR to the current directory and set logfile
GAMEDIR="$PWD"
LOGFILE="$GAMEDIR/patchlog.txt"
LOGERR="$GAMEDIR/patchlog_error.txt"
START_TIME=$(date +%s)

# Redirect output and error to the log file
exec > >(tee -a "$LOGFILE") 2>&1
echo "GAMEDIR is set to: $GAMEDIR"

# Patch failure function
patch_failure() {
    mv "$LOGFILE" "$LOGERR"
    echo "Patching process failed."
    exit 1
}

# Patch failure function
patch_failure() {
    mv "$LOGFILE" "$LOGERR"
    echo "Patching process failed."
    exit 1
}


# Exports
export PATH="$controlfolder:$PATH"
export LD_LIBRARY_PATH="/usr/lib:$LD_LIBRARY_PATH"
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
export DATADIR="$GAMEDIR/assets"
export DATAFILE="rollingbird.port"
export TMPDIR="$GAMEDIR/tmp"

# Permissions
chmod 666 /dev/uinput

# Set up trap for cleaning TMPDIR on exit
trap 'rm -rf "$TMPDIR"; echo "Cleaned up temporary files." >> "$LOGFILE"' 0

# Attempt to get SAVEDIR from gmloader.json using jq
if command -v jq >/dev/null 2>&1; then
    SAVEDIR=$(jq -r '.save_dir // empty' "$GAMEDIR/gmloader.json" 2>/dev/null)
else
    SAVEDIR="$GAMEDIR/saves"
fi

# Test for commands: python, zip
PYTHON=$(which python3)
if [ -z "$PYTHON" ]; then
    echo "Missing Python!"
    patch_failure
fi

ZIP=$(which zip)
if [ -z "$ZIP" ]; then
    echo "Missing zip!"
    patch_failure
fi

prepare_files() {
    # Delete all redundant files
	rm -f assets/*.{dll,exe,txt,lib}
	
	# Create the save directory if it doesn't exist
    mkdir -p "$SAVEDIR"
}

apply_xdelta() {
    # Define which patch to use
    local patch_file="./tools/patchkorean.xdelta"
    if [ "$ENGLISH" = "true" ]; then
        echo "Applying English patch..."
        patch_file="./tools/patchenglish.xdelta"
    else
        echo "Applying Korean patch..."
    fi

    if [ -f "$DATADIR/data.win" ]; then
        # Run xdelta and capture output
        if output=$(xdelta3 -d -s "$DATADIR/data.win" -f "$patch_file" "$DATADIR/data2.win" 2>&1); then
            echo "Patch applied successfully: $output"
            rm "$DATADIR/data.win"
            mv "$DATADIR/data2.win" "$DATADIR/game.droid"
        else
            echo "Failed to apply patch: $output"
            exit 1
        fi
    else
        echo "No data.win file found to patch!"
    fi
    
    sleep 1
}


zip_archive() {
        zip -r -0 "$DATAFILE" ./assets/
        echo "Zipped contents to $DATAFILE"
        rm -rf "$GAMEDIR/assets/"
		sleep 1
}

# Create install completion flag
install_complete() {
	touch "install_completed"
    # Measure time to complete
	END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))
    echo "Script completed in $DURATION seconds"
	echo "Installation completed successfully!"
	echo "-----------------------------"
	echo "Process finished at: $(date)"
}

process_game() { 
    echo "Preparing game..."
    prepare_files || patch_failure
    echo "Patching data.win..."
    apply_xdelta || patch_failure 	
    echo "Finishing up..."
    zip_archive || patch_failure
    install_complete
	sleep 1

    # Final completion message
    echo "Patching process complete!"
}

# Call the function
process_game