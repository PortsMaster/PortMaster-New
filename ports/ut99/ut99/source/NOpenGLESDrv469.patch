+static FLOAT* UT99PortMasterFindFloatProperty469( UObject* Object, const TCHAR* PropertyName )
+{
+	if( !Object )
+		return NULL;
+	const FName WantedName( PropertyName );
+	for( TFieldIterator<UProperty> It(Object->GetClass()); It; ++It )
+	{
+		if( It->GetFName() == WantedName && It->IsA(UFloatProperty::StaticClass()) )
+			return (FLOAT*)((BYTE*)Object + It->Offset);
+	}
+	return NULL;
+}
+
+static UObject* UT99PortMasterFindObjectProperty469( UObject* Object, const TCHAR* PropertyName )
+{
+	if( !Object )
+		return NULL;
+	const FName WantedName( PropertyName );
+	for( TFieldIterator<UProperty> It(Object->GetClass()); It; ++It )
+	{
+		if( It->GetFName() == WantedName && It->IsA(UObjectProperty::StaticClass()) )
+			return *(UObject**)((BYTE*)Object + It->Offset);
+	}
