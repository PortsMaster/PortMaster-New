+
+		if( !WasShowingMenuMouse || (Root && Root != CenteredRoot) )
+		{
+			UT99PortMasterSetFloatProperty469( Viewport->Console, TEXT("MouseX"), CenterX );
+			UT99PortMasterSetFloatProperty469( Viewport->Console, TEXT("MouseY"), CenterY );
+			UT99PortMasterSetFloatProperty469( Root, TEXT("MouseX"), CenterX );
+			UT99PortMasterSetFloatProperty469( Root, TEXT("MouseY"), CenterY );
