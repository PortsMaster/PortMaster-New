+static void UT99PortMasterSyncMenuMouse469( UViewport* Viewport )
+{
+	if( !Viewport || !Viewport->GetWindow() )
+		return;
+
+	SDL_Window* Window = (SDL_Window*)Viewport->GetWindow();
+	INT WindowW = 0;
+	INT WindowH = 0;
