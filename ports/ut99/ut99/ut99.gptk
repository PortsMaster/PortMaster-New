[config]
repeat_delay = 500
repeat_rate = 60
mouse_delay = 16
mouse_slow_scale = 25
deadzone_mode = axial
deadzone_scale = 10
deadzone_x = 6000
deadzone_y = 6000
deadzone_triggers = 3000

[controls]
overlay = "clear"
mouse_wheel_amount = 1

a = "space"
b = "c"
x = "enter"
y = "q"

r1 = "mouse_left"
r2 = "mouse_right"
l1 = "mouse_wheel_down" repeat
l2 = "mouse_wheel_up" repeat

l3 = "mouse_slow"
r3 = "end"

start = "esc"
back = "f1"

up = "1"
down = "3"
left = "2"
right = "4"

right_analog = mouse_movement
left_analog_up = "up"
left_analog_down = "down"
left_analog_left = "left"
left_analog_right = "right"
