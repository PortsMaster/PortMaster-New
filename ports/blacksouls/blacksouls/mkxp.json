{
    // BLACK SOULS -- mkxp-z (RPG Maker VX Ace / RGSS3)
    // mkxp-z reads this file from the engine binary's directory and uses that
    // same directory as the game root, so engine and game files sit together
    // and no gameFolder is set (a relative one is rejected; SRCDIR would move
    // the game root along with it).

    "rgssVersion": 3,

    // Game renders at 640x480, identical to the RG40XX H panel:
    // scale 1:1, nearest-neighbour, no blur and no letterboxing.
    "fullscreen": true,
    "winResizable": false,
    "fixedAspectRatio": true,
    "smoothScaling": 0,

    // VX Ace targets 60 FPS.
    "fixedFramerate": 60,
    "frameSkip": false,
    "syncToRefreshrate": true,
    "printFPS": false,

    // The name-window script asks for "UmePlus Gothic", which was never
    // shipped with the game. Point it at the font the game does ship.
    "fontSub": [
        "UmePlus Gothic>VL Gothic"
    ],

    // Loaded before the game scripts; see win32stub.rb for why.
    "preloadScript": ["win32stub.rb"],

    // Anything dropped into patches/ is mounted above Game.rgss3a, which is how
    // the optional translation replaces the game's data without touching the
    // archive. Empty by default, which leaves the game exactly as shipped.
    "patches": ["patches"],

    // ~1100 asset files, cache the lookups.
    "pathCache": true,
    "allowSymlinks": false

}
