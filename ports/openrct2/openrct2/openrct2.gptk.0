
a = mouse_left
a_hk = f5                       # new ride
b = mouse_right
b_hk = f3                       # scenery

y = z                           # rotate construction object
y_hk = tab                      # map
x = backspace                   # close top window
x_hk = f4                       # footpaths

l1 = shift                      # hold to adjust placement height
l1_hk = backspace               # close all windows
l1_hk = add_shift

l2 = enter                      # rotate counter clock wise
l2 = add_shift
l2_hk = pageup                  # zoom out

r1 = mouse_slow                 # slow down mouse
r1_hk = f10                     # save
r1_hk = add_ctrl

r2 = enter                      # rotate clock wise
r2_hk = pagedown                # zoom in


start = pause                   # pause
back = esc                      # cancel construction

up = mouse_movement_up
down = mouse_movement_down
left = mouse_movement_left
right = mouse_movement_right

deadzone_triggers = 3000
mouse_delay = 16
dpad_mouse_step = 12
mouse_slow_scale = 25
