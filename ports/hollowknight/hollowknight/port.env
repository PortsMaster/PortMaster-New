# The game's runtime options (ua_host: docs/runtime.md and docs/input.md in portmaster-unity),
# sourced by the launcher. Edit to taste; a variable already set in the environment wins.
[ -n "${UA_PAD_NAME+x}" ] || export UA_PAD_NAME='Xbox Wireless Controller'
[ -n "${UA_PAD_LETTERS+x}" ] || export UA_PAD_LETTERS=nintendo
[ -n "${UA_JIT_WARM+x}" ] || export UA_JIT_WARM=1
[ -n "${UA_GL_ARENA+x}" ] || export UA_GL_ARENA=1
[ -n "${UA_GLES_POOL+x}" ] || export UA_GLES_POOL=1
[ -n "${UA_PRESENT_SYNC+x}" ] || export UA_PRESENT_SYNC=end
[ -n "${UA_GL_MEMO+x}" ] || export UA_GL_MEMO=0
[ -n "${UA_GL_SPEC+x}" ] || export UA_GL_SPEC=1
[ -n "${UA_FLIPBOOK+x}" ] || export UA_FLIPBOOK=@flipbooks.txt
[ -n "${ASMPATCH_HK_ASPECT+x}" ] || export ASMPATCH_HK_ASPECT=fill
[ -n "${UA_PRESENT_THREAD+x}" ] || export UA_PRESENT_THREAD=1
[ -n "${UA_GL_REC+x}" ] || export UA_GL_REC=auto
[ -n "${UM_PMHWDEC+x}" ] || export UM_PMHWDEC=pmhwdec/libpmhwdec.so.1
[ -n "${UA_GFX_JOBS+x}" ] || export UA_GFX_JOBS=legacy
[ -n "${UA_AUDIO_RATE+x}" ] || export UA_AUDIO_RATE=24000
[ -n "${UA_UNITY_ARGS+x}" ] || export UA_UNITY_ARGS='-job-worker-count 1'
[ -n "${UA_UNLOAD_ASSETS+x}" ] || export UA_UNLOAD_ASSETS='chinese_body Atlas|chinese_trad_body Atlas|chinese_body_bold Atlas|japanese_title Atlas|japanese_body Atlas|korean_body Atlas|japanese_body_bold Atlas|russian_body Atlas|russian_title Atlas|russian_body_fallback Atlas|russian_title_fallback Atlas|NotoSerifCJKsc-Regular|NotoSerifTC-Medium'
[ -n "${ASMPATCH_HK_UNLOAD+x}" ] || export ASMPATCH_HK_UNLOAD=150
[ -n "${ASMPATCH_HK_TEXT+x}" ] || export ASMPATCH_HK_TEXT=auto
# the Low picture on every handheld, the same game; UA_PICTURE=high set above keeps the picture
# as on PC (set a variable above, or in the environment, and that wins)
case "${UA_PICTURE:-low}" in high|full) ;; *)
  [ -n "${ASMPATCH_HK_BLUR+x}" ] || export ASMPATCH_HK_BLUR=off
  [ -n "${UA_RENDER_SIZE+x}" ] || export UA_RENDER_SIZE='540x360 480x480'
  [ -n "${UA_RENDER_SIZE_VAR+x}" ] || export UA_RENDER_SIZE_VAR=ASMPATCH_HK_RENDER_SIZE
  [ -n "${UA_RENDER_PIXELS+x}" ] || export UA_RENDER_PIXELS=560000
  [ -n "${UA_PREFS_DEFAULTS+x}" ] || export UA_PREFS_DEFAULTS='ShaderQuality=0 VidParticles=0 VidDithering=0 VidNoise=0'
;; esac
