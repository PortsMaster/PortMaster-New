#!/bin/bash
LOGFILE="$GAMEDIR/patchlog.txt"
LOGERR="$GAMEDIR/patchlog_error.txt"
START_TIME=$(date +%s)

exec > >(tee -a "$LOGFILE") 2>&1
echo "GAMEDIR is set to: $GAMEDIR"

patch_failure() {
    mv "$LOGFILE" "$LOGERR"
    echo "Patching process failed."
    exit 1
}

export PATH="$controlfolder:$PATH"
export LD_LIBRARY_PATH="$GAMEDIR/libs:/usr/config/emuelec/lib:/usr/lib:$LD_LIBRARY_PATH"
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"

chmod 666 /dev/uinput

trap 'rm -rf "$TMPDIR"; echo "Cleaned up temporary files." >> "$LOGFILE"' 0

install_complete() {
    touch "install_completed"
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))
    echo "Script completed in $DURATION seconds"
    echo "Installation completed successfully!"
    echo "-----------------------------"
    echo "Process finished at: $(date)"
}

patch_game() {
    echo "Patching game..."

    DATA_DIR="$GAMEDIR/gamedata/data"
    GAME_DIR="$GAMEDIR/gamedata"
    TOOLS_DIR="$GAMEDIR/tools"
    WORKDIR="$GAMEDIR/patch_scratch"

    export LD_LIBRARY_PATH="$TOOLS_DIR/lib:$LD_LIBRARY_PATH"
    chmod +x "$TOOLS_DIR/oggenc" "$TOOLS_DIR/oggdec" "$TOOLS_DIR/sfxpack.py" "$TOOLS_DIR/gfxpack.py" 2>/dev/null

    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 not found on device - cannot compress audio archives or unpack graphics archives."
        patch_failure
    fi

    mkdir -p "$WORKDIR"

    filesize() {
        wc -c < "$1" 2>/dev/null | tr -d ' '
    }

    # Unpacks a .dat archive to loose, individually Vorbis-encoded files
    # under $DATA_DIR/<dest_subdir>/ (e.g. data/sfx/, data/music/), then
    # removes the source .dat.
    #
    # This is a change from repacking the .dat in place: OeResourceManager
    # tries SetupDatReader() first and only falls back to a loose-directory
    # scan if the .dat file doesn't exist - so a repacked-but-still-present
    # .dat is never actually read at runtime, and every track stays fully
    # decoded to raw PCM in RAM regardless of how small the archive on disk
    # is. Removing the .dat makes that fallback unconditional (no launch
    # flag needed), and OeVorbisBridge (already patched into
    # OeWaveFileData.FromStream) decodes these Ogg-in-.wav-named files back
    # to PCM on load exactly as it does for the .dat path.
    #
    # SetupDirectoryScan() only takes over for a given resource type if its
    # matching directory actually exists, so anything not unpacked here
    # (levels, textures, etc.) is unaffected and keeps reading its own .dat.
    unpack_archive() {
        local name="$1"
        local dest_subdir="$2"
        local src="$DATA_DIR/$name"
        local dest="$DATA_DIR/$dest_subdir"
        local before after

        if [ ! -f "$src" ]; then
            echo "  $name not found in $DATA_DIR, skipping."
            return
        fi

        before=$(filesize "$src")
        echo "  Unpacking $name ($before bytes) -> $dest ..."

        # 48 kHz stereo source -> 22.05 kHz mono Vorbis per entry.
        python3 "$TOOLS_DIR/sfxpack.py" unpack "$src" "$dest" \
            --quality 2 \
            --downmix \
            --resample 22050 \
            --oggenc "$TOOLS_DIR/oggenc" \
            --tmpdir "$WORKDIR" || patch_failure

        after=$(du -sb "$dest" 2>/dev/null | cut -f1)
        rm -f "$src"
        echo "  $name: $before bytes -> $dest ($after bytes), archive removed"
    }

    unpack_archive "sfx.dat" "sfx"
    unpack_archive "music.dat" "music"

    # gfx.dat/offsetstex.dat: same "delete the .dat so SetupDatReader()
    # falls back to SetupDirectoryScan()" trick as the audio archives, but
    # gfxpack.py handles both files together in one pass since sheet.png/
    # sheet2.png (gfx.dat) and sheet.txt/sheet2.txt (offsetstex.dat) have to
    # be repacked as matching pairs - reflowing the sprite positions in an
    # image without rewriting the same new positions into its offset table
    # (or vice versa) would scramble every sprite on that sheet.
    #
    # Both sheet.png and sheet2.png are also downsampled 2x linearly (4x
    # fewer pixels) as part of the same pass, to cut decoded texture RAM
    # further - this only works together with the matching MuteCrimsonDX.dll
    # patch below (OeAtlasRectHelper), which substitutes the real half-scale
    # texture coordinates back in at draw time while every other read of a
    # sprite's position/size elsewhere in the game keeps seeing original,
    # unshrunk numbers. generated_tilesets/"04_original - Copy.png" is
    # kept (it is NOT dropped - removing it caused visual bugs).
    # offsetstile.dat (the generated_tilesets/*.txt tile-grid tables) is
    # unpacked in the same pass so those .txt files sit next to their
    # tileset .pngs. Tileset PNGs are not shrunk (the DLL atlas patch only
    # applies to sheet/sheet2). Everything else just moves from the
    # archives to loose files unchanged.
    #
    # gfxpack.py uses Pillow for all PNG decode/encode/resize work. This
    # step needs a Pillow build for this device's exact Python (a
    # pillow-*.whl in $TOOLS_DIR) unless the system python3 already has a
    # recent enough one. Peak memory for this step is roughly one full
    # decoded 8192x8192 atlas at a time (~400MB) - run it with the game
    # closed and nothing else heavy going on.
    GFX_SRC="$DATA_DIR/gfx.dat"
    OFFSETS_SRC="$DATA_DIR/offsetstex.dat"
    TILE_OFFSETS_SRC="$DATA_DIR/offsetstile.dat"   # optional
    GFX_DEST="$DATA_DIR/gfx"

    if [ -f "$GFX_SRC" ] && [ -f "$OFFSETS_SRC" ]; then
        before_gfx=$(filesize "$GFX_SRC")
        before_off=$(filesize "$OFFSETS_SRC")
        OFFSETS_ARGS=("$OFFSETS_SRC")
        if [ -f "$TILE_OFFSETS_SRC" ]; then
            before_off=$((before_off + $(filesize "$TILE_OFFSETS_SRC")))
            OFFSETS_ARGS+=("$TILE_OFFSETS_SRC")
        fi
        echo "  Unpacking gfx.dat ($before_gfx bytes) + offsets archives ($before_off bytes) -> $GFX_DEST ..."

        # Pillow setup. A .whl is just a zip, but Python can't import
        # compiled extension modules (Pillow's _imaging*.so) from inside a
        # zip, so it has to be unpacked to a real directory first - done
        # with python3's own zipfile module so this doesn't depend on
        # `unzip` existing on the device. What gets checked is what
        # gfxpack.py actually uses (PNG support and Image.Resampling, which
        # only exists in Pillow >= 9.1), not just that `import PIL` works,
        # so an old system Pillow falls through to the bundled wheel.
        PYLIB="$TOOLS_DIR/pylib"
        PILLOW_CHECK='from PIL import Image, PngImagePlugin; Image.Resampling.BOX'
        if ! PYTHONPATH="$PYLIB" python3 -c "$PILLOW_CHECK" >/dev/null 2>&1; then
            # Pick the wheel built for this device's Python (cp37, cp313, ...).
            # Wheels are named pillow-<ver>-<pytag>.<arch>.whl, e.g.
            # pillow-9.5.0-cp37.aarch64.whl / pillow-12.3.0-cp313.aarch64.whl
            PYTAG=$(python3 -c 'import sys; print("cp%d%d" % sys.version_info[:2])')
            PILLOW_WHL=$(ls "$TOOLS_DIR"/pillow-*-"$PYTAG".*.whl "$TOOLS_DIR"/patch/pillow-*-"$PYTAG".*.whl 2>/dev/null | head -n 1)
            if [ -z "$PILLOW_WHL" ]; then
                echo "  Error: a usable Pillow is not installed for $(python3 -V 2>&1) and no Pillow wheel for $PYTAG (pillow-*-$PYTAG.*.whl) was found in $TOOLS_DIR (or $TOOLS_DIR/patch)."
                patch_failure
            fi
            echo "  Unpacking $(basename "$PILLOW_WHL") -> $PYLIB ..."
            rm -rf "$PYLIB"
            mkdir -p "$PYLIB"
            python3 -m zipfile -e "$PILLOW_WHL" "$PYLIB" || patch_failure
            chmod -R u+rX "$PYLIB" 2>/dev/null
            if ! PYTHONPATH="$PYLIB" python3 -c "$PILLOW_CHECK"; then
                echo "  Error: Pillow was unpacked but could not be imported (error above)."
                echo "  This device has $(python3 -V 2>&1) on $(uname -m); the wheel must be built for that exact Python version and architecture."
                patch_failure
            fi
        fi
        export PYTHONPATH="$PYLIB${PYTHONPATH:+:$PYTHONPATH}"

        python3 "$TOOLS_DIR/gfxpack.py" unpack "$GFX_SRC" "$GAME_DIR" "${OFFSETS_ARGS[@]}" || patch_failure
        rm -rf "$PYLIB"

        after=$(du -sb "$GFX_DEST" 2>/dev/null | cut -f1)
        rm -f "$GFX_SRC" "${OFFSETS_ARGS[@]}"
        echo "  gfx.dat+offsets archives: $((before_gfx + before_off)) bytes -> $GFX_DEST ($after bytes), archives removed"
    else
        echo "  gfx.dat or offsetstex.dat not found in $DATA_DIR, skipping."
    fi

    rm -rf "$WORKDIR"
	
	sleep 1
       
	# Patch MuteCrimsonDX.dll
	echo "Patching MuteCrimsonDX.dll ..."
    if ! $controlfolder/xdelta3 -d -s "$GAME_DIR/MuteCrimsonDX.dll" "$TOOLS_DIR/patch/mutecrimsondxdll.xdelta" "$GAME_DIR/MuteCrimsonDX.patched.dll"; then
        echo "Error: xdelta3 patch failed. Wrong installer version?"
        rm -f "$GAME_DIR/MuteCrimsonDX.patched.dll"
        patch_failure
    fi
    echo "MuteCrimsonDX.dll patched successfully..."
	sleep 1
	if [ ! -f "$GAME_DIR/MuteCrimsonDX.dll.orig" ]; then
        mv "$GAME_DIR/MuteCrimsonDX.dll" "$GAME_DIR/MuteCrimsonDX.dll.orig" || patch_failure
    fi
	mv "$GAME_DIR/MuteCrimsonDX.patched.dll" "$GAME_DIR/MuteCrimsonDX.dll" || patch_failure
    cp "$TOOLS_DIR/patch/FNA.dll" "$GAME_DIR/FNA.dll" || patch_failure
	cp "$TOOLS_DIR/patch/FontStashSharp.FNA.dll" "$GAME_DIR/FontStashSharp.FNA.dll" || patch_failure
	cp "$TOOLS_DIR/patch/MuteCrimsonDX.deps.json" "$GAME_DIR/MuteCrimsonDX.deps.json" || patch_failure
	cp "$TOOLS_DIR/patch/MuteCrimsonDX.runtimeconfig.json" "$GAME_DIR/MuteCrimsonDX.runtimeconfig.json" || patch_failure
	rm -f "$GAME_DIR/libFAudio.so.0" || patch_failure
	rm -f "$GAME_DIR/libFNA3D.so.0" || patch_failure
	rm -f "$GAME_DIR/libSDL2-2.0.so.0" || patch_failure
	rm -f "$GAME_DIR/steam.txt" || patch_failure
    
	install_complete
    sleep 1
}

patch_game
