+int fit_avail(sn)
+int sn;
+{
+  int ev,er,ma,mi;
+
+  if (!XCompositeQueryExtension(dpy[sn],&ev,&er) ||
+      !XRenderQueryExtension(dpy[sn],&ev,&er) ||
+      !XDamageQueryExtension(dpy[sn],&fitdmgev,&er) ||
+      !XFixesQueryExtension(dpy[sn],&ev,&er)) return 0;
+  ma=5;mi=0;
+  XFixesQueryVersion(dpy[sn],&ma,&mi);
+  ma=0;mi=4;
+  XCompositeQueryVersion(dpy[sn],&ma,&mi);
+  ma=1;mi=1;
+  XDamageQueryVersion(dpy[sn],&ma,&mi);
+  return 1;
+}
+
+VOID fit_calc(sn,w,h)
+int sn,w,h;
+{
+  XTransform xf;
+  double s;
+
+  fitvw[sn]=w;
+  fitvh[sn]=h;
+  s=(double)w/desk[sn].w;
+  if ((double)h/desk[sn].h<s) s=(double)h/desk[sn].h;
+  fitww[sn]=desk[sn].w*s+.5;
+  fithh[sn]=desk[sn].h*s+.5;
+  if (fitww[sn]<1) fitww[sn]=1;
+  if (fithh[sn]<1) fithh[sn]=1;
+  fitx[sn]=(w-fitww[sn])/2;
+  fity[sn]=(h-fithh[sn])/2;
+  memset((VOID *)&xf,0,sizeof(xf));
+  xf.matrix[0][0]=XDoubleToFixed((double)desk[sn].w/fitww[sn]);
+  xf.matrix[1][1]=XDoubleToFixed((double)desk[sn].h/fithh[sn]);
+  xf.matrix[2][2]=XDoubleToFixed(1.0);
+  XRenderSetPictureTransform(dpy[sn],fitsrc[sn],&xf);
+  XRenderSetPictureFilter(dpy[sn],fitsrc[sn],
+			  fitww[sn]==desk[sn].w && fithh[sn]==desk[sn].h?
+			  FilterNearest:FilterBilinear,NULL,0);
+}
+
+VOID fit_paint(sn,x,y,w,h)
+int sn,x,y,w,h;
+{
+  int x1,y1,x2,y2;
+
+  x1=fitx[sn]+(long)x*fitww[sn]/desk[sn].w-1;
+  y1=fity[sn]+(long)y*fithh[sn]/desk[sn].h-1;
+  x2=fitx[sn]+((long)(x+w)*fitww[sn]+desk[sn].w-1)/desk[sn].w+1;
+  y2=fity[sn]+((long)(y+h)*fithh[sn]+desk[sn].h-1)/desk[sn].h+1;
+  if (x1<fitx[sn]) x1=fitx[sn];
+  if (y1<fity[sn]) y1=fity[sn];
+  if (x2>fitx[sn]+fitww[sn]) x2=fitx[sn]+fitww[sn];
+  if (y2>fity[sn]+fithh[sn]) y2=fity[sn]+fithh[sn];
+  if (x2<=x1 || y2<=y1) return;
+  XRenderComposite(dpy[sn],PictOpSrc,fitsrc[sn],None,fitdst[sn],
+		   x1-fitx[sn],y1-fity[sn],0,0,x1,y1,x2-x1,y2-y1);
+}
+
+VOID fit_full(sn)
+int sn;
+{
+  int r,b;
+
+  r=fitx[sn]+fitww[sn];
+  b=fity[sn]+fithh[sn];
+  XFillRectangle(dpy[sn],fitw[sn],fitgc[sn],0,0,fitvw[sn],fity[sn]);
+  XFillRectangle(dpy[sn],fitw[sn],fitgc[sn],0,b,fitvw[sn],fitvh[sn]-b);
+  XFillRectangle(dpy[sn],fitw[sn],fitgc[sn],0,fity[sn],fitx[sn],fithh[sn]);
+  XFillRectangle(dpy[sn],fitw[sn],fitgc[sn],r,fity[sn],fitvw[sn]-r,fithh[sn]);
+  fit_paint(sn,0,0,desk[sn].w,desk[sn].h);
+}
+
+VOID fit_update()
+{
+  int sn,snn,i,n,got[3];
+  XEvent ev;
+  XRectangle *r;
+
+  if (!fitmode) return;
+  for (sn=0;sn<numsp;sn++) {
+    got[sn]=0;
+    if (lost[sn] || !fitw[sn]) continue;
+    for (snn=0;snn<sn;snn++) {
+      if (dpy[snn]==dpy[sn]) break;
+    }
+    if (snn<sn) {
+      got[sn]=got[snn];
+      continue;
+    }
+    while (XCheckTypedEvent(dpy[sn],fitdmgev+XDamageNotify,&ev)) got[sn]=1;
+  }
+  for (sn=0;sn<numsp;sn++) {
+    if (!got[sn] || lost[sn] || !fitw[sn]) continue;
+    XDamageSubtract(dpy[sn],fitdmg[sn],None,fitreg[sn]);
+    r=XFixesFetchRegion(dpy[sn],fitreg[sn],&n);
+    for (i=0;i<n;i++) {
+      fit_paint(sn,r[i].x,r[i].y,r[i].width,r[i].height);
+    }
+    if (r) XFree(r);
+  }
+}
+
+int fit_event(sn,ev)
+int sn;
+XEvent *ev;
+{
+  Window w,c,cc;
+  int x,y,nx,ny;
+
+  if (!fitw[sn] || ev->xany.window!=fitw[sn]) return 0;
+  switch (ev->type) {
+  case Expose:
+    if (!ev->xexpose.count) fit_full(sn);
+    return 1;
+  case ConfigureNotify:
+    if (ev->xconfigure.width!=fitvw[sn] ||
+	ev->xconfigure.height!=fitvh[sn]) {
+      fit_calc(sn,ev->xconfigure.width,ev->xconfigure.height);
+      fit_full(sn);
+    }
+    return 1;
+  case ButtonPress:
+    x=ev->xbutton.x-fitx[sn];
+    y=ev->xbutton.y-fity[sn];
+    if (x<0 || y<0 || x>=fitww[sn] || y>=fithh[sn]) return 1;
+    x=(long)x*desk[sn].w/fitww[sn];
+    y=(long)y*desk[sn].h/fithh[sn];
+    w=win[sn];
+    while (XTranslateCoordinates(dpy[sn],w,w,x,y,&nx,&ny,&c) && c) {
+      XTranslateCoordinates(dpy[sn],w,c,x,y,&nx,&ny,&cc);
+      w=c;
+      x=nx;
+      y=ny;
+    }
+    ev->xbutton.window=w;
+    ev->xbutton.x=x;
+    ev->xbutton.y=y;
+    return 0;
+  }
+  return 0;
+}
+
+VOID fit_init(sn)
+int sn;
+{
+  XRenderPictFormat *fmt;
+  XRenderPictureAttributes pa;
+  XGCValues gcv;
+  XserverRegion empty;
+  Atom st,fs;
+
+  XCompositeRedirectWindow(dpy[sn],win[sn],CompositeRedirectManual);
+  empty=XFixesCreateRegion(dpy[sn],NULL,0);
+  XFixesSetWindowShapeRegion(dpy[sn],win[sn],ShapeInput,0,0,empty);
+  XFixesDestroyRegion(dpy[sn],empty);
+  fitreg[sn]=XFixesCreateRegion(dpy[sn],NULL,0);
+  fmt=XRenderFindVisualFormat(dpy[sn],
+			      DefaultVisual(dpy[sn],DefaultScreen(dpy[sn])));
+  pa.subwindow_mode=IncludeInferiors;
+  fitsrc[sn]=XRenderCreatePicture(dpy[sn],win[sn],fmt,CPSubwindowMode,&pa);
+  fitdst[sn]=XRenderCreatePicture(dpy[sn],fitw[sn],fmt,0,&pa);
+  fitdmg[sn]=XDamageCreate(dpy[sn],win[sn],XDamageReportNonEmpty);
+  gcv.foreground=BlackPixel(dpy[sn],DefaultScreen(dpy[sn]));
+  fitgc[sn]=XCreateGC(dpy[sn],fitw[sn],GCForeground,&gcv);
+  st=XInternAtom(dpy[sn],"_NET_WM_STATE",False);
+  fs=XInternAtom(dpy[sn],"_NET_WM_STATE_FULLSCREEN",False);
+  XChangeProperty(dpy[sn],fitw[sn],st,XA_ATOM,32,PropModeReplace,
+		  (unsigned char *)&fs,1);
+  fit_calc(sn,fitvw[sn],fitvh[sn]);
+}
+
+Cursor fit_cursor(sn,shape)
+int sn,shape;
+{
+  Font cf;
+  XFontStruct *fs;
+  XCharStruct *s,*m;
+  Pixmap sp,mp,ap;
+  GC g1,g32;
+  XGCValues gcv;
+  XImage *si,*mi,*ai;
+  XRenderPictFormat *fmt;
+  Picture p;
+  Cursor c;
+  unsigned int *d;
+  char ch;
+  int k,l,r,a,b,w,h,x,y;
+
+  k=fitw[sn]?(fitvh[sn]+200)/400:1;
+  if (k<2 || !(fs=XLoadQueryFont(dpy[sn],"cursor")) ||
+      shape+1>fs->max_char_or_byte2 || !fs->per_char) {
+    return XCreateFontCursor(dpy[sn],shape);
+  }
+  cf=fs->fid;
+  s=&fs->per_char[shape-fs->min_char_or_byte2];
+  m=&fs->per_char[shape+1-fs->min_char_or_byte2];
+  l=s->lbearing<m->lbearing?s->lbearing:m->lbearing;
+  r=s->rbearing>m->rbearing?s->rbearing:m->rbearing;
+  a=s->ascent>m->ascent?s->ascent:m->ascent;
+  b=s->descent>m->descent?s->descent:m->descent;
+  w=r-l;
+  h=a+b;
+  sp=XCreatePixmap(dpy[sn],win[sn],w,h,1);
+  mp=XCreatePixmap(dpy[sn],win[sn],w,h,1);
+  gcv.foreground=0;
+  gcv.font=cf;
+  g1=XCreateGC(dpy[sn],sp,GCForeground|GCFont,&gcv);
+  XFillRectangle(dpy[sn],sp,g1,0,0,w,h);
+  XFillRectangle(dpy[sn],mp,g1,0,0,w,h);
+  XSetForeground(dpy[sn],g1,1);
+  ch=shape;
+  XDrawString(dpy[sn],sp,g1,-l,a,&ch,1);
+  ch=shape+1;
+  XDrawString(dpy[sn],mp,g1,-l,a,&ch,1);
+  si=XGetImage(dpy[sn],sp,0,0,w,h,1,XYPixmap);
+  mi=XGetImage(dpy[sn],mp,0,0,w,h,1,XYPixmap);
+  d=malloc(w*k*h*k*4);
+  for (y=0;y<h*k;y++) {
+    for (x=0;x<w*k;x++) {
+      d[y*w*k+x]=XGetPixel(si,x/k,y/k)?0xff000000:
+	XGetPixel(mi,x/k,y/k)?0xffffffff:0;
+    }
+  }
+  XDestroyImage(si);
+  XDestroyImage(mi);
+  fmt=XRenderFindStandardFormat(dpy[sn],PictStandardARGB32);
+  ap=XCreatePixmap(dpy[sn],win[sn],w*k,h*k,32);
+  g32=XCreateGC(dpy[sn],ap,0,NULL);
+  ai=XCreateImage(dpy[sn],DefaultVisual(dpy[sn],DefaultScreen(dpy[sn])),
+		  32,ZPixmap,0,(char *)d,w*k,h*k,32,0);
+  XPutImage(dpy[sn],ap,g32,ai,0,0,0,0,w*k,h*k);
+  p=XRenderCreatePicture(dpy[sn],ap,fmt,0,NULL);
+  c=XRenderCreateCursor(dpy[sn],p,-l*k,a*k);
+  XRenderFreePicture(dpy[sn],p);
+  XDestroyImage(ai);
+  XFreeGC(dpy[sn],g32);
+  XFreeGC(dpy[sn],g1);
+  XFreePixmap(dpy[sn],ap);
+  XFreePixmap(dpy[sn],sp);
+  XFreePixmap(dpy[sn],mp);
+  XFreeFont(dpy[sn],fs);
+  return c;
+}
