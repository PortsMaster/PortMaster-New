+void COGLClass::selectOpaqueBlend(Mesh3Dg *mesh)
+{
+	if(not useOpaqueBlendSuppression()) return;
+	// World primary alpha is explicitly one. RGB REPLACE preserves it;
+	// a second RGB texture supplies alpha one to the saturating alpha ADD.
+	// RGBA-only/unknown materials retain the original framebuffer blending.
+	bool blend = not materialHasOpaqueAlpha(mesh);
+	if(blend != mOpaqueBlendEnabled) {
+		if(blend) glEnable(GL_BLEND);
+		else glDisable(GL_BLEND);
+		mOpaqueBlendEnabled = blend;
+	}
+}
