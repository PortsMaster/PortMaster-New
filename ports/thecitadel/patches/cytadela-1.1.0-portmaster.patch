+// Optional diagnostics: excluded entirely from release builds.
+#ifndef FRAME_PROFILE_H
+#define FRAME_PROFILE_H
+#ifdef CYTADELA_PROFILE
+#include <SDL2/SDL_timer.h>
+#include <cstdio>
+#include <cstdlib>
+#include <time.h>
+
+struct RenderProfile {
+	unsigned opaque = 0, transparent = 0, masks = 0, clears = 0;
+	unsigned opening = 0, closing = 0;
+	Uint64 floorTicks = 0, opaqueTicks = 0, sortTicks = 0, transparentTicks = 0, maskTicks = 0;
+	unsigned opaqueRuns = 0;
+	unsigned opaqueDraws = 0, opaqueSingletons = 0, batchBytes = 0;
+	unsigned opaqueAlphaOne = 0, alphaOneDraws = 0, floorAlphaOne = 0;
+};
+inline RenderProfile &renderProfile() { static RenderProfile data; return data; }
+
+class FrameProfile {
+	FILE *mFile;
+	Uint64 mLast;
+	double mScale;
+	double mClockOffset;
+	unsigned mFrames = 0;
+public:
+	FrameProfile() : mFile(nullptr), mLast(SDL_GetPerformanceCounter()),
+		mScale(1000.0 / SDL_GetPerformanceFrequency()) {
+		// SDL may use CLOCK_MONOTONIC_RAW; align event timestamps to the probe's clock.
+		timespec mono;
+		clock_gettime(CLOCK_MONOTONIC, &mono);
+		mClockOffset = mono.tv_sec + mono.tv_nsec / 1000000000.0 -
+			SDL_GetPerformanceCounter() * mScale / 1000.0;
+		const char *path = std::getenv("CYTADELA_PROFILE_PATH");
+		if(path) mFile = std::fopen(path, "a");
+		if(mFile) std::fprintf(mFile, "frame_ms,input_ms,update_ms,world_ms,hud_ms,swap_ms,x,z,rotation,pause,map,raw_delta_ms,monotonic_s,opaque,transparent,door_masks,door_clears,opening,closing,floor_ms,opaque_ms,sort_ms,transparent_ms,mask_ms,opaque_runs,opaque_draws,opaque_singletons,batch_bytes,opaque_alpha_one,alpha_one_draws,floor_alpha_one\n");
+	}
+	~FrameProfile() { if(mFile) std::fclose(mFile); }
+	Uint64 now() const { return SDL_GetPerformanceCounter(); }
+	void write(const Uint64 *t, float x, float z, float rotation, bool pause, bool map, unsigned delta) {
+		if(not mFile) return;
+		const RenderProfile &r = renderProfile();
+		std::fprintf(mFile, "%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.3f,%.3f,%.5f,%d,%d,%u,%.6f,%u,%u,%u,%u,%u,%u,%.4f,%.4f,%.4f,%.4f,%.4f,%u,%u,%u,%u,%u,%u,%u\n",
+			(t[5] - mLast) * mScale, (t[1] - t[0]) * mScale,
+			(t[2] - t[1]) * mScale, (t[3] - t[2]) * mScale,
+			(t[4] - t[3]) * mScale, (t[5] - t[4]) * mScale,
+			x, z, rotation, pause, map, delta, t[5] * mScale / 1000.0 + mClockOffset,
+			r.opaque, r.transparent, r.masks, r.clears, r.opening, r.closing,
+			r.floorTicks * mScale, r.opaqueTicks * mScale, r.sortTicks * mScale,
+			r.transparentTicks * mScale, r.maskTicks * mScale,
+			r.opaqueRuns, r.opaqueDraws, r.opaqueSingletons, r.batchBytes,
+			r.opaqueAlphaOne, r.alphaOneDraws, r.floorAlphaOne);
+		mLast = t[5];
+		// Flush only complete batches, never add a GL synchronization for profiling.
+		if(++mFrames % 120 == 0) std::fflush(mFile);
+	}
+};
+#endif
+#endif
