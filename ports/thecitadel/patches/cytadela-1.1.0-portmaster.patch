 //input functions
+#ifdef CYTADELA_CAPTURE
+static void captureCurrentFrame(SDL_Window *window, const char *path)
+{
+	if(not path) return;
+	int size[2];
+	SDL_GL_GetDrawableSize(window, &size[0], &size[1]);
+	std::vector<unsigned char> pixels(size_t(size[0]) * size[1] * 4);
+	using ReadPixels = void (*)(GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void *);
+	ReadPixels read = glReadPixels;
+	void *native = nullptr;
+	const char *driver = std::getenv("SDL_VIDEO_GL_DRIVER");
+	if(driver and strstr(driver, "/gl4es.")) {
+		native = SDL_LoadObject("libGLESv2.so");
+		if(native) read = reinterpret_cast<ReadPixels>(SDL_LoadFunction(native, "glReadPixels"));
+	}
+	glFlush(); // Capture-only: drain wrapper batches before native readback.
+	if(read) read(0, 0, size[0], size[1], GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+	if(native) SDL_UnloadObject(native);
+	FILE *file = fopen(path, "wb");
+	if(file) {
+		fwrite(size, sizeof(size), 1, file);
+		fwrite(pixels.data(), 1, pixels.size(), file);
+		fclose(file);
+	}
+}
+
+static void captureRequestedFrame(SDL_Window *window)
+{
+#ifdef CYTADELA_PROFILE
+	char requested[1024];
+	const char *request = std::getenv("CYTADELA_CAPTURE_REQUEST");
+	if(request) {
+		FILE *file = fopen(request, "r");
+		if(file) {
+			bool parsed = fscanf(file, "%1023[^\n]", requested) == 1;
+			fclose(file);
+			if(parsed) {
+				std::remove(request);
+				captureCurrentFrame(window, requested);
+			}
+		}
+	}
+#endif
+}
+
+void CSDLClass::swapBuffers()
+{
+	checkQuit();
+	static unsigned frames = 0;
+	if(++frames == 60) captureCurrentFrame(mWindow, std::getenv("CYTADELA_CAPTURE_FRAME"));
+	captureRequestedFrame(mWindow);
+	SDL_GL_SwapWindow(mWindow);
+}
+#endif
