+		mMaterial = mesh->materialNumber;
+		mOffset = offset;
+		mCount = count;
+	}
+public:
+	explicit OpaqueDrawBatch(size_t limit = 4095) : mLimit(std::min(limit, size_t(4095))) {}
+	void reset() {
+		mFirst = nullptr;
+		mCount = 0;
+		mVertices.clear();
+		mTexCoords.clear();
+	}
+	template<typename Draw> void flush(Draw draw) {
+		if(not mFirst) return;
+		bool copied = not mVertices.empty();
+		MeshBase3Dg *base = mFirst->getBase();
+		draw(mFirst, copied ? mVertices.data() : base->getVCoordsStream(),
+			copied ? mTexCoords.data() : base->getTCoordsStream(), mCount, mOffset, copied);
+		reset();
+	}
+	template<typename Draw> void add(Mesh3Dg *mesh, bool offset, Draw draw) {
+		size_t count = size_t(mesh->getBase()->getTriansQuantity()) * 3;
+		if(not count) return;
+		if(not mFirst) { start(mesh, offset, count); return; }
+		if(mMaterial != mesh->materialNumber or mOffset != offset or
+		   count > mLimit or mCount > mLimit - count) {
+			flush(draw);
+			start(mesh, offset, count);
+			return;
+		}
+		size_t total = mCount + count;
+		try {
+			// Reserve both arrays before changing contents, so failed allocations
+			// can submit the old run intact and retain the incoming singleton.
+			mVertices.reserve(total);
+			mTexCoords.reserve(total * 2);
+		} catch(const std::bad_alloc &) {
+			flush(draw);
+			start(mesh, offset, count);
+			return;
+		}
+		if(mVertices.empty()) {
+			MeshBase3Dg *first = mFirst->getBase();
+			mVertices.resize(mCount);
+			mTexCoords.resize(mCount * 2);
+			std::memcpy(mVertices.data(), first->getVCoordsStream(), mCount * sizeof(Point3Dg));
+			std::memcpy(mTexCoords.data(), first->getTCoordsStream(), mCount * 2 * sizeof(float));
+		}
+		mVertices.resize(total);
+		mTexCoords.resize(total * 2);
+		std::memcpy(mVertices.data() + mCount, mesh->getBase()->getVCoordsStream(), count * sizeof(Point3Dg));
+		std::memcpy(mTexCoords.data() + mCount * 2, mesh->getBase()->getTCoordsStream(), count * 2 * sizeof(float));
+		mCount = total;
+	}
+};
