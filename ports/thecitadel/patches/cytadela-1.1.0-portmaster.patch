+	const size_t limit = size_t(std::numeric_limits<GLsizei>::max() / 3) * 3;
+	while(first < count) {
+		size_t chunk = std::min(count - first, limit);
+		// The setter selects the material's original UVs. Replace both enabled
+		// arrays only after it has run, retaining exact vertex/triangle order.
+		if(copied or first) {
+			glClientActiveTexture(GL_TEXTURE0);
+			glTexCoordPointer(2, GL_FLOAT, 0, texCoords + first * 2);
+			if(mObjects->materials[mesh->materialNumber]->texturesQuantity >= 2) {
+				glClientActiveTexture(GL_TEXTURE1);
+				glTexCoordPointer(2, GL_FLOAT, 0, texCoords + first * 2);
+				glClientActiveTexture(GL_TEXTURE0);
+			}
+		}
+		glVertexPointer(3, GL_FLOAT, 0, vertices + first);
+		glDrawArrays(GL_TRIANGLES, 0, GLsizei(chunk));
+		first += chunk;
+#ifdef CYTADELA_PROFILE
+		++renderProfile().opaqueDraws;
+		if(materialHasOpaqueAlpha(mesh)) ++renderProfile().alphaOneDraws;
+#endif
+	}
