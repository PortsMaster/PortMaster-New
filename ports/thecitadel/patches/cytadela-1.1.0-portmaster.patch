+#ifndef GAMEPLAY_VIEWPORT_H
+#define GAMEPLAY_VIEWPORT_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+struct GameplayViewport {
+	int x, y, width, height, hudHeight;
+	float canvasHeight, verticalFov, referenceWorldAspect, canvasWidth;
+	int worldHeight() const { return height - hudHeight; }
+};
+
+inline GameplayViewport gameplayViewport(int requestedWidth, int requestedHeight,
+	int drawableWidth, int drawableHeight, bool fillTallScreen = true)
+{
+	requestedWidth = std::max(requestedWidth, 1);
+	requestedHeight = std::max(requestedHeight, 1);
+	if(drawableWidth <= 0 or drawableHeight <= 0) {
+		drawableWidth = requestedWidth;
+		drawableHeight = requestedHeight;
+	}
+	int fitWidth = drawableWidth;
+	int64_t fittedHeight = int64_t(drawableWidth) * requestedHeight / requestedWidth;
+	int fitHeight;
+	if(fittedHeight > drawableHeight) {
+		fitHeight = drawableHeight;
+		fitWidth = int(int64_t(drawableHeight) * requestedWidth / requestedHeight);
+	} else fitHeight = int(fittedHeight);
+	fitWidth = std::max(fitWidth, 1);
+	fitHeight = std::max(fitHeight, 1);
+	int height = fillTallScreen ? drawableHeight : fitHeight;
+	int width = fillTallScreen ? drawableWidth : fitWidth;
+	int hudHeight = std::min(fitHeight / 5, std::max(height - 1, 0));
+	int referenceWorldHeight = std::max(fitHeight - hudHeight, 1);
+	int worldHeight = std::max(height - hudHeight, 1);
+	// Expand the visible world on either axis, preserving the fitted view's pixel scale.
+	const double pi = 3.14159265358979323846;
+	float fov = float(2 * std::atan(std::tan(pi / 8) * worldHeight / referenceWorldHeight) * 180 / pi);
+	return {(drawableWidth - width) / 2, (drawableHeight - height) / 2,
+		width, height, hudHeight, 200.0f * height / fitHeight,
+		fov, float(width) / referenceWorldHeight, 320.0f * width / fitWidth};
+}
+#endif
