+#ifdef CYTADELA_PROFILE
+bool COGLClass::profileAlphaBackend()
+{
+	// Compare blended/unblended draws in the live backend, including minification,
+	// border sampling, two-texture alpha ADD, and non-opaque negative controls.
+	glPushAttrib(GL_ALL_ATTRIB_BITS);
+	glMatrixMode(GL_PROJECTION);
+	glPushMatrix();
+	glLoadIdentity();
+	glMatrixMode(GL_MODELVIEW);
+	glPushMatrix();
+	glLoadIdentity();
+	glViewport(0, 0, 8, 4);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_STENCIL_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_CULL_FACE);
+	glDisable(GL_FOG);
+	glDisable(GL_ALPHA_TEST);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	GLint alphaBits = 0;
+	glGetIntegerv(GL_ALPHA_BITS, &alphaBits);
+	fprintf(stdout, "Blend alpha backend storage: alpha_bits=%d\n", alphaBits);
+	GLuint textures[3];
+	glGenTextures(3, textures);
+	bool passed = true;
+	for(unsigned index = 0; index < 3; ++index) {
+		bool rgba = index != 0;
+		unsigned stride = rgba ? 4 : 3;
+		std::vector<unsigned char> data(16 * 16 * stride);
+		for(unsigned i = 0; i < 16 * 16; ++i) {
+			data[i * stride] = rgba ? 30 : 220;
+			data[i * stride + 1] = rgba ? 70 : 135;
+			data[i * stride + 2] = rgba ? 210 : 45;
+			if(rgba) data[i * stride + 3] = index == 1 ? 96 : 0;
+		}
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, textures[index]);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		if(gluBuild2DMipmaps(GL_TEXTURE_2D, stride, 16, 16, rgba ? GL_BGRA : GL_BGR,
+			GL_UNSIGNED_BYTE, data.data()) != GL_NO_ERROR) passed = false;
+	}
+	using ReadPixels = void (*)(GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void *);
