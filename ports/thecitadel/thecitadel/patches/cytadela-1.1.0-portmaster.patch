+#ifdef CYTADELA_CAPTURE
+void CSDLClass::swapBuffers()
+{
+	checkQuit();
+	static unsigned frames = 0;
+	if(++frames == 60) {
+		const char *path = std::getenv("CYTADELA_CAPTURE_FRAME");
+		if(path) {
+			int size[2];
+			SDL_GL_GetDrawableSize(mWindow, &size[0], &size[1]);
+			std::vector<unsigned char> pixels(size_t(size[0]) * size[1] * 4);
+			using ReadPixels = void (*)(GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void *);
+			ReadPixels read = glReadPixels;
+			void *native = nullptr;
+			const char *driver = std::getenv("SDL_VIDEO_GL_DRIVER");
+			if(driver and strstr(driver, "/gl4es.")) {
+				native = SDL_LoadObject("libGLESv2.so");
+				if(native)
+					read = reinterpret_cast<ReadPixels>(SDL_LoadFunction(native, "glReadPixels"));
+			}
+			if(read)
+				read(0, 0, size[0], size[1], GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+			if(native) SDL_UnloadObject(native);
+			FILE *file = fopen(path, "wb");
+			if(file) {
+				fwrite(size, sizeof(size), 1, file);
+				fwrite(pixels.data(), 1, pixels.size(), file);
+				fclose(file);
+			}
+		}
+	}
+	SDL_GL_SwapWindow(mWindow);
+}
+#endif
