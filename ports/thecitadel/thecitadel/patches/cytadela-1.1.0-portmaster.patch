+bool CSDLClass::pollEvent(SDL_Event *event)
+{
+	if(not SDL_PollEvent(event))
+		return false;
+	if(event->type == SDL_QUIT or
+	   (event->type == SDL_WINDOWEVENT and event->window.event == SDL_WINDOWEVENT_CLOSE))
+		throw QuitRequested();
+	return true;
+}
+
+void CSDLClass::checkQuit()
+{
+	//Animations and fades render without reading input, so check their queue too.
+	SDL_PumpEvents();
+	if(SDL_HasEvent(SDL_QUIT))
+		throw QuitRequested();
+}
+
+void CSDLClass::delay(uint32_t miliseconds)
+{
+	uint32_t start = SDL_GetTicks();
+	while(true) {
+		checkQuit();
+		uint32_t elapsed = SDL_GetTicks() - start;
+		if(elapsed >= miliseconds)
+			return;
+		uint32_t remaining = miliseconds - elapsed;
+		SDL_Delay(remaining > 16 ? 16 : remaining);
+	}
+}
