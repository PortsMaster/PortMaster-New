+{
+	if(not audioCapture.file) return;
+	size_t count = size_t(length) < audioCapture.remaining ? size_t(length) : audioCapture.remaining;
+	fwrite(stream, 1, count, audioCapture.file);
+	audioCapture.remaining -= count;
+	if(not audioCapture.remaining) {
+		fclose(audioCapture.file);
+		audioCapture.file = nullptr;
+	}
