+void CSDLClass::drawFrame()
+{
+	checkQuit();
+	if(not mPersistentGL) {
+		SDL_Surface *windowSurface = SDL_GetWindowSurface(mWindow);
+		if(windowSurface and mScreen) {
+			SDL_FillRect(windowSurface, nullptr, SDL_MapRGB(windowSurface->format, 0, 0, 0));
+			int width = windowSurface->w;
+			int height = width * mScreen->h / mScreen->w;
+			if(height > windowSurface->h) {
+				height = windowSurface->h;
+				width = height * mScreen->w / mScreen->h;
+			}
+			SDL_Rect target = {(windowSurface->w - width) / 2, (windowSurface->h - height) / 2, width, height};
+			SDL_BlitScaled(mScreen, nullptr, windowSurface, &target);
+		}
+		SDL_UpdateWindowSurface(mWindow);
+		return;
+	}
+	//Software menus and videos share one context with the existing GL renderer.
+	glPushAttrib(GL_ALL_ATTRIB_BITS);
+	int drawableWidth, drawableHeight;
+	SDL_GL_GetDrawableSize(mWindow, &drawableWidth, &drawableHeight);
+	int width = drawableWidth;
+	int height = width * mScreen->h / mScreen->w;
+	if(height > drawableHeight) {
+		height = drawableHeight;
+		width = height * mScreen->w / mScreen->h;
+	}
+	glDisable(GL_SCISSOR_TEST);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glClearColor(0, 0, 0, 1);
+	glClear(GL_COLOR_BUFFER_BIT);
+	glViewport((drawableWidth - width) / 2, (drawableHeight - height) / 2, width, height);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_STENCIL_TEST);
+	glDisable(GL_CULL_FACE);
+	glDisable(GL_FOG);
+	glDisable(GL_LIGHTING);
+	glDisable(GL_BLEND);
+	glDisable(GL_ALPHA_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glActiveTexture(GL_TEXTURE1);
+	glDisable(GL_TEXTURE_2D);
+	glActiveTexture(GL_TEXTURE0);
+	glEnable(GL_TEXTURE_2D);
+	if(not mMenuTexture)
+		glGenTextures(1, &mMenuTexture);
+	glBindTexture(GL_TEXTURE_2D, mMenuTexture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, mScreen->w, mScreen->h, 0, GL_RGBA, GL_UNSIGNED_BYTE, mScreen->pixels);
+	glMatrixMode(GL_PROJECTION);
+	glPushMatrix();
+	glLoadIdentity();
+	glMatrixMode(GL_MODELVIEW);
+	glPushMatrix();
+	glLoadIdentity();
+	glBegin(GL_QUADS);
+	glTexCoord2f(0, 0); glVertex2f(-1, 1);
+	glTexCoord2f(1, 0); glVertex2f(1, 1);
+	glTexCoord2f(1, 1); glVertex2f(1, -1);
+	glTexCoord2f(0, 1); glVertex2f(-1, -1);
+	glEnd();
+	glPopMatrix();
+	glMatrixMode(GL_PROJECTION);
+	glPopMatrix();
+	glMatrixMode(GL_MODELVIEW);
+	glPopAttrib();
+	SDL_GL_SwapWindow(mWindow);
+}
