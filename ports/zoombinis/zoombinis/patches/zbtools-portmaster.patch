+/* The 'STRL' lists of a Mohawk archive, by id: a count byte, then the strings,
+   each ending in a 0. */
+static std::vector<std::pair<int, std::vector<std::string>>> readStringLists(const std::vector<unsigned char> &d)
+{
+    auto be = [&](size_t at, int n) {
+        unsigned long value = 0;
+        for (int i = 0; i < n; i++)
+            value = value << 8 | (at + i < d.size() ? d[at + i] : 0);
+        return value;
+    };
+    std::vector<std::pair<int, std::vector<std::string>>> lists;
+    if (d.size() < 28 || memcmp(d.data(), "MHWK", 4) || memcmp(d.data() + 8, "RSRC", 4))
+        return lists;
+    size_t directory = be(20, 4), files = directory + be(24, 2);
+    unsigned long types = be(directory + 2, 2), fileCount = be(files, 4);
+    for (unsigned long t = 0; t < types; t++) {
+        size_t type = directory + 4 + t * 8;
+        if (type + 8 > d.size() || memcmp(d.data() + type, "STRL", 4))
+            continue;
+        size_t table = directory + be(type + 4, 2);
+        for (unsigned long r = 0, count = be(table, 2); r < count; r++) {
+            unsigned long id = be(table + 2 + r * 4, 2), index = be(table + 4 + r * 4, 2);
+            if (!index || index > fileCount)
+                continue;
+            size_t entry = files + 4 + (index - 1) * 10;
+            size_t at = be(entry, 4), size = be(entry + 4, 2) | be(entry + 6, 1) << 16 | (be(entry + 7, 1) & 7) << 24;
+            if (at + size > d.size() || !size)
+                continue;
+            std::vector<std::string> strings;
+            std::string text;
+            for (size_t i = at + 1; i < at + size && strings.size() < d[at]; i++) {
+                unsigned char c = d[i];
+                if (!c) {
+                    strings.push_back(text);
+                    text.clear();
+                } else
+                    text += (char)(c >= 0x80 ? macRoman[c - 0x80] : c);
+            }
+            if (strings.size() == d[at])
+                lists.push_back({(int)id, strings});
+        }
+    }
+    return lists;
+}
