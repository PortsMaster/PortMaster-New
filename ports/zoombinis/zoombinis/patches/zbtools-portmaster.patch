+/* A localized CD (French, German: Windows 3.1's build) keeps the game's texts
+   in TEXTSTR.MHK, which the Windows 95 build doesn't read: they replace the
+   English ones, list by list where a list has as many as the game's table
+   (the dialogs' first 42; the credits stay English). */
+static void useLocalizedTexts(const std::filesystem::path &cd)
+{
+    namespace fs = std::filesystem;
+    std::error_code error;
+    fs::path file;
+    for (const auto &entry : fs::directory_iterator(cd / "DATA", error)) {
+        std::string name = entry.path().filename().string();
+        for (char &c : name)
+            c = (char)toupper((unsigned char)c);
+        if (name == "TEXTSTR.MHK")
+            file = entry.path();
+    }
+    if (file.empty())
+        return;
+    std::ifstream in(file, std::ios::binary);
+    std::vector<unsigned char> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    struct Target
+    {
+        int id;
+        size_t count; /* the list's */
+        const char **table;
+        size_t first, used;
+    };
+    const Target targets[] = {
+        {2000, 16, (const char **)placeNames, 0, 16},   {2002, 21, (const char **)mapTexts, 0, 21},
+        {2004, 6, (const char **)levelTexts, 0, 6},     {2006, 4, (const char **)levelTexts, 6, 4},
+        {2008, 1, (const char **)levelTexts, 10, 1},    {2010, 12, (const char **)levelTexts, 11, 12},
+        {2012, 1, (const char **)levelTexts, 23, 1},    {2014, 16, (const char **)monumentTexts, 0, 16},
+        {2016, 16, (const char **)featTexts, 0, 16},    {2018, 47, dialogTexts, 0, 42},
+        {2023, 14, toggleTexts, 1, 14},
+    };
+    int used = 0;
+    for (const auto &list : readStringLists(data))
+        for (const Target &target : targets)
+            if (list.first == target.id && list.second.size() == target.count) {
+                for (size_t i = 0; i < target.used; i++) {
+                    std::string text = list.second[i];
+                    const char *english = target.table[target.first + i];
+                    /* (the population's "...\rpopulation " is followed by the number) */
+                    if (*english && english[strlen(english) - 1] == ' ' && (text.empty() || text.back() != ' '))
+                        text += ' ';
+                    target.table[target.first + i] = strdup(text.c_str());
+                }
+                used++;
+            }
+    printf("texts from %s: %d of %d lists\n", file.filename().string().c_str(), used, (int)(sizeof targets / sizeof *targets));
+}
