+/* --- MIDI out: midiStream* and the midiOut* calls a stream takes ---
+ * One synthesizer device, TinySoundFont (HLE_WITH_TSF) playing the SoundFont
+ * a host names (hle_midi_soundfont), into a dsound.c host stream. A thread of
+ * its own sequences the stream's MIDIEVENTs against the samples it renders,
+ * so the timing is the audio's. Without a SoundFont the events still run in
+ * time, silently, and every buffer comes back done as it would. midiOutOpen
+ * and midiOutShortMsg are not here: no title has asked for them yet. */
+#ifdef HLE_WITH_TSF
+#define TSF_IMPLEMENTATION
+#include "tsf.h"
+static tsf *g_tsf;
+#endif
+static char g_sf_path[1024];
+void hle_midi_soundfont(const char *path) { snprintf(g_sf_path, sizeof g_sf_path, "%s", path ? path : ""); }
+
+#define MIDI_RATE   44100
+#define MIDI_QUEUE  32
+#define MIDI_AHEAD  2048                      /* frames kept queued in the mixer: ~46 ms */
+#define MHDR_INQUEUE 0x00000004u
+#define MHDR_ISSTRM  0x00000008u
+#define HMS 0x5A5F0001u
+static struct {
+    int used, stream, paused;
+    uint32_t cb, inst, flags;
+    uint32_t timediv, tempo;                  /* ticks per quarter note; microseconds per quarter */
+    uint32_t q[MIDI_QUEUE]; int qn;
+    uint32_t off;                             /* the next event's byte offset in q[0] */
+    double wait;                              /* frames until it is due, once read; <0 not read yet */
+    uint64_t ticks; double tick_frac;         /* ticks played, for midiStreamPosition */
+} g_ms;
+
+static void midi_short(uint32_t m) {
+#ifdef HLE_WITH_TSF
+    if (!g_tsf) return;
+    int st = m & 0xF0, ch = m & 0x0F, d1 = (m >> 8) & 0x7F, d2 = (m >> 16) & 0x7F;
+    switch (st) {
+    case 0x80: tsf_channel_note_off(g_tsf, ch, d1); break;
+    case 0x90: if (d2) tsf_channel_note_on(g_tsf, ch, d1, d2 / 127.0f); else tsf_channel_note_off(g_tsf, ch, d1); break;
+    case 0xB0: tsf_channel_midi_control(g_tsf, ch, d1, d2); break;
+    case 0xC0: tsf_channel_set_presetnumber(g_tsf, ch, d1, ch == 9); break;
+    case 0xE0: tsf_channel_set_pitchwheel(g_tsf, ch, d1 | d2 << 7); break;
+    default: break;                           /* aftertouch: not modelled */
+    }
+#else
+    (void)m;
+#endif
+}
+static void midi_silence(void) {
+#ifdef HLE_WITH_TSF
+    if (g_tsf) tsf_note_off_all(g_tsf);
+#endif
+}
+static double frames_per_tick(void) {
+    uint32_t div = g_ms.timediv ? g_ms.timediv : 96;
+    return (double)g_ms.tempo / 1e6 * MIDI_RATE / (double)(div & 0x7FFF);
+}
+/* Under g_mmq: run the events due within `frames`, and say how many frames
+ * pass before the next one (or all of them). A finished header goes to
+ * done[]; returns how many frames to render before calling again. */
+static int midi_step(int frames, uint32_t *done, int *ndone) {
+    while (!g_ms.paused && g_ms.qn) {
+        uint32_t h = g_ms.q[0], data = MEM32(h), len = MEM32(h + 8);
+        if (g_ms.off + 12 > len) {            /* this buffer is played */
+            done[(*ndone)++] = h;
+            memmove(g_ms.q, g_ms.q + 1, sizeof(uint32_t) * (size_t)--g_ms.qn);
+            g_ms.off = 0, g_ms.wait = -1;
+            continue;
+        }
+        uint32_t at = data + g_ms.off;
+        if (g_ms.wait < 0) g_ms.wait = MEM32(at) * frames_per_tick();
+        if (g_ms.wait >= 1.0) {
+            int n = g_ms.wait < frames ? (int)g_ms.wait : frames;
+            g_ms.wait -= n;
+            double t = n / frames_per_tick() + g_ms.tick_frac;
+            g_ms.ticks += (uint64_t)t, g_ms.tick_frac = t - (double)(uint64_t)t;
+            return n;
+        }
+        g_ms.ticks += MEM32(at);
+        uint32_t ev = MEM32(at + 8), type = (ev >> 24) & ~0x40u;   /* MEVT_F_CALLBACK aside */
+        if (ev & 0x80000000u) g_ms.off += 12 + (((ev & 0xFFFFFFu) + 3u) & ~3u);   /* MEVT_F_LONG: sysex, comment: skipped */
+        else {
+            if (type == 0) midi_short(ev & 0xFFFFFFu);              /* MEVT_SHORTMSG */
+            else if (type == 1) g_ms.tempo = ev & 0xFFFFFFu;         /* MEVT_TEMPO */
+            g_ms.off += 12;
+        }
+        g_ms.wait = -1;
+    }
+    return frames;
+}
+static void *midi_thread(void *arg) {
+    (void)arg;
+    int16_t pcm[2 * 512];
+    for (;;) {
+        if (!g_ms.used || hle_audio_stream_queued(g_ms.stream) >= MIDI_AHEAD) { usleep(3000); continue; }
+        uint32_t done[MIDI_QUEUE + 1]; int ndone = 0, left = 512, at = 0;
+        pthread_mutex_lock(&g_mmq);
+        while (left > 0 && g_ms.used) {
+            int n = midi_step(left, done, &ndone);
+#ifdef HLE_WITH_TSF
+            if (g_tsf) tsf_render_short(g_tsf, pcm + 2 * at, n, 0);
+            else
+#endif
+            memset(pcm + 2 * at, 0, sizeof(int16_t) * 2 * (size_t)n);
+            at += n, left -= n;
+        }
+        int stream = g_ms.used ? g_ms.stream : -1;
+        uint32_t flags = g_ms.flags, cb = g_ms.cb, inst = g_ms.inst;
+        pthread_mutex_unlock(&g_mmq);
+        if (stream >= 0) hle_audio_stream_push(stream, pcm, at);
+        for (int k = 0; k < ndone; k++) {
+            hdr_done(done[k], MHDR_INQUEUE);
+            mm_notify(flags, cb, inst, HMS, MOM_DONE, done[k]);
+        }
+    }
+    return NULL;
+}
+
+static void m_midiOutGetNumDevs(void) { RET(1, 0); }
+/* MIDIOUTCAPSA: a synthesizer that takes streams, reported as an FM synth
+ * (MOD_FMSYNTH), what a 1995 sound card's device 0 was: Hover! plays music
+ * only on an FM synth or the MIDI mapper, and turns it off for anything else. */
+static void m_midiOutGetDevCapsA(void) {      /* (devID, &caps, cb) */
+    uint32_t c = A32(1);
+    if (!c || A32(2) < 52) RET(97u, 3);
+    memset(APTR(1), 0, 52);
+    MEM16(c) = 1, MEM16(c + 2) = 2, MEM32(c + 4) = 0x0100;
+    strcpy((char *)hle_ptr(c + 8), "win32hle synthesizer");
+    MEM16(c + 40) = 4 /* MOD_FMSYNTH */, MEM16(c + 42) = 64, MEM16(c + 44) = 64, MEM16(c + 46) = 0xFFFF;
+    MEM32(c + 48) = 0x0009u;                  /* MIDICAPS_VOLUME | MIDICAPS_STREAM */
+    RET(MMSYSERR_NOERROR, 3);
+}
+static void m_midiStreamOpen(void) {          /* (&hms, &devID, cMidi, cb, inst, flags) */
+    if (g_ms.used) RET(MMSYSERR_ALLOCATED, 6);
+    int stream = hle_audio_stream_open(MIDI_RATE, 2);
+    if (stream < 0) RET(MMSYSERR_ALLOCATED, 6);
+#ifdef HLE_WITH_TSF
+    if (!g_tsf && g_sf_path[0]) {
+        g_tsf = tsf_load_filename(g_sf_path);
+        fprintf(stderr, "[winmm] SoundFont %s: %s\n", g_sf_path, g_tsf ? "loaded" : "could not be read, MIDI is silent");
+        if (g_tsf) {
+            tsf_set_output(g_tsf, TSF_STEREO_INTERLEAVED, MIDI_RATE, 0.0f);
+            tsf_set_max_voices(g_tsf, 64);
+        }
+    }
+    if (g_tsf) {
+        tsf_reset(g_tsf);
+        tsf_channel_set_bank_preset(g_tsf, 9, 128, 0);  /* GM: channel 10 is drums */
+    }
+#else
+    fprintf(stderr, "[winmm] midiStreamOpen: no synthesizer in this build, MIDI is silent\n");
+#endif
+    static int running;
+    if (!running) { pthread_t t; if (pthread_create(&t, NULL, midi_thread, NULL) == 0) pthread_detach(t), running = 1; }
+    pthread_mutex_lock(&g_mmq);
+    memset(&g_ms, 0, sizeof g_ms);
+    g_ms.stream = stream, g_ms.paused = 1, g_ms.wait = -1;   /* a stream opens paused */
+    g_ms.timediv = 96, g_ms.tempo = 500000;
+    g_ms.cb = A32(3), g_ms.inst = A32(4), g_ms.flags = A32(5);
+    g_ms.used = 1;
+    pthread_mutex_unlock(&g_mmq);
+    if (A32(0)) MEM32(A32(0)) = HMS;
+    mm_notify(A32(5), A32(3), A32(4), HMS, MOM_OPEN, 0);
+    RET(MMSYSERR_NOERROR, 6);
+}
+#define MS_OK(h) (g_ms.used && (h) == HMS)
+/* Every queued buffer back, done, and every note off: midiStreamStop, midiOutReset. */
+static void ms_return_all(void) {
+    uint32_t done[MIDI_QUEUE]; int n;
+    pthread_mutex_lock(&g_mmq);
+    n = g_ms.qn;
+    memcpy(done, g_ms.q, sizeof(uint32_t) * (size_t)n);
+    g_ms.qn = 0, g_ms.off = 0, g_ms.wait = -1;
+    midi_silence();
+    pthread_mutex_unlock(&g_mmq);
+    for (int k = 0; k < n; k++) {
+        hdr_done(done[k], MHDR_INQUEUE);
+        mm_notify(g_ms.flags, g_ms.cb, g_ms.inst, HMS, MOM_DONE, done[k]);
+    }
+}
+static void m_midiStreamOut(void) {           /* (hms, MIDIHDR*, cb) */
+    uint32_t h = A32(1);
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 3);
+    if (!h || !(MEM32(h + 16) & 2u)) RET(64u /* MIDIERR_UNPREPARED */, 3);
+    pthread_mutex_lock(&g_mmq);
+    if (g_ms.qn == MIDI_QUEUE) { pthread_mutex_unlock(&g_mmq); RET(MMSYSERR_ERROR, 3); }
+    MEM32(h + 16) = (MEM32(h + 16) & ~WHDR_DONE) | MHDR_INQUEUE | MHDR_ISSTRM;
+    g_ms.q[g_ms.qn++] = h;
+    pthread_mutex_unlock(&g_mmq);
+    RET(MMSYSERR_NOERROR, 3);
+}
+static void m_midiStreamRestart(void) {
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 1);
+    g_ms.paused = 0;
+    RET(MMSYSERR_NOERROR, 1);
+}
+static void m_midiStreamPause(void) {
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 1);
+    pthread_mutex_lock(&g_mmq);
+    g_ms.paused = 1;
+    midi_silence();
+    pthread_mutex_unlock(&g_mmq);
+    RET(MMSYSERR_NOERROR, 1);
+}
+static void m_midiStreamStop(void) {
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 1);
+    g_ms.paused = 1;
+    ms_return_all();
+    g_ms.ticks = 0, g_ms.tick_frac = 0;
+    RET(MMSYSERR_NOERROR, 1);
+}
+static void m_midiOutReset(void) {
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 1);
+    ms_return_all();
+    RET(MMSYSERR_NOERROR, 1);
+}
+static void m_midiStreamClose(void) {
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 1);
+    ms_return_all();
+    uint32_t flags = g_ms.flags, cb = g_ms.cb, inst = g_ms.inst;
+    pthread_mutex_lock(&g_mmq);
+    hle_audio_stream_close(g_ms.stream);
+    g_ms.used = 0;
+    pthread_mutex_unlock(&g_mmq);
+    mm_notify(flags, cb, inst, HMS, MOM_CLOSE, 0);
+    RET(MMSYSERR_NOERROR, 1);
+}
+/* (hms, MIDIPROP*, flags): MIDIPROP_SET 0x80000000 / GET 0x40000000, of
+ * MIDIPROP_TIMEDIV 1 or MIDIPROP_TEMPO 2; the struct is {cbStruct, value}. */
+static void m_midiStreamProperty(void) {
+    uint32_t p = A32(1), f = A32(2);
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 3);
+    if (!p) RET(97u, 3);
+    uint32_t *v = (f & 1u) ? &g_ms.timediv : (f & 2u) ? &g_ms.tempo : NULL;
+    if (!v) RET(97u, 3);
+    pthread_mutex_lock(&g_mmq);
+    if (f & 0x80000000u) *v = MEM32(p + 4);
+    else MEM32(p + 4) = *v;
+    pthread_mutex_unlock(&g_mmq);
+    RET(MMSYSERR_NOERROR, 3);
+}
+/* (hms, MMTIME*, cb): ticks (TIME_TICKS 0x20), otherwise milliseconds (TIME_MS 1). */
+static void m_midiStreamPosition(void) {
+    uint32_t mt = A32(1);
+    if (!MS_OK(A32(0))) RET(MMSYSERR_INVALHANDLE, 3);
+    if (!mt) RET(97u, 3);
+    pthread_mutex_lock(&g_mmq);
+    uint64_t ticks = g_ms.ticks;
+    double ms = (double)ticks * frames_per_tick() * 1000.0 / MIDI_RATE;
+    pthread_mutex_unlock(&g_mmq);
+    if (MEM32(mt) == 0x20u) MEM32(mt + 4) = (uint32_t)ticks;
+    else MEM32(mt) = 1u, MEM32(mt + 4) = (uint32_t)ms;
+    RET(MMSYSERR_NOERROR, 3);
+}
+static void m_midiOutPrepareHeader(void)   { uint32_t h = A32(1); if (h) MEM32(h + 16) |= 2u; RET(MMSYSERR_NOERROR, 3); }
+static void m_midiOutUnprepareHeader(void) {
+    uint32_t h = A32(1);
+    if (h && (MEM32(h + 16) & MHDR_INQUEUE)) RET(65u /* MIDIERR_STILLPLAYING */, 3);
+    if (h) MEM32(h + 16) &= ~2u;
+    RET(MMSYSERR_NOERROR, 3);
+}
