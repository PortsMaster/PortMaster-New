+/* --- sndPlaySoundA: a WAV file (or one in memory, SND_MEMORY) on a stream of
+ * its own; a new sound stops the last one, as on Windows. Without SND_ASYNC
+ * the call returns once it has played. SND_LOOP plays it once. */
+static int g_snd = -1, g_snd_rate;
+static void m_sndPlaySoundA(void) {           /* (name or WAV, flags) */
+    uint32_t name = A32(0), flags = A32(1);
+    if (g_snd >= 0) hle_audio_stream_flush(g_snd);
+    if (!name) RET(1, 2);
+    SDL_RWops *rw = NULL;
+    char host[1024];
+    if (flags & 0x0004u) rw = SDL_RWFromConstMem(hle_ptr(name), (int)(MEM32(name + 4) + 8));   /* SND_MEMORY: a RIFF image */
+    else if (hle_host_path((const char *)hle_ptr(name), host, sizeof host)) rw = SDL_RWFromFile(host, "rb");
+    SDL_AudioSpec spec; Uint8 *buf = NULL; Uint32 len = 0;
+    if (!rw || !SDL_LoadWAV_RW(rw, 1, &spec, &buf, &len)) {
+        fprintf(stderr, "[winmm] sndPlaySoundA(%s): not played\n", flags & 0x0004u ? "<memory>" : (const char *)hle_ptr(name));
+        RET(0, 2);
+    }
+    SDL_AudioCVT cvt;
+    if (SDL_BuildAudioCVT(&cvt, spec.format, spec.channels, spec.freq, AUDIO_S16SYS, 2, spec.freq) < 0) { SDL_FreeWAV(buf); RET(0, 2); }
+    cvt.len = (int)len;
+    cvt.buf = (Uint8 *)SDL_malloc((size_t)len * (size_t)(cvt.len_mult > 0 ? cvt.len_mult : 1));
+    memcpy(cvt.buf, buf, len);
+    SDL_FreeWAV(buf);
+    SDL_ConvertAudio(&cvt);
+    if (g_snd >= 0 && g_snd_rate != spec.freq) hle_audio_stream_close(g_snd), g_snd = -1;
+    if (g_snd < 0) g_snd = hle_audio_stream_open(spec.freq, 2), g_snd_rate = spec.freq;
+    if (g_snd >= 0) hle_audio_stream_push(g_snd, (const int16_t *)cvt.buf, cvt.len_cvt / 4);
+    SDL_free(cvt.buf);
+    if (!(flags & 0x0001u) && g_snd >= 0)     /* not SND_ASYNC: wait for it, the machine given up */
+        while (hle_audio_stream_queued(g_snd) > 0) { hle_block_begin(); usleep(2000); hle_block_end(); }
+    RET(1, 2);
+}
