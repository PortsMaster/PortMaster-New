#!/bin/bash
# Build unity4convert. Inside a Debian bullseye arm64 chroot (or on any aarch64 Linux with gcc) it builds the shipped
# aarch64 binary out/unity4convert (glibc only); on an x86_64 PC it builds out/unity4convert-host for PC tests.
# The layout reference is compiled in: after u4layouts.json changes, run gen_layouts.py first (see its header).
set -e
cd "$(dirname "$0")"
mkdir -p out
if [ "$(uname -m)" = aarch64 ]; then
  gcc -O2 -Wall -s -march=armv8-a -o out/unity4convert unity4convert.c
  ls -l out/unity4convert
else
  gcc -O2 -Wall -o out/unity4convert-host unity4convert.c
  ls -l out/unity4convert-host
fi
