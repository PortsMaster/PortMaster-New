+			try
+			{
+				string patchFile = Environment.GetEnvironmentVariable("FNA_PATCH");
+				if (!string.IsNullOrEmpty(patchFile))
+				{
+					Assembly patch = Assembly.LoadFrom(patchFile);
+					foreach (Type type in patch.GetTypes())
+					{
+						if (!Attribute.IsDefined(type, typeof(ModEntryPointAttribute)))
+						{
+							continue;
+						}
+						MethodInfo main = type.GetMethod("Main");
+						if (main != null)
+						{
+							FNALoggerEXT.LogInfo("FNA_PATCH: " + type.FullName);
+							main.Invoke(null, null);
+						}
+					}
+				}
+			}
