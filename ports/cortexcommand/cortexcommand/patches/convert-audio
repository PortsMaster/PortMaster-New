#!/bin/bash
# Usage: convert-audio.sh <Data dir>
# Converts every .flac/.ogg to 96 kbps MP3 and points the .ini/.lua references at the new files.
set -e
cd "$1"
find . \( -name '*.flac' -o -name '*.ogg' \) -print0 |
    xargs -0 -P"$(nproc)" -I{} sh -c 'ffmpeg -nostdin -v error -y -i "$1" -map_metadata -1 -vn -c:a libmp3lame -b:a 96k "${1%.*}.mp3" && rm "$1"' _ {}
find . \( -name '*.ini' -o -name '*.lua' \) -print0 | xargs -0 sed -i -E 's/\.(flac|ogg)\b/.mp3/g'
