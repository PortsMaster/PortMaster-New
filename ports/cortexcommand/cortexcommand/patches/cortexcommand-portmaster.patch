 #include <array>
 #include <cstring>
 
+#ifdef __linux__
+#include "fmod/fmod_output.h"
+#include <SDL3/SDL.h>
+#include <vector>
+
+namespace {
+	struct SDLOutputData {
+		SDL_AudioStream* stream = nullptr;
+		std::vector<float> buffer;
+		int rate = 48000;
+	};
+
+	void SDLCALL SDLOutputFeed(void* userdata, SDL_AudioStream* stream, int additionalAmount, int totalAmount) {
+		FMOD_OUTPUT_STATE* outputState = static_cast<FMOD_OUTPUT_STATE*>(userdata);
+		SDLOutputData* data = static_cast<SDLOutputData*>(outputState->plugindata);
+		int frames = static_cast<int>(data->buffer.size() / 2);
+		while (additionalAmount > 0) {
+			FMOD_OUTPUT_READFROMMIXER(outputState, data->buffer.data(), frames);
+			SDL_PutAudioStreamData(stream, data->buffer.data(), frames * 2 * static_cast<int>(sizeof(float)));
+			additionalAmount -= frames * 2 * static_cast<int>(sizeof(float));
+		}
+	}
+
+	FMOD_RESULT F_CALL SDLOutputGetNumDrivers(FMOD_OUTPUT_STATE* outputState, int* numDrivers) {
+		*numDrivers = 1;
+		return FMOD_OK;
+	}
+
+	FMOD_RESULT F_CALL SDLOutputGetDriverInfo(FMOD_OUTPUT_STATE* outputState, int id, char* name, int nameLength, FMOD_GUID* guid, int* systemRate, FMOD_SPEAKERMODE* speakerMode, int* speakerModeChannels) {
+		if (name && nameLength > 0) {
+			SDL_strlcpy(name, "SDL", nameLength);
+		}
+		if (guid) {
+			std::memset(guid, 0, sizeof(FMOD_GUID));
+		}
+		*systemRate = 48000;
+		*speakerMode = FMOD_SPEAKERMODE_STEREO;
+		*speakerModeChannels = 2;
+		return FMOD_OK;
+	}
+
+	FMOD_RESULT F_CALL SDLOutputInit(FMOD_OUTPUT_STATE* outputState, int selectedDriver, FMOD_INITFLAGS flags, int* outputRate, FMOD_SPEAKERMODE* speakerMode, int* speakerModeChannels, FMOD_SOUND_FORMAT* outputFormat, int dspBufferLength, int* dspNumBuffers, int* dspNumAdditionalBuffers, void* extraDriverData) {
+		if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+			return FMOD_ERR_OUTPUT_INIT;
+		}
+		SDLOutputData* data = new SDLOutputData();
+		data->rate = *outputRate > 0 ? *outputRate : 48000;
+		data->buffer.resize(static_cast<size_t>(dspBufferLength) * 2);
+		outputState->plugindata = data;
+		*outputRate = data->rate;
+		*speakerMode = FMOD_SPEAKERMODE_STEREO;
+		*speakerModeChannels = 2;
+		*outputFormat = FMOD_SOUND_FORMAT_PCMFLOAT;
+		return FMOD_OK;
+	}
+
+	FMOD_RESULT F_CALL SDLOutputStart(FMOD_OUTPUT_STATE* outputState) {
+		SDLOutputData* data = static_cast<SDLOutputData*>(outputState->plugindata);
+		SDL_AudioSpec spec = {SDL_AUDIO_F32, 2, data->rate};
+		data->stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, SDLOutputFeed, outputState);
+		if (!data->stream) {
+			return FMOD_ERR_OUTPUT_INIT;
+		}
+		SDL_ResumeAudioStreamDevice(data->stream);
+		return FMOD_OK;
+	}
+
+	FMOD_RESULT F_CALL SDLOutputStop(FMOD_OUTPUT_STATE* outputState) {
+		SDLOutputData* data = static_cast<SDLOutputData*>(outputState->plugindata);
+		if (data && data->stream) {
+			SDL_DestroyAudioStream(data->stream);
+			data->stream = nullptr;
+		}
+		return FMOD_OK;
+	}
+
+	FMOD_RESULT F_CALL SDLOutputClose(FMOD_OUTPUT_STATE* outputState) {
+		SDLOutputStop(outputState);
+		delete static_cast<SDLOutputData*>(outputState->plugindata);
+		outputState->plugindata = nullptr;
+		SDL_QuitSubSystem(SDL_INIT_AUDIO);
+		return FMOD_OK;
+	}
+
+	const FMOD_OUTPUT_DESCRIPTION c_SDLOutputDescription = {FMOD_OUTPUT_PLUGIN_VERSION, "SDL", 1, FMOD_OUTPUT_METHOD_MIX_DIRECT, SDLOutputGetNumDrivers, SDLOutputGetDriverInfo, SDLOutputInit, SDLOutputStart, SDLOutputStop, SDLOutputClose};
+} // namespace
+#endif
