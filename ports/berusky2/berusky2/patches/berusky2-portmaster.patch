diff --git a/src/tmp/compat.cpp b/src/tmp/compat.cpp
index 6ee5146..a8fbc3e 100644
--- a/src/tmp/compat.cpp
+++ b/src/tmp/compat.cpp
@@ -628,7 +628,20 @@ int WideCharToMultiByte(int CodePage, int dwFlags, wchar_t * lpWideCharStr,
 
 void ShowCursor(bool state)
 {
+#ifdef PORTMASTER
+  // sdl12-compat turns a hidden cursor in fullscreen into relative mouse mode, which
+  // loses the pointer at the screen edges under sway; hide it with a blank shape instead
+  static SDL_Cursor *blank, *normal;
+  static Uint8 zero[4];
+  if (!blank) {
+    normal = SDL_GetCursor();
+    blank = SDL_CreateCursor(zero, zero, 8, 4, 0, 0);
+  }
+  SDL_ShowCursor(SDL_ENABLE);
+  SDL_SetCursor(state || !blank ? normal : blank);
+#else
   SDL_ShowCursor(state ? SDL_ENABLE : SDL_DISABLE);
+#endif
 }
 
 void SetCursor(void *tmp)
