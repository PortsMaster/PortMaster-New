diff --git a/src/age/include/opengl.h b/src/age/include/opengl.h
index aac261e..0db2058 100644
--- a/src/age/include/opengl.h
+++ b/src/age/include/opengl.h
@@ -32,7 +32,45 @@
 
 #ifdef LINUX
   #include <GL/glu.h>
+#ifndef PORTMASTER
   #include <GL/glx.h>
+#endif
 #endif // LINUX
 
+#ifdef PORTMASTER
+#include <stdlib.h>
+#include <string.h>
+
+// GLU is the only user of libOpenGL.so.0 (GLVND), which gl4es does not provide.
+static inline GLint pm_gluBuild1DMipmaps(GLenum target, GLint internal_format,
+                                         GLsizei width, GLenum format,
+                                         GLenum type, const void *data)
+{
+  if (format != GL_RGBA || type != GL_UNSIGNED_BYTE || width <= 0 || !data)
+    return GL_INVALID_ENUM;
+
+  unsigned char *level = (unsigned char *) malloc(width * 4);
+  if (!level)
+    return GL_OUT_OF_MEMORY;
+  memcpy(level, data, width * 4);
+
+  GLint i = 0;
+  glTexImage1D(target, i, internal_format, width, 0, format, type, level);
+  while (width > 1) {
+    GLsizei next = width / 2;
+    for (GLsizei x = 0; x < next; x++) {
+      for (int c = 0; c < 4; c++) {
+        level[x * 4 + c] = (level[x * 8 + c] + level[x * 8 + 4 + c] + 1) / 2;
+      }
+    }
+    width = next;
+    glTexImage1D(target, ++i, internal_format, width, 0, format, type, level);
+  }
+
+  free(level);
+  return 0;
+}
+#define gluBuild1DMipmaps pm_gluBuild1DMipmaps
+#endif // PORTMASTER
+
 #endif //__OPENGL_H__
