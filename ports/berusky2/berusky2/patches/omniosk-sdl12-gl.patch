+/* OMNI_PAD=1: for games that read the gamepad natively. The left trigger
+ * toggles the overlay, and while it is open the d-pad and face buttons drive
+ * it through the configured keys. Every controller/joystick event is
+ * swallowed while open, so the game doesn't act on the same presses. */
+enum { OMNI_PAD_PASS, OMNI_PAD_SWALLOW, OMNI_PAD_KEY };
+
+static SDL_Keycode pad_button_key(const OmniConfig *config, int button)
+{
+    switch (button) {
+        case SDL_CONTROLLER_BUTTON_DPAD_UP: return config->up_key;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return config->down_key;
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return config->left_key;
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return config->right_key;
+        case SDL_CONTROLLER_BUTTON_A: return config->confirm_key;
+        case SDL_CONTROLLER_BUTTON_B: return config->backspace_key;
+        case SDL_CONTROLLER_BUTTON_Y: return config->charset_key;
+        case SDL_CONTROLLER_BUTTON_X: return config->shift_key;
+        default: return SDLK_UNKNOWN;
+    }
+}
+
+static void pad_synth_key(SDL_Event *out, SDL_Keycode key, int down)
+{
+    memset(out, 0, sizeof(*out));
+    out->type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    out->key.type = out->type;
+    out->key.timestamp = SDL_GetTicks();
+    out->key.state = down ? SDL_PRESSED : SDL_RELEASED;
+    out->key.keysym.sym = key;
+    out->key.keysym.scancode = SDL_GetScancodeFromKey(key);
+}
+
+static int pad_translate(OmniRuntime *runtime, const SDL_Event *event, SDL_Event *out)
+{
+    const OmniConfig *config = &runtime->config;
+    int active = runtime->model.active;
+    switch (event->type) {
+        case SDL_CONTROLLERAXISMOTION:
+            if (event->caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT) {
+                int down = runtime->pad_trigger_down ? event->caxis.value > 8000 : event->caxis.value > 16000;
+                if (down == runtime->pad_trigger_down) {
+                    return OMNI_PAD_SWALLOW;
+                }
+                runtime->pad_trigger_down = down;
+                pad_synth_key(out, config->toggle_key, down);
+                return OMNI_PAD_KEY;
+            }
+            return active ? OMNI_PAD_SWALLOW : OMNI_PAD_PASS;
+        case SDL_CONTROLLERBUTTONDOWN:
+        case SDL_CONTROLLERBUTTONUP: {
+            int button = event->cbutton.button;
+            int down = event->type == SDL_CONTROLLERBUTTONDOWN;
+            SDL_Keycode key;
+            if (button < 0 || button >= SDL_CONTROLLER_BUTTON_MAX) {
+                return active ? OMNI_PAD_SWALLOW : OMNI_PAD_PASS;
+            }
+            if (down) {
+                if (!active) {
+                    return OMNI_PAD_PASS;
+                }
+                runtime->pad_held[button] = 1;
+            } else {
+                if (!runtime->pad_held[button]) {
+                    /* pressed before the overlay opened: the game saw the press, let it see the release */
+                    return OMNI_PAD_PASS;
+                }
+                runtime->pad_held[button] = 0;
+                if (!active) {
+                    return OMNI_PAD_SWALLOW;
+                }
+            }
+            key = pad_button_key(config, button);
+            if (key == SDLK_UNKNOWN) {
+                return OMNI_PAD_SWALLOW;
+            }
+            pad_synth_key(out, key, down);
+            return OMNI_PAD_KEY;
+        }
+        case SDL_JOYAXISMOTION:
+        case SDL_JOYBALLMOTION:
+        case SDL_JOYHATMOTION:
+        case SDL_JOYBUTTONDOWN:
+        case SDL_JOYBUTTONUP:
+            return active ? OMNI_PAD_SWALLOW : OMNI_PAD_PASS;
+        default:
+            return OMNI_PAD_PASS;
+    }
+}
