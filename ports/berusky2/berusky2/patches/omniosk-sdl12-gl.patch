+int omni_generated_key_char(SDL_Keycode key, SDL_Keymod mod)
+{
+    int shifted = (mod & KMOD_SHIFT) != 0;
+    int character;
+    if (key == SDLK_BACKSPACE || key == SDLK_RETURN) {
+        return (int)key;
+    }
+    for (character = ' '; character <= '~'; ++character) {
+        SDL_Keycode candidate;
+        SDL_Keymod candidate_mod;
+        if (ascii_key((char)character, &candidate, &candidate_mod) && candidate == key &&
+            ((candidate_mod & KMOD_SHIFT) != 0) == shifted) {
+            return character;
+        }
+    }
+    return 0;
+}
