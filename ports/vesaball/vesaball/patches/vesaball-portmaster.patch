diff --git a/Sound.cpp b/Sound.cpp
new file mode 100644
index 0000000..c164685
--- /dev/null
+++ b/Sound.cpp
@@ -0,0 +1,77 @@
+#include "StdAfx.h"
+#include "Sound.h"
+
+const int MUSIC_VOLUME = MIX_MAX_VOLUME / 2;
+
+bool CSound::sbOpen = false;
+Mix_Music* CSound::spMusic = NULL;
+Mix_Chunk* CSound::spEffects[MAX_EFFECT];
+
+void CSound::Init()
+{
+	if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0)
+	{
+		SDL_Log("Audio unavailable: %s", SDL_GetError());
+		return;
+	}
+
+	if (Mix_OpenAudio(44100, MIX_DEFAULT_FORMAT, 2, 1024) != 0)
+	{
+		SDL_Log("Mix_OpenAudio failed: %s", Mix_GetError());
+		SDL_QuitSubSystem(SDL_INIT_AUDIO);
+		return;
+	}
+	sbOpen = true;
+
+	const char* strEffectFiles[MAX_EFFECT] = {
+		"snd/brick.wav",
+		"snd/brick_metal.wav",
+		"snd/paddle.wav",
+	};
+	for (int i = 0; i < MAX_EFFECT; i++)
+	{
+		spEffects[i] = Mix_LoadWAV(strEffectFiles[i]);
+		if (!spEffects[i])
+			SDL_Log("Could not load %s: %s", strEffectFiles[i], Mix_GetError());
+	}
+
+	spMusic = Mix_LoadMUS("snd/music.ogg");
+	if (spMusic)
+	{
+		Mix_VolumeMusic(MUSIC_VOLUME);
+		Mix_PlayMusic(spMusic, -1);
+	}
+	else
+		SDL_Log("Could not load snd/music.ogg: %s", Mix_GetError());
+}
+
+void CSound::Shutdown()
+{
+	if (!sbOpen)
+		return;
+
+	Mix_HaltMusic();
+	Mix_HaltChannel(-1);
+
+	if (spMusic)
+	{
+		Mix_FreeMusic(spMusic);
+		spMusic = NULL;
+	}
+	for (int i = 0; i < MAX_EFFECT; i++)
+		if (spEffects[i])
+		{
+			Mix_FreeChunk(spEffects[i]);
+			spEffects[i] = NULL;
+		}
+
+	Mix_CloseAudio();
+	SDL_QuitSubSystem(SDL_INIT_AUDIO);
+	sbOpen = false;
+}
+
+void CSound::Play(EffectEnum Effect)
+{
+	if (spEffects[Effect])
+		Mix_PlayChannel(-1, spEffects[Effect], 0);
+}
diff --git a/Sound.h b/Sound.h
new file mode 100644
index 0000000..9024975
--- /dev/null
+++ b/Sound.h
@@ -0,0 +1,39 @@
+#ifndef SOUND_H
+#define SOUND_H
+
+#include <SDL_mixer.h>
+
+//! Music and sound effects
+/*!
+	Plays the looping background music and the short collision sound
+	effects. Sound is optional: if the audio device or a file can't be
+	opened, the game keeps running silently.
+*/
+class CSound
+{
+public:
+	//! Sound effects
+	enum EffectEnum
+	{
+		Brick,		//!< A brick is destroyed
+		BrickMetal, //!< A brick is hit but not destroyed
+		Paddle,		//!< The ball hits the paddle
+		MAX_EFFECT
+	};
+
+	//! Opens the audio device, loads the sounds and starts the music
+	static void Init();
+
+	//! Stops playback and releases the sounds
+	static void Shutdown();
+
+	//! Plays a sound effect
+	static void Play(EffectEnum Effect);
+
+private:
+	static bool sbOpen;
+	static Mix_Music* spMusic;
+	static Mix_Chunk* spEffects[MAX_EFFECT];
+};
+
+#endif
