+        // A GLX layer that reports no visual as double-buffered (e.g. Crusty 0.4 under
+        // Westonpack) would leave a null visual, which X rejects: use the default one
+        if (!bestVisual.visual)
+        {
+            const VisualID defaultId = XVisualIDFromVisual(DefaultVisual(display, screen));
+            for (std::size_t i = 0; i < static_cast<std::size_t>(count); ++i)
+            {
+                if (visuals[i].screen == screen && visuals[i].visualid == defaultId)
+                {
+                    err() << "No double-buffered GLX visual reported, using the default visual" << std::endl;
+                    bestVisual = visuals[i];
+                    break;
+                }
+            }
+        }
+
         return bestVisual;
     }
 
