#!/bin/bash
# SPDX-License-Identifier: MIT
# Bridge the existing setup process to PortMaster's standard patch screen.
gamedir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
export gamedir
cd "$gamedir/gamedata" || exit 1
rm -f .setup_screen_done
echo "Scott Pilgrim EX: Checking files and preparing the game."
bash "$gamedir/repack.src" 2>&1 | tee "$gamedir/repack.log"
results=("${PIPESTATUS[@]}")
if [ "${results[0]}" -eq 0 ] && [ "${results[1]}" -eq 0 ] &&
   [ -f .patch_done ] && [ -f .astc_done ] && [ -f .intro_done ]; then
    touch .setup_screen_done || exit 1
    echo "Patching process complete!"
else
    echo "PATCH_FAIL_MSG:Setup did not finish. See scottpilgrimex/repack.log, fix the reported error and launch again."
    echo "Patching process failed!"
    exit 1
fi
