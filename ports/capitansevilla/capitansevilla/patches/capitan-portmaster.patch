+#ifdef PORTMASTER
+/* Fast 16 bpp versions of the Allegro 4 sprite blends the game uses every frame.
+   Each one reproduces the matching Allegro blender exactly, without its per-pixel
+   function pointer call. */
+
+#include <allegro.h>
+#include <stdint.h>
+#include <arm_neon.h>
+#include "pmblit.h"
+
+#define PM_MASK16 0xF81F
+
+static bool PMClip (BITMAP *Dst, BITMAP *Src, int &x, int &y, int &sx, int &sy, int &w, int &h)
+{
+    int cl = 0, ct = 0, cr = Dst->w, cb = Dst->h;
+
+    if (Dst->clip) {
+       cl = Dst->cl; ct = Dst->ct; cr = Dst->cr; cb = Dst->cb;
+       }
+    sx = 0; sy = 0; w = Src->w; h = Src->h;
+    if (x < cl) { sx = cl - x; w -= sx; x = cl; }
+    if (y < ct) { sy = ct - y; h -= sy; y = ct; }
+    if (x + w > cr) w = cr - x;
+    if (y + h > cb) h = cb - y;
+    return w > 0 && h > 0;
+}
+
+static bool PMIs16 (BITMAP *Bmp)
+{
+    return Bmp && is_memory_bitmap (Bmp) && bitmap_color_depth (Bmp) == 16;
+}
+
+static inline uint16_t PMTrans (unsigned long x, unsigned long y, unsigned long n)
+{
+    unsigned long result;
+
+    x = ((x & 0xFFFF) | (x << 16)) & 0x7E0F81F;
+    y = ((y & 0xFFFF) | (y << 16)) & 0x7E0F81F;
+    result = ((x - y) * n / 32 + y) & 0x7E0F81F;
+    return (uint16_t) ((result & 0xFFFF) | (result >> 16));
+}
+
+/* Same result as PMTrans for n <= 32, one channel at a time so it vectorizes. */
+static inline uint16_t PMTransCh (int x, int y, int n)
+{
+    int xb = x & 0x1F, xg = (x >> 5) & 0x3F, xr = x >> 11;
+    int yb = y & 0x1F, yg = (y >> 5) & 0x3F, yr = y >> 11;
+
+    yb += ((xb - yb) * n) >> 5;
+    yg += ((xg - yg) * n) >> 5;
+    yr += ((xr - yr) * n) >> 5;
+    return (uint16_t) ((yr << 11) | (yg << 5) | yb);
+}
+
+static unsigned long PMTransN (int Alpha)
+{
+    unsigned long n = (unsigned long) (long) Alpha;
+
+    if (n)
+       n = (n + 1) / 8;
+    return n;
+}
+
+bool PMTransSprite16 (BITMAP *Dst, BITMAP *Src, int x, int y, int Alpha)
+{
+    int sx, sy, w, h;
+    unsigned long n;
+
+    if (!PMIs16 (Dst) || !PMIs16 (Src))
+       return false;
+    if (!PMClip (Dst, Src, x, y, sx, sy, w, h))
+       return true;
+
+    n = PMTransN (Alpha);
+    if (n == 0)
+       return true;
+    for (int j = 0; j < h; j++) {
+        const uint16_t *s = (const uint16_t*) Src->line[sy + j] + sx;
+        uint16_t *d = (uint16_t*) Dst->line[y + j] + x;
+        if (n <= 32) {
+           int nn = (int) n;
+           for (int i = 0; i < w; i++) {
+               uint16_t c = s[i], o = d[i];
+               uint16_t b = PMTransCh (c, o, nn);
+               d[i] = (c == PM_MASK16) ? o : b;
+               }
+           }
+         else
+           for (int i = 0; i < w; i++) {
+               uint16_t c = s[i];
+               if (c != PM_MASK16)
+                  d[i] = PMTrans (c, d[i], n);
+               }
+        }
+    return true;
+}
+
+bool PMTransRect16 (BITMAP *Dst, int x1, int y1, int x2, int y2, int Color, int Alpha, int Step)
+{
+    int cl = 0, ct = 0, cr = Dst->w, cb = Dst->h;
+    unsigned long n;
+
+    if (!PMIs16 (Dst))
+       return false;
+    if (x2 < x1) { int t = x1; x1 = x2; x2 = t; }
+    if (y2 < y1) { int t = y1; y1 = y2; y2 = t; }
+    if (Dst->clip) {
+       cl = Dst->cl; ct = Dst->ct; cr = Dst->cr; cb = Dst->cb;
+       }
+    if (x1 < cl) x1 = cl;
+    if (y1 < ct) y1 += ((ct - y1 + Step - 1) / Step) * Step;
+    if (x2 >= cr) x2 = cr - 1;
+    if (y2 >= cb) y2 = cb - 1;
+    if (x2 < x1 || y2 < y1)
+       return true;
+
+    n = PMTransN (Alpha);
+    if (n == 0)
+       return true;
+    for (int j = y1; j <= y2; j += Step) {
+        uint16_t *d = (uint16_t*) Dst->line[j];
+        if (n <= 32 && Color >= 0 && Color <= 0xFFFF) {
+           int nn = (int) n;
+           for (int i = x1; i <= x2; i++)
+               d[i] = PMTransCh (Color, d[i], nn);
+           }
+         else
+           for (int i = x1; i <= x2; i++)
+               d[i] = PMTrans ((unsigned long) (long) Color, d[i], n);
+        }
+    return true;
+}
+
+bool PMAddSprite16 (BITMAP *Dst, BITMAP *Src, int x, int y, int Amount)
+{
+    int sx, sy, w, h;
+    unsigned long n = (unsigned long) (long) Amount;
+    int Add5[32], Add6[64];
+    int rs = _rgb_r_shift_16, gs = _rgb_g_shift_16, bs = _rgb_b_shift_16;
+
+    if (!PMIs16 (Dst) || !PMIs16 (Src))
+       return false;
+    if (!PMClip (Dst, Src, x, y, sx, sy, w, h))
+       return true;
+
+    for (int i = 0; i < 32; i++)
+        Add5[i] = (int) (_rgb_scale_5[i] * n / 256);
+    for (int i = 0; i < 64; i++)
+        Add6[i] = (int) (_rgb_scale_6[i] * n / 256);
+
+    /* NEON path: the 5 bit fields at bits 0 and 11 use the same tables whichever
+       of them is red, so it only needs green at bit 5. Every table entry fits a
+       byte when 0 <= n <= 256, and a saturating byte add is the MIN (x, 255). */
+    bool Neon = gs == 5 && ((rs == 0 && bs == 11) || (rs == 11 && bs == 0)) && (long) n >= 0 && n <= 256;
+    uint8_t S5[32], S6[64], A5[32], A6[64];
+    uint8x16x2_t TS5, TA5;
+    uint8x16x4_t TS6, TA6;
+    if (Neon) {
+       for (int i = 0; i < 32; i++) { S5[i] = (uint8_t) _rgb_scale_5[i]; A5[i] = (uint8_t) Add5[i]; }
+       for (int i = 0; i < 64; i++) { S6[i] = (uint8_t) _rgb_scale_6[i]; A6[i] = (uint8_t) Add6[i]; }
+       TS5 = vld1q_u8_x2 (S5); TA5 = vld1q_u8_x2 (A5);
+       TS6 = vld1q_u8_x4 (S6); TA6 = vld1q_u8_x4 (A6);
+       }
+
+    for (int j = 0; j < h; j++) {
+        const uint16_t *s = (const uint16_t*) Src->line[sy + j] + sx;
+        uint16_t *d = (uint16_t*) Dst->line[y + j] + x;
+        int i = 0;
+        if (Neon)
+           for (; i + 16 <= w; i += 16) {
+               uint16x8_t c0 = vld1q_u16 (s + i), c1 = vld1q_u16 (s + i + 8);
+               uint16x8_t o0 = vld1q_u16 (d + i), o1 = vld1q_u16 (d + i + 8);
+               uint16x8_t m0 = vceqq_u16 (c0, vdupq_n_u16 (PM_MASK16));
+               uint16x8_t m1 = vceqq_u16 (c1, vdupq_n_u16 (PM_MASK16));
+               if (vmaxvq_u16 (vandq_u16 (m0, m1)) == 0xFFFF && vminvq_u16 (vandq_u16 (m0, m1)) == 0xFFFF)
+                  continue;
+               uint8x16_t cl5 = vcombine_u8 (vmovn_u16 (vandq_u16 (c0, vdupq_n_u16 (0x1F))), vmovn_u16 (vandq_u16 (c1, vdupq_n_u16 (0x1F))));
+               uint8x16_t ch5 = vcombine_u8 (vmovn_u16 (vshrq_n_u16 (c0, 11)), vmovn_u16 (vshrq_n_u16 (c1, 11)));
+               uint8x16_t cg6 = vcombine_u8 (vmovn_u16 (vandq_u16 (vshrq_n_u16 (c0, 5), vdupq_n_u16 (0x3F))), vmovn_u16 (vandq_u16 (vshrq_n_u16 (c1, 5), vdupq_n_u16 (0x3F))));
+               uint8x16_t ol5 = vcombine_u8 (vmovn_u16 (vandq_u16 (o0, vdupq_n_u16 (0x1F))), vmovn_u16 (vandq_u16 (o1, vdupq_n_u16 (0x1F))));
+               uint8x16_t oh5 = vcombine_u8 (vmovn_u16 (vshrq_n_u16 (o0, 11)), vmovn_u16 (vshrq_n_u16 (o1, 11)));
+               uint8x16_t og6 = vcombine_u8 (vmovn_u16 (vandq_u16 (vshrq_n_u16 (o0, 5), vdupq_n_u16 (0x3F))), vmovn_u16 (vandq_u16 (vshrq_n_u16 (o1, 5), vdupq_n_u16 (0x3F))));
+               uint8x16_t rl = vshrq_n_u8 (vqaddq_u8 (vqtbl2q_u8 (TS5, ol5), vqtbl2q_u8 (TA5, cl5)), 3);
+               uint8x16_t rh = vshrq_n_u8 (vqaddq_u8 (vqtbl2q_u8 (TS5, oh5), vqtbl2q_u8 (TA5, ch5)), 3);
+               uint8x16_t rg = vshrq_n_u8 (vqaddq_u8 (vqtbl4q_u8 (TS6, og6), vqtbl4q_u8 (TA6, cg6)), 2);
+               uint16x8_t r0 = vorrq_u16 (vorrq_u16 (vmovl_u8 (vget_low_u8 (rl)), vshlq_n_u16 (vmovl_u8 (vget_low_u8 (rg)), 5)), vshlq_n_u16 (vmovl_u8 (vget_low_u8 (rh)), 11));
+               uint16x8_t r1 = vorrq_u16 (vorrq_u16 (vmovl_u8 (vget_high_u8 (rl)), vshlq_n_u16 (vmovl_u8 (vget_high_u8 (rg)), 5)), vshlq_n_u16 (vmovl_u8 (vget_high_u8 (rh)), 11));
+               vst1q_u16 (d + i, vbslq_u16 (m0, o0, r0));
+               vst1q_u16 (d + i + 8, vbslq_u16 (m1, o1, r1));
+               }
+        for (; i < w; i++) {
+            unsigned c = s[i], o;
+            int r, g, b;
+            if (c == PM_MASK16)
+               continue;
+            o = d[i];
+            r = _rgb_scale_5[(o >> rs) & 0x1F] + Add5[(c >> rs) & 0x1F];
+            g = _rgb_scale_6[(o >> gs) & 0x3F] + Add6[(c >> gs) & 0x3F];
+            b = _rgb_scale_5[(o >> bs) & 0x1F] + Add5[(c >> bs) & 0x1F];
+            if (r > 255) r = 255;
+            if (g > 255) g = 255;
+            if (b > 255) b = 255;
+            d[i] = (uint16_t) (((r >> 3) << rs) | ((g >> 2) << gs) | ((b >> 3) << bs));
+            }
+        }
+    return true;
+}
+
+bool PMBlackSprite16 (BITMAP *Dst, BITMAP *Src, int x, int y)
+{
+    int sx, sy, w, h;
+
+    if (!PMIs16 (Dst) || !PMIs16 (Src))
+       return false;
+    if (!PMClip (Dst, Src, x, y, sx, sy, w, h))
+       return true;
+
+    for (int j = 0; j < h; j++) {
+        const uint16_t *s = (const uint16_t*) Src->line[sy + j] + sx;
+        uint16_t *d = (uint16_t*) Dst->line[y + j] + x;
+        for (int i = 0; i < w; i++)
+            if (s[i] != PM_MASK16)
+               d[i] = 0;
+        }
+    return true;
+}
+bool PMStretch2x16 (BITMAP *Dst, BITMAP *Src, int x, int y)
+{
+    int cl = 0, ct = 0, cr, cb;
+
+    if (!PMIs16 (Dst) || !PMIs16 (Src))
+       return false;
+    cr = Dst->w; cb = Dst->h;
+    if (Dst->clip) {
+       cl = Dst->cl; ct = Dst->ct; cr = Dst->cr; cb = Dst->cb;
+       }
+    int x0 = x < cl ? cl : x, y0 = y < ct ? ct : y;
+    int x1 = x + 2 * Src->w, y1 = y + 2 * Src->h;
+    if (x1 > cr) x1 = cr;
+    if (y1 > cb) y1 = cb;
+    for (int j = y0; j < y1; j++) {
+        const uint16_t *s = (const uint16_t*) Src->line[(j - y) >> 1];
+        uint16_t *d = (uint16_t*) Dst->line[j];
+        int i = x0;
+        if ((i - x) & 1) {
+           uint16_t c = s[(i - x) >> 1];
+           if (c != PM_MASK16)
+              d[i] = c;
+           i++;
+           }
+        for (; i + 16 <= x1; i += 16) {
+            uint16x8_t c = vld1q_u16 (s + ((i - x) >> 1));
+            uint16x8x2_t c2 = vzipq_u16 (c, c);
+            uint16x8_t m0 = vceqq_u16 (c2.val[0], vdupq_n_u16 (PM_MASK16));
+            uint16x8_t m1 = vceqq_u16 (c2.val[1], vdupq_n_u16 (PM_MASK16));
+            vst1q_u16 (d + i, vbslq_u16 (m0, vld1q_u16 (d + i), c2.val[0]));
+            vst1q_u16 (d + i + 8, vbslq_u16 (m1, vld1q_u16 (d + i + 8), c2.val[1]));
+            }
+        for (; i < x1; i++) {
+            uint16_t c = s[(i - x) >> 1];
+            if (c != PM_MASK16)
+               d[i] = c;
+            }
+        }
+    return true;
+}
+#endif
