+
+/* The game draws everything into the A4 memory bitmap "screen". PMPresent copies
+   each finished frame into a triple buffer; a present thread owns the GL context
+   and converts, uploads and flips it while the game draws the next frame. */
+
+enum { PM_COPY_NONE, PM_COPY_565, PM_COPY_565_SWAP, PM_COPY_8888, PM_COPY_8888_SWAP };
+
+static ALLEGRO_BITMAP *PMScreen = NULL;
+static double PMLastFlip = 0;
+
+static ALLEGRO_THREAD *PMThread = NULL;
+static ALLEGRO_MUTEX *PMMutex = NULL;
+static ALLEGRO_COND *PMCond = NULL;
+static unsigned char *PMBuf[3] = { NULL, NULL, NULL };
+static int PMWrite, PMReady, PMRead, PMW, PMH, PMMode, PMBpp;
+static bool PMNewFrame, PMStop, PMStarted, PMThreadOK;
+static SDL_Window *PMWindow = NULL;
+static SDL_GLContext PMContext = NULL;
+static ALLEGRO_EVENT_QUEUE *PMEvents = NULL;
+static bool PMNoThread = false;
+
+static int PMCopyMode ()
+{
+    int Depth = bitmap_color_depth (screen);
+
+    if (Depth == 16 && _rgb_g_shift_16 == 5) {
+       if (_rgb_r_shift_16 == 11 && _rgb_b_shift_16 == 0)
+          return PM_COPY_565;
+       if (_rgb_r_shift_16 == 0 && _rgb_b_shift_16 == 11)
+          return PM_COPY_565_SWAP;
+       }
+    if (Depth == 32 && _rgb_g_shift_32 == 8) {
+       if (_rgb_r_shift_32 == 0 && _rgb_b_shift_32 == 16)
+          return PM_COPY_8888;
+       if (_rgb_r_shift_32 == 16 && _rgb_b_shift_32 == 0)
+          return PM_COPY_8888_SWAP;
+       }
+    return PM_COPY_NONE;
+}
+
+static int PMFormat (int Mode)
+{
+    if (Mode == PM_COPY_565 || Mode == PM_COPY_565_SWAP)
+       return ALLEGRO_PIXEL_FORMAT_RGB_565;
+    if (Mode == PM_COPY_8888 || Mode == PM_COPY_8888_SWAP)
+       return ALLEGRO_PIXEL_FORMAT_ABGR_8888_LE;
+    return ALLEGRO_PIXEL_FORMAT_ANY;
+}
+
+static void PMConvertRow (int Mode, const void *SrcRow, void *DstRow, int w)
+{
+    const uint32_t *Src = (const uint32_t*) SrcRow;
+    uint32_t *Dst = (uint32_t*) DstRow;
+    int n;
+
+    switch (Mode) {
+           case PM_COPY_565:
+                memcpy (Dst, Src, w * 2);
+                break;
+           case PM_COPY_565_SWAP:
+                for (n = 0; n < w / 2; n++) {
+                    uint32_t c = Src[n];
+                    Dst[n] = ((c & 0x001F001Fu) << 11) | (c & 0x07E007E0u) | ((c >> 11) & 0x001F001Fu);
+                    }
+                break;
+           case PM_COPY_8888:
+                for (n = 0; n < w; n++)
+                    Dst[n] = Src[n] | 0xFF000000u;
+                break;
+           case PM_COPY_8888_SWAP:
+                for (n = 0; n < w; n++) {
+                    uint32_t c = Src[n];
+                    Dst[n] = 0xFF000000u | ((c & 0xFF) << 16) | (c & 0xFF00) | ((c >> 16) & 0xFF);
+                    }
+                break;
+           }
+}
+
+static void PMDisplayEvents ()
+{
+    ALLEGRO_EVENT Event;
+
+    if (!PMEvents)
+       return;
+    while (al_get_next_event (PMEvents, &Event)) {
+          switch (Event.type) {
+                 case ALLEGRO_EVENT_DISPLAY_RESIZE:
+                      al_acknowledge_resize (Event.display.source);
+                      break;
+                 case ALLEGRO_EVENT_DISPLAY_HALT_DRAWING:
+                      al_acknowledge_drawing_halt (Event.display.source);
+                      break;
+                 case ALLEGRO_EVENT_DISPLAY_RESUME_DRAWING:
+                      al_acknowledge_drawing_resume (Event.display.source);
+                      break;
+                 }
+          }
+}
+
+static void PMDraw (ALLEGRO_DISPLAY *Disp)
+{
+    ALLEGRO_TRANSFORM Trans;
+    int OffX, OffY;
+    double Scale;
+
+    al_set_target_backbuffer (Disp);
+    Scale = al_get_display_width (Disp) / (double) al_get_bitmap_width (PMScreen);
+    if (al_get_display_height (Disp) / (double) al_get_bitmap_height (PMScreen) < Scale)
+       Scale = al_get_display_height (Disp) / (double) al_get_bitmap_height (PMScreen);
+    OffX = (int) ((al_get_display_width (Disp) - al_get_bitmap_width (PMScreen) * Scale) / 2);
+    OffY = (int) ((al_get_display_height (Disp) - al_get_bitmap_height (PMScreen) * Scale) / 2);
+    al_build_transform (&Trans, OffX, OffY, Scale, Scale, 0);
+    al_use_transform (&Trans);
+    al_clear_to_color (al_map_rgb (0, 0, 0));
+    al_draw_bitmap (PMScreen, 0, 0, 0);
+    al_flip_display();
+}
+
+static void *PMPresentThread (ALLEGRO_THREAD *Thread, void *Arg)
+{
+    ALLEGRO_DISPLAY *Disp = (ALLEGRO_DISPLAY*) Arg;
+
+    SDL_GL_MakeCurrent (PMWindow, PMContext);
+    al_set_target_backbuffer (Disp);
+    al_set_new_bitmap_flags (ALLEGRO_VIDEO_BITMAP | ALLEGRO_NO_PRESERVE_TEXTURE);
+    al_set_new_bitmap_format (PMFormat (PMMode));
+    PMScreen = al_create_bitmap (PMW, PMH);
+
+    al_lock_mutex (PMMutex);
+    PMThreadOK = PMScreen && al_get_bitmap_format (PMScreen) == PMFormat (PMMode);
+    PMStarted = true;
+    al_broadcast_cond (PMCond);
+    al_unlock_mutex (PMMutex);
+
+    while (PMThreadOK) {
+        al_lock_mutex (PMMutex);
+        while (!PMNewFrame && !PMStop)
+              al_wait_cond (PMCond, PMMutex);
+        if (PMStop) {
+           al_unlock_mutex (PMMutex);
+           break;
+           }
+        int t = PMRead; PMRead = PMReady; PMReady = t;
+        PMNewFrame = false;
+        al_unlock_mutex (PMMutex);
+
+        PMDisplayEvents();
+
+        ALLEGRO_LOCKED_REGION *Lock = al_lock_bitmap (PMScreen, PMFormat (PMMode), ALLEGRO_LOCK_WRITEONLY);
+        if (Lock) {
+           for (int y = 0; y < PMH; y++)
+               PMConvertRow (PMMode, PMBuf[PMRead] + y * PMW * PMBpp, (char*) Lock->data + y * Lock->pitch, PMW);
+           al_unlock_bitmap (PMScreen);
+           }
+        PMDraw (Disp);
+        }
+
+    if (PMScreen)
+       al_destroy_bitmap (PMScreen);
+    PMScreen = NULL;
+    SDL_GL_MakeCurrent (PMWindow, NULL);
+    return NULL;
+}
+
+static void PMStopThread ()
+{
+    if (!PMThread)
+       return;
+    al_lock_mutex (PMMutex);
+    PMStop = true;
+    al_broadcast_cond (PMCond);
+    al_unlock_mutex (PMMutex);
+    al_join_thread (PMThread, NULL);
+    al_destroy_thread (PMThread);
+    PMThread = NULL;
+    SDL_GL_MakeCurrent (PMWindow, PMContext);
+}
+
+static bool PMStartThread (ALLEGRO_DISPLAY *Disp, int Mode)
+{
+    if (!PMMutex) {
+       PMMutex = al_create_mutex();
+       PMCond = al_create_cond();
+       }
+    PMW = screen->w;
+    PMH = screen->h;
+    PMMode = Mode;
+    PMBpp = bitmap_color_depth (screen) == 16 ? 2 : 4;
+    for (int n = 0; n < 3; n++) {
+        free (PMBuf[n]);
+        PMBuf[n] = (unsigned char*) malloc (PMW * PMH * PMBpp);
+        if (!PMBuf[n])
+           return false;
+        }
+    PMWrite = 0; PMReady = 1; PMRead = 2;
+    PMNewFrame = PMStop = PMStarted = PMThreadOK = false;
+
+    PMWindow = SDL_GL_GetCurrentWindow();
+    PMContext = SDL_GL_GetCurrentContext();
+    if (!PMWindow || !PMContext)
+       return false;
+    SDL_GL_MakeCurrent (PMWindow, NULL);
+
+    PMThread = al_create_thread (PMPresentThread, Disp);
+    if (!PMThread) {
+       SDL_GL_MakeCurrent (PMWindow, PMContext);
+       return false;
+       }
+    al_start_thread (PMThread);
+    al_lock_mutex (PMMutex);
+    while (!PMStarted)
+          al_wait_cond (PMCond, PMMutex);
+    al_unlock_mutex (PMMutex);
+    if (!PMThreadOK) {
+       PMStopThread();
+       return false;
+       }
+    return true;
+}
+
+void PMDestroyScreen ()
+{
+    PMStopThread();
+    if (PMScreen)
+       al_destroy_bitmap (PMScreen);
+    PMScreen = NULL;
+}
+
+static void PMPresentSync (ALLEGRO_DISPLAY *Disp, int Mode)
+{
+    ALLEGRO_LOCKED_REGION *Lock = NULL;
+
+    PMDisplayEvents();
+    if (!PMScreen) {
+       al_set_new_bitmap_flags (ALLEGRO_VIDEO_BITMAP | ALLEGRO_NO_PRESERVE_TEXTURE);
+       al_set_new_bitmap_format (PMFormat (Mode));
+       PMScreen = al_create_bitmap (screen->w, screen->h);
+       if (!PMScreen)
+          return;
+       }
+    if (Mode != PM_COPY_NONE && al_get_bitmap_format (PMScreen) == PMFormat (Mode))
+       Lock = al_lock_bitmap (PMScreen, PMFormat (Mode), ALLEGRO_LOCK_WRITEONLY);
+    if (Lock) {
+       for (int y = 0; y < screen->h; y++)
+           PMConvertRow (Mode, screen->line[y], (char*) Lock->data + y * Lock->pitch, screen->w);
+       al_unlock_bitmap (PMScreen);
+       }
+     else
+       all_render_a5_bitmap (screen, PMScreen);
+    PMDraw (Disp);
+}
+
+void PMPresent ()
+{
+    ALLEGRO_DISPLAY *Disp = all_get_display();
+    int Mode;
+    double Wait;
+
+    if (!Disp || !screen)
+       return;
+
+    Mode = PMCopyMode();
+    if (PMThread && (Mode != PMMode || screen->w != PMW || screen->h != PMH))
+       PMDestroyScreen();
+    if (!PMThread && !PMNoThread && Mode != PM_COPY_NONE && !PMScreen)
+       PMNoThread = !PMStartThread (Disp, Mode);
+
+    if (PMThread) {
+       for (int y = 0; y < PMH; y++)
+           memcpy (PMBuf[PMWrite] + y * PMW * PMBpp, screen->line[y], PMW * PMBpp);
+       al_lock_mutex (PMMutex);
+       int t = PMWrite; PMWrite = PMReady; PMReady = t;
+       PMNewFrame = true;
+       al_signal_cond (PMCond);
+       al_unlock_mutex (PMMutex);
+       }
+     else
+       PMPresentSync (Disp, Mode);
+
+    Wait = PMLastFlip + 1.0 / 60.0 - al_get_time();
+    if (Wait > 0)
+       al_rest (Wait);
+    PMLastFlip = al_get_time();
+}
