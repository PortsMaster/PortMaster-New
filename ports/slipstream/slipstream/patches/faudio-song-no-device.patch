--- a/src/XNA_Song.c
+++ b/src/XNA_Song.c
@@ -183,7 +183,7 @@ static void XNA_SongKill()
 FAUDIOAPI void XNA_SongInit()
 {
 	FAudioCreate(&songAudio, 0, FAUDIO_DEFAULT_PROCESSOR);
-	FAudio_CreateMasteringVoice(
+	if (FAudio_CreateMasteringVoice(
 		songAudio,
