 FAUDIOAPI void XNA_SongQuit()
 {
 	XNA_SongKill();
+	if (songAudio == NULL)
+	{
+		return;
+	}
 	FAudioVoice_DestroyVoice(songMaster);
 	FAudio_Release(songAudio);
 }
