+	if (songAudio == NULL)
+	{
+		return (activeVorbisSong != NULL) ?
+			stb_vorbis_stream_length_in_seconds(activeVorbisSong) :
+			qoaTotalSamplesPerChannel / (float) qoaSampleRate;
