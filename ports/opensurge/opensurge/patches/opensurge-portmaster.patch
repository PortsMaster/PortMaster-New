+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef _NATIVEDIALOG_H
+#define _NATIVEDIALOG_H
+
+#ifndef WANT_NATIVE_DIALOG
+#define WANT_NATIVE_DIALOG 1
+#endif
+
+#if WANT_NATIVE_DIALOG
+
+#include <allegro5/allegro_native_dialog.h>
+
+#else
+
+/* No native dialogs (e.g., Allegro's SDL backend): message boxes behave as if
+   closed right away and file choosers can't be created. Errors are still logged. */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <allegro5/allegro.h>
+
+typedef struct ALLEGRO_FILECHOOSER ALLEGRO_FILECHOOSER;
+
+enum {
+    ALLEGRO_FILECHOOSER_FILE_MUST_EXIST = 1,
+    ALLEGRO_FILECHOOSER_SAVE = 2,
+    ALLEGRO_FILECHOOSER_FOLDER = 4,
+    ALLEGRO_FILECHOOSER_PICTURES = 8,
+    ALLEGRO_FILECHOOSER_SHOW_HIDDEN = 16,
+    ALLEGRO_FILECHOOSER_MULTIPLE = 32
+};
+
+enum {
+    ALLEGRO_MESSAGEBOX_WARN = 1<<0,
+    ALLEGRO_MESSAGEBOX_ERROR = 1<<1,
+    ALLEGRO_MESSAGEBOX_OK_CANCEL = 1<<2,
+    ALLEGRO_MESSAGEBOX_YES_NO = 1<<3,
+    ALLEGRO_MESSAGEBOX_QUESTION = 1<<4
+};
+
+static inline bool al_init_native_dialog_addon(void) { return true; }
+static inline bool al_is_native_dialog_addon_initialized(void) { return true; }
+
+static inline int al_show_native_message_box(ALLEGRO_DISPLAY* display, const char* title, const char* heading, const char* text, const char* buttons, int flags)
+{
+    (void)display; (void)title; (void)heading; (void)text; (void)buttons; (void)flags;
+    return 0;
+}
+
+static inline ALLEGRO_FILECHOOSER* al_create_native_file_dialog(const char* initial_path, const char* title, const char* patterns, int mode)
+{
+    (void)initial_path; (void)title; (void)patterns; (void)mode;
+    return NULL;
+}
+
+static inline bool al_show_native_file_dialog(ALLEGRO_DISPLAY* display, ALLEGRO_FILECHOOSER* dialog) { (void)display; (void)dialog; return false; }
+static inline int al_get_native_file_dialog_count(const ALLEGRO_FILECHOOSER* dialog) { (void)dialog; return 0; }
+static inline const char* al_get_native_file_dialog_path(const ALLEGRO_FILECHOOSER* dialog, size_t index) { (void)dialog; (void)index; return NULL; }
+static inline void al_destroy_native_file_dialog(ALLEGRO_FILECHOOSER* dialog) { (void)dialog; }
+
+typedef struct ALLEGRO_TEXTLOG ALLEGRO_TEXTLOG;
+
+enum {
+    ALLEGRO_TEXTLOG_NO_CLOSE = 1<<0,
+    ALLEGRO_TEXTLOG_MONOSPACE = 1<<1
+};
+
+static inline ALLEGRO_TEXTLOG* al_open_native_text_log(const char* title, int flags) { (void)title; (void)flags; return NULL; }
+static inline void al_close_native_text_log(ALLEGRO_TEXTLOG* textlog) { (void)textlog; }
+static inline void al_append_native_text_log(ALLEGRO_TEXTLOG* textlog, const char* format, ...) { (void)textlog; (void)format; }
+
+#endif
+
+#endif
