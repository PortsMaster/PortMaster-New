index 00000000..2e04f64d
--- /dev/null
+++ b/src/util/nativedialog.h
@@ -0,0 +1,93 @@
+/*
+ * Open Surge Engine
+ * nativedialog.h - Allegro's native dialog addon, or stubs when it's unavailable
+ * Copyright 2008-2026 Alexandre Martins <alemartf(at)gmail.com>
+ * http://opensurge2d.org
