#!/bin/bash
# First-launch setup of the 64-bit build (run by launch64.txt through PortMaster's patcher): as
# setup/patchscript, but for Unity 2017.4.40f1's 64-bit player, whose Android builds are IL2CPP ones.
# The game's own code runs there on Unity's Mono: setup64/mono64/ has the runtime for aarch64, the
# bridge the player loads as libil2cpp.so and Mono's 4.x class libraries, all built from Unity's
# MIT-licensed Mono sources; the player comes from the port's donors. The result goes into arm64/.
# Each step is marked done, so an interrupted setup continues where it stopped.
GD="$GAMEDIR/gamedata"; S="$GAMEDIR/setup"; S64="$GAMEDIR/setup64"; W="$GD/.setup64"
D="$W/Cuphead_Data"; A="$GAMEDIR/arm64"; P="$W/player"; MP="$W/managed"
UNITY=2017.4.40f1
PLAYER_LIBS="$P/Variations/il2cpp/Release/Libs/arm64-v8a"
M64="$S64/mono64"

exec > >(tee -a "$GAMEDIR/patchlog.txt") 2>&1
fail() { echo "PATCH_FAIL_MSG:$1"; echo "Patching process failed!"; exit 1; }
. "$S/cpu.txt"
step() { echo "== $(date +%H:%M:%S) $*"; cpu_state; }   # (setup/cpu.txt: the CPU at each step)
mkdir -p "$W" || fail "Cannot write to ports/cuphead/gamedata."
[ -n "$ASPECT" ] && echo "$ASPECT" > "$GAMEDIR/aspect.txt"                # (the launcher reads them)
[ -n "$RESOLUTION" ] && echo "$RESOLUTION" > "$GAMEDIR/resolution.txt"
[ -n "$BUTTONS" ] && echo "$BUTTONS" > "$GAMEDIR/buttons.txt"
[ -n "$TEXTURE_QUALITY" ] && echo "$TEXTURE_QUALITY" > "$GAMEDIR/texture_quality.txt"   # (setup/dlcscript's too)
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
pm() { "$S/pmu" "$@"; }   # (setup/pmu: the setup's tools, one native program)
. "$S/resume.txt"   # (pm_convert: the conversion run again when the kernel kills it)

# 1. the game's data, from Cuphead.app or the installers (largest first: the game, then the DLC)
if [ ! -f "$W/.step_game" ]; then
  if [ ! -f "$D/globalgamemanagers" ]; then
    # the game's Cuphead.app (Steam: depot_268912/; the DLC's depot, depot_1117851/, has only its bundles)
    APP=; UNPACKED=; for a in "$GD"/Cuphead.app "$GD"/*/Cuphead.app; do [ -f "$a/Contents/Resources/Data/globalgamemanagers" ] && APP=$a && break; done
    PKGS=$(ls -S "$GD"/*.pkg 2>/dev/null)
    if [ -z "$APP" ] && [ -n "$PKGS" ]; then
      [ "$(df -m "$GD" | awk 'NR==2{print $4}')" -gt 12000 ] || fail "The 64-bit setup needs about 12 GB free on the card."
      step "unpacking GOG's installers"
      rm -rf "$W/pkgroot"
      pm macpkg "$W/pkgroot" $PKGS || { [ $? = 3 ] && fail "An installer in gamedata/ is incomplete (a download or copy that stopped early): copy it again (see patchlog.txt)."
        fail "Could not unpack the installers (see patchlog.txt)."; }
      APP=$(find "$W/pkgroot" -maxdepth 4 -type d -name 'Cuphead.app' | head -1); UNPACKED=$PKGS
    fi
    [ -n "$APP" ] || fail "Put Cuphead.app (macOS, from GOG or Steam) or GOG's macOS installers (.pkg) in ports/cuphead/gamedata."
    grep -aqs "2017.4.9f1" "$APP/Contents/Resources/Data/globalgamemanagers" \
      || fail "This Cuphead version is not supported (the port needs the macOS build 1.3.4, GOG's or Steam's)."
    # a copy that stopped early (GOG's installers are checked as they unpack), then Steam's DLC depot
    # (depot_1117851/Cuphead.app beside the game's) merged into the game's bundles
    AB=Contents/Resources/Data/StreamingAssets/AssetBundles; ABS=("$APP/$AB")
    for a in "$GD"/Cuphead.app "$GD"/*/Cuphead.app; do [ "$a" != "$APP" ] && [ -d "$a/$AB" ] && ABS+=("$a/$AB"); done
    pm patch-obb check "$S/dlc_bundles.txt" "${ABS[@]}" || { [ $? = 3 ] && fail "The game's files in gamedata/ are incomplete (a download or copy that stopped early): copy them again (see patchlog.txt)."
      fail "Could not check the game's files (see patchlog.txt)."; }
    for d in "${ABS[@]:1}"; do
      mv -f "$d"/* "$APP/$AB/" || fail "Could not move the DLC's files."
      a=${d%/$AB}; rm -rf "$a"; rmdir "$(dirname "$a")" 2>/dev/null
    done
    cp "$APP/Contents/Resources/"goggame-*.info "$W/" 2>/dev/null   # (the DLC check reads them)
    mv "$APP/Contents/Resources/Data" "$D" || fail "Could not move the game's data."
    # (Steam's DLC check, which the code patch replaces: the DLC's bundles are in the data)
    [ -f "$D/StreamingAssets/AssetBundles/atlas_map_common_dlc" ] && touch "$W/.dlc_files"
    rm -rf "$W/pkgroot" "$APP"; rmdir "$(dirname "$APP")" 2>/dev/null   # (Steam: depot_268912/)
    # the installers, unpacked, are not read again: their space goes to the conversion and packing
    [ -n "$UNPACKED" ] && rm -f $UNPACKED
  fi
  touch "$W/.step_game"
fi

# 2. Unity's 64-bit player 2017.4.40f1, from the port's donors (small games of its own built with
# Unity 2017.4.40f1: the IL2CPP one carries the player, the Mono one the UnityEngine assemblies)
DONOR="$GAMEDIR/donor"
if [ ! -f "$W/.step_player" ]; then
  step "Unity's 64-bit Android player $UNITY"
  rm -rf "$P"
  pm player donor "$UNITY" "$P" --backend il2cpp --abi arm64-v8a --managed \
    --apk "$DONOR/donor-$UNITY-il2cpp-arm64.apk" --apk "$DONOR/donor-$UNITY-mono-armv7.apk" \
    || fail "Could not unpack Unity's player from the donors (see patchlog.txt)."
  echo "70e113ef3db212451f69881194381cdbe742720e52125216b7b46bc5bd2b6e22  $PLAYER_LIBS/libmain.so
79eddea99a16ceeac6d590df318baba769a1d00aaa10f7858d45e82bd28096db  $PLAYER_LIBS/libunity.so" | sha256sum -c \
    || fail "Unity's player is not the one this port was made with."
  touch "$W/.step_player"
fi

# 3. conversion (as the 32-bit setup)
Q=$(cat "$W/.texture_quality" 2>/dev/null); Q=${Q:-${TEXTURE_QUALITY:-fast}}
echo "$Q" > "$W/.texture_quality"
if [ ! -f "$W/.step_convert" ]; then
  step "converting the game, texture quality $Q"
  pm_convert "$D" --config "$S/cuphead.json" --plugin animclips --set textures.quality="$Q" --set textures.guide="$S/astc_guide_$Q.bin" \
    || convert_failed $? "Converting the game failed (see patchlog.txt). Launch again to continue."
  touch "$W/.step_convert"
fi

# 4. the game's code with the port's patches, and the port's helper
if [ ! -f "$W/.step_code" ]; then
  step "patching the game's code"
  chmod +x "$S/codepatch"
  rm -rf "$MP.tmp"
  "$S/codepatch" --target=android $([ -f "$W/.dlc_files" ] && echo --steam-dlc) "$D/Managed" "$MP.tmp" && cp "$S/CupheadPort.dll" "$MP.tmp/" \
    && rm -rf "$MP" && mv "$MP.tmp" "$MP" || fail "Patching the game's code failed (see patchlog.txt)."
  touch "$W/.step_code"
fi

# 5. the APK the player reads, with the game's assemblies (the patched Assembly-CSharp, the
# helper) and Mono's 4.x class libraries instead of the game's 2.0 ones, with Mono's Linux config
if [ ! -f "$W/.step_package" ]; then
  step "packing the game"
  CL=(); for f in "$M64"/classlibs/*.dll; do CL+=(--managed-file "$f"); done
  RT=(--mono64 --managed-file "$MP/Assembly-CSharp.dll" --managed-file "$MP/CupheadPort.dll" "${CL[@]}"
      --mono-etc "$M64/etc" --dllmap SDL2=libSDL2-2.0.so.0)
  pm android-data --src "$D" --pkg "$P" --out "$W/android" --name Cuphead --package com.cupheadport.game \
    --root-file animclips.txt --drop-missing-assembly GalaxyCSharp.dll "${RT[@]}" --plugin-map "$S64/plugins-il2cpp.json" \
    --consume-src --verify-bundles 2 --pack all --no-video-shader \
    || { [ $? = 4 ] && fail "The card is too full to pack the game: free the space patchlog.txt names, then launch again to continue."
         fail "Packing the game failed (see patchlog.txt). Launch again to continue."; }
  touch "$W/.step_package"
fi

# 6. into arm64/; the 64-bit tools, the work files and the player's copy of the game are removed
# (setup/ stays: it adds the DLC when it comes later, setup/dlcscript)
step "installing"
mkdir -p "$A/lib"
for f in "$PLAYER_LIBS/libmain.so" "$PLAYER_LIBS/libunity.so" "$M64/libil2cpp.so" "$M64/libmonobdwgc-2.0.so" "$M64/libMonoPosixHelper.so"; do
  cp "$f" "$A/lib/" || fail "Could not install Unity's player."
done
[ -d "$W/android/zip/assets" ] && rm -rf "$A/assets"
for f in "$W"/android/zip/*; do mv -f "$f" "$A/" || fail "Could not install $(basename "$f")."; done
[ -f "$W/.dlc_files" ] && touch "$A/cuphead_dlc"
rm -rf "$W" "$S64" "$GD"/*.pkg "$GD"/*.app
touch "$GAMEDIR/.cuphead_ready64"
sync
step "setup finished"
