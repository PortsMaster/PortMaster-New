{
  "steps": [
    "shaders",
    "settings",
    "textures",
    "audio",
    "animclips"
  ],
  "shaders": {
    "precision": "default-samplers",
    "bundles": "^tmpfont_",
    "glcore4x": false,
    "compute": false
  },
  "settings": {
    "graphics_apis": [
      11,
      17
    ],
    "mouse_events": false,
    "trim_joystick_axes": true
  },
  "textures": {
    "scale": 0.375,
    "block": [
      4,
      4
    ],
    "scale_sharp": 0.5,
    "sharp_block": [
      4,
      4
    ],
    "sharp_names": "text|font|glyph|title_card|_loc\\b|achievement",
    "keep_max": 64,
    "min_side": 16,
    "min_convert": 4,
    "quality": "fast",
    "inline_streams": true,
    "mips": "drop",
    "inline": false,
    "files": "^StreamingAssets/AssetBundles/(atlas_|tex_)|^[^/]*\\.assets$"
  },
  "audio": {
    "compressed_min_s": 2.0
  }
}
