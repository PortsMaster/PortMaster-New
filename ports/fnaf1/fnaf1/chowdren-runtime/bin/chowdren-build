#!/bin/sh

GAME_DIR=""
EXE=""
TITLE="Chowdren game"
CONFIG=""
EXTRA_CMAKE=""
NO_LAUNCH=""
while [ $# -gt 0 ]; do
    case "$1" in
        --game-dir)    GAME_DIR="$2"; shift 2 ;;
        --exe)         EXE="$2"; shift 2 ;;
        --title)       TITLE="$2"; shift 2 ;;
        --config)      CONFIG="$2"; shift 2 ;;
        --extra-cmake) EXTRA_CMAKE="$2"; shift 2 ;;
        --no-launch)   NO_LAUNCH="1"; shift ;;
        *) echo "chowdren-build: ignoring unknown arg: $1" >&2; shift ;;
    esac
done

if [ -z "$GAME_DIR" ] || [ -z "$EXE" ]; then
    echo "chowdren-build: --game-dir and --exe are required" >&2
    exit 64
fi

SCRIPT="$(readlink -f "$0")"
RUNTIME="$(dirname "$(dirname "$SCRIPT")")"

GAME_EXE="$GAME_DIR/gamedata/$EXE"
BUILD="$GAME_DIR/build"
BIN="$BUILD/Chowdren"

if [ ! -f "$GAME_EXE" ]; then
    cat >&2 <<EOF

============================================================
$TITLE — game data not found
============================================================

Expected: $GAME_EXE

Place a legally-owned copy of $EXE in:
  $GAME_DIR/gamedata/

Then re-launch. The first launch will take a few minutes to
convert and build the game on this device. Subsequent launches
are instant.
EOF
    exit 1
fi

# --- fast path: cached binary still valid ----------------------------------
if [ -x "$BIN" ] && [ "$BIN" -nt "$GAME_EXE" ]; then
    if [ -n "$NO_LAUNCH" ]; then
        echo "[chowdren-build] cached binary is up to date, nothing to do."
        exit 0
    fi
    cd "$BUILD"
    exec "$BIN" "$@"
fi

PYLIB="$RUNTIME/python27/lib/python2.7"
export PYTHONHOME="$RUNTIME/python27"
export PYTHONPATH="$RUNTIME/chowdren:$RUNTIME/chowdren/Chowdren:$PYLIB/site-packages:$PYLIB/dist-packages"

export PATH="$RUNTIME/python27/bin:$RUNTIME/toolchain/bin:$PATH"
export LD_LIBRARY_PATH="$RUNTIME/toolchain/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export CC="$RUNTIME/toolchain/bin/zcc"
export CXX="$RUNTIME/toolchain/bin/zcxx"

export CMAKE_ROOT="$RUNTIME/toolchain/share/cmake-3.13"

export OPENALSOFTDIR="$RUNTIME/openal"
export SDL2DIR="$RUNTIME/sdl2"

mkdir -p "$BUILD"
echo "[chowdren-build] Step 1/3: converting $EXE to C++ source..."
CONV_ARGS=""
[ -n "$CONFIG" ] && CONV_ARGS="--config $CONFIG"

MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)

if [ -z "$CHOWDREN_WORKERS" ]; then
    if [ "$MEM_KB" -gt 4194304 ]; then    # >4 GB
        CHOWDREN_WORKERS=4
    elif [ "$MEM_KB" -gt 2097152 ]; then  # >2 GB
        CHOWDREN_WORKERS=2
    else                                  # <=2 GB
        CHOWDREN_WORKERS=1
    fi
fi
export CHOWDREN_WORKERS
echo "[chowdren-build]   using $CHOWDREN_WORKERS image worker(s) (override via CHOWDREN_WORKERS)"
cd "$RUNTIME/chowdren/Chowdren"
"$RUNTIME/python27/bin/python2.7" -m chowdren.run $CONV_ARGS "$GAME_EXE" "$BUILD"

PATCH_SCRIPT="$GAME_DIR/patch/apply_source_patches.bash"
if [ -x "$PATCH_SCRIPT" ]; then
    echo "[chowdren-build] Applying game-specific patches..."
    "$PATCH_SCRIPT" "$BUILD"
fi

# --- step 2: cmake configure -----------------------------------------------
echo "[chowdren-build] Step 2/3: configuring native build..."
cd "$BUILD"

rm -f "$BUILD/CMakeCache.txt"
rm -rf "$BUILD/CMakeFiles"

"$RUNTIME/toolchain/bin/cmake" \
    -DUSE_GL=ON \
    -DCMAKE_LIBRARY_ARCHITECTURE=aarch64-linux-gnu \
    -DCMAKE_PREFIX_PATH="$RUNTIME/sdl2;$RUNTIME/openal;/usr" \
    -DCMAKE_FIND_ROOT_PATH=/ \
    -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH \
    -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH \
    -DCMAKE_MAKE_PROGRAM="$RUNTIME/toolchain/bin/make" \
    -DOPENGL_INCLUDE_DIR="$RUNTIME/opengl/include" \
    -DOPENGL_gl_LIBRARY="$GAME_DIR/gl4es.aarch64/libGL.so.1" \
    $EXTRA_CMAKE .

# --- step 3: make ----------------------------------------------------------
echo "[chowdren-build] Step 3/3: compiling (may take several minutes on first launch)..."
NPROC="$(nproc 2>/dev/null || echo 2)"

if [ -z "$CHOWDREN_MAKE_JOBS" ]; then
    if [ "$MEM_KB" -gt 4194304 ]; then     # >4 GB
        MAKE_JOBS="$NPROC"
    elif [ "$MEM_KB" -gt 2097152 ]; then   # >2 GB
        MAKE_JOBS=2
        [ "$NPROC" -lt 2 ] && MAKE_JOBS="$NPROC"
    else                                   # <=2 GB
        MAKE_JOBS=1
    fi
else
    MAKE_JOBS="$CHOWDREN_MAKE_JOBS"
fi
echo "[chowdren-build]   using $MAKE_JOBS compile job(s) (override via CHOWDREN_MAKE_JOBS)"
"$RUNTIME/toolchain/bin/make" -j"$MAKE_JOBS"

if [ -x "$BIN" ]; then
    rm -rf "$BUILD/CMakeFiles" "$BUILD/CMakeCache.txt" \
           "$BUILD/cmake_install.cmake" "$BUILD/Makefile" \
           "$BUILD/image_cache" "$BUILD/cache.dat"
fi

if [ ! -x "$BIN" ]; then
    echo "[chowdren-build] build finished but binary not found at $BIN" >&2
    exit 1
fi
if [ -n "$NO_LAUNCH" ]; then
    echo "[chowdren-build] build complete, not launching (--no-launch)."
    exit 0
fi
echo "[chowdren-build] Launching $TITLE..."
exec "$BIN" "$@"
