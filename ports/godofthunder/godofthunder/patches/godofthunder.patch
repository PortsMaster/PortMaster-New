--- a/src/native/got_platform.h
+++ b/src/native/got_platform.h
@@ -4,9 +4,38 @@
 #include <stdint.h>
 
 /* Video */
+typedef struct {
+    float x, y, width, height;
+} got_viewport_t;
+
+/* Shared by gameplay and the launcher. Fit allows fractional scaling so that
+   displays such as 1920x1080 do not lose height to integer-only scaling. */
+static inline got_viewport_t got_viewport_compute(int screen_width, int screen_height,
+                                                 int content_width, int content_height,
+                                                 int stretch) {
+    got_viewport_t view = {0};
+    float sx, sy, scale;
+    if (screen_width <= 0 || screen_height <= 0 || content_width <= 0 || content_height <= 0)
+        return view;
+    sx = (float)screen_width / content_width;
+    sy = (float)screen_height / content_height;
+    scale = sx < sy ? sx : sy;
+    view.width = stretch ? (float)screen_width : content_width * scale;
+    view.height = stretch ? (float)screen_height : content_height * scale;
+    view.x = (screen_width - view.width) * 0.5f;
+    view.y = (screen_height - view.height) * 0.5f;
+    return view;
+}
+
 void got_platform_video_init(void);
 void got_platform_video_shutdown(void);
 void got_platform_set_split(int on);
+void got_platform_apply_fullscreen(void);
+/* Asset paths are separate from the working directory used for saves/settings. */
+const char *got_platform_data_path(const char *name);
+void got_platform_draw_frame(const uint8_t *rgba, int width, int height,
+                             float x, float y, float output_width, float output_height);
+void got_platform_scaler_shutdown(void);
 
 /* Called by the renderer to keep timers/input/audio moving. */
 void got_platform_pump(void);
