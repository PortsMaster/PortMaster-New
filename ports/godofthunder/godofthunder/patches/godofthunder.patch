+static Texture2D g_display_texture;
+#ifdef GOT_PORTMASTER
+static got_pixel_scaler g_pixel_scaler;
+#endif
+/* Read-only diagnostics used by the on-device performance check. */
+static volatile unsigned long g_scaler_frames, g_scaler_updates;
+static volatile double g_scaler_seconds;
+static volatile int g_scaler_factor = 1;
+
+void got_platform_draw_frame(const uint8_t *rgba, int width, int height,
+                             float x, float y, float output_width, float output_height) {
+  const uint8_t *pixels = rgba;
+  int factor = 1, changed = 1;
+  double begin = GetTime();
+#ifdef GOT_PORTMASTER
+  static int failed_mode = -1;
+  factor = got_scaler_factor(g_config.scaler, width, height, output_width, output_height);
+  if (failed_mode != g_config.scaler) {
+    if (got_scaler_process(&g_pixel_scaler, rgba, width, height, factor)) {
+      pixels = g_pixel_scaler.rgba;
+      changed = g_pixel_scaler.changed;
+    } else {
+      TraceLog(LOG_WARNING, "Scaling failed; falling back to nearest");
+      failed_mode = g_config.scaler;
+      got_scaler_destroy(&g_pixel_scaler);
+      factor = 1;
+    }
+  } else factor = 1;
+#endif
+  g_scaler_factor = factor;
+  if (g_display_texture.width != width * factor || g_display_texture.height != height * factor) {
+    Image image = { (void *)pixels, width * factor, height * factor, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 };
+    if (g_display_texture.id) UnloadTexture(g_display_texture);
+    g_display_texture = LoadTextureFromImage(image);
+    SetTextureFilter(g_display_texture, TEXTURE_FILTER_POINT);
+  } else if (changed) UpdateTexture(g_display_texture, pixels);
+  {
+    double elapsed = GetTime() - begin;
+    g_scaler_seconds += elapsed;
+  }
+  ++g_scaler_frames;
