diff --git a/src/native/pixel_scaler.c b/src/native/pixel_scaler.c
new file mode 100644
index 0000000..58fb923
--- /dev/null
+++ b/src/native/pixel_scaler.c
@@ -0,0 +1,103 @@
+/* Independent implementation of the published EPX/Scale2x pixel rules.
+ * Algorithm credit: Eric Johnston and Andrea Mazzoleni.
+ * Public domain, like the native God of Thunder port. No GPL code is used. */
+#include "pixel_scaler.h"
+
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+int got_scaler_factor(int mode, int width, int height, float output_width, float output_height) {
+    float scale;
+    if (mode == GOT_SCALER_EPX2) return 2;
+    if (mode == GOT_SCALER_EPX4) return 4;
+    if (mode != GOT_SCALER_AUTO || width <= 0 || height <= 0) return 1;
+    scale = output_width / width;
+    if (output_height / height > scale) scale = output_height / height;
+    if (scale <= 1.0f) return 1;
+    return scale <= 2.0f ? 2 : 4;
+}
+
+static void epx2(const uint32_t *source, int width, int height, uint32_t *output) {
+    int x, y;
+    size_t stride = (size_t)width * 2;
+    for (y = 0; y < height; ++y) {
+        const uint32_t *row = source + (size_t)y * width;
+        const uint32_t *above = source + (size_t)(y ? y - 1 : y) * width;
+        const uint32_t *below = source + (size_t)(y + 1 < height ? y + 1 : y) * width;
+        uint32_t *top = output + (size_t)y * 2 * stride;
+        uint32_t *bottom = top + stride;
+        for (x = 0; x < width; ++x) {
+            uint32_t b = above[x], d = row[x ? x - 1 : x], e = row[x];
+            uint32_t f = row[x + 1 < width ? x + 1 : x], h = below[x];
+            if (b != h && d != f) {
+                top[x * 2] = d == b ? d : e;
+                top[x * 2 + 1] = b == f ? f : e;
+                bottom[x * 2] = d == h ? d : e;
+                bottom[x * 2 + 1] = h == f ? f : e;
+            } else {
+                top[x * 2] = top[x * 2 + 1] = e;
+                bottom[x * 2] = bottom[x * 2 + 1] = e;
+            }
+        }
+    }
+}
+
+int got_scaler_process(got_pixel_scaler *scaler, const uint8_t *rgba, int width, int height, int factor) {
+    size_t pixels, needed, i;
+    int full_update;
+    if (!rgba || width <= 0 || height <= 0 || (factor != 1 && factor != 2 && factor != 4) ||
+        width > INT_MAX / 4 || height > INT_MAX / 4) return 0;
+    if ((size_t)width > SIZE_MAX / (size_t)height / (4 * factor * factor)) return 0;
+    pixels = (size_t)width * height;
+    if (scaler->pixels != pixels) {
+        uint8_t *previous = malloc(pixels * 4);
+        uint32_t *input = malloc(pixels * 4);
+        if (!previous || !input) { free(previous); free(input); return 0; }
+        free(scaler->previous);
+        free(scaler->input);
+        scaler->previous = previous;
+        scaler->input = input;
+        scaler->pixels = pixels;
+        scaler->factor = 0;
+    }
+    full_update = scaler->width != width || scaler->height != height || scaler->factor != factor;
+    scaler->changed = full_update || memcmp(scaler->previous, rgba, pixels * 4) != 0;
+    if (!scaler->changed) return 1;
+    if (factor > 1) {
+        needed = pixels * factor * factor;
+        if (scaler->output_capacity < needed) {
+            uint32_t *output = realloc(scaler->output, needed * 4);
+            if (!output) return 0;
+            scaler->output = output;
+            scaler->output_capacity = needed;
+        }
+        /* Exact packed-pixel comparisons preserve every RGBA channel. */
+        for (i = 0; i < pixels; ++i) memcpy(&scaler->input[i], rgba + i * 4, 4);
+        if (factor == 2) epx2(scaler->input, width, height, scaler->output);
+        else {
+            if (scaler->intermediate_capacity < pixels * 4) {
+                uint32_t *intermediate = realloc(scaler->intermediate, pixels * 16);
+                if (!intermediate) return 0;
+                scaler->intermediate = intermediate;
+                scaler->intermediate_capacity = pixels * 4;
+            }
+            epx2(scaler->input, width, height, scaler->intermediate);
+            epx2(scaler->intermediate, width * 2, height * 2, scaler->output);
+        }
+        scaler->rgba = (const uint8_t *)scaler->output;
+    } else scaler->rgba = scaler->previous;
+    memcpy(scaler->previous, rgba, pixels * 4);
+    scaler->width = width;
+    scaler->height = height;
+    scaler->factor = factor;
+    return 1;
+}
+
+void got_scaler_destroy(got_pixel_scaler *scaler) {
+    free(scaler->input);
+    free(scaler->intermediate);
+    free(scaler->output);
+    free(scaler->previous);
+    memset(scaler, 0, sizeof(*scaler));
+}
diff --git a/src/native/pixel_scaler.h b/src/native/pixel_scaler.h
new file mode 100644
index 0000000..1915e39
--- /dev/null
+++ b/src/native/pixel_scaler.h
@@ -0,0 +1,21 @@
+#ifndef GOT_PIXEL_SCALER_H
+#define GOT_PIXEL_SCALER_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum { GOT_SCALER_NEAREST, GOT_SCALER_EPX2, GOT_SCALER_EPX4, GOT_SCALER_AUTO };
+
+typedef struct {
+    uint32_t *input, *intermediate, *output;
+    uint8_t *previous;
+    size_t pixels, intermediate_capacity, output_capacity;
+    int width, height, factor, changed;
+    const uint8_t *rgba;
+} got_pixel_scaler;
+
+int got_scaler_factor(int mode, int width, int height, float output_width, float output_height);
+int got_scaler_process(got_pixel_scaler *scaler, const uint8_t *rgba, int width, int height, int factor);
+void got_scaler_destroy(got_pixel_scaler *scaler);
+
+#endif
