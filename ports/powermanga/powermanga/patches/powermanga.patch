+/**
+ * Upload the offscreen public surface to the streaming texture
+ * and let the renderer scale it to the window
+ */
+static void
+display_present (void)
+{
+  SDL_UpdateTexture (main_texture, NULL, public_surface->pixels,
+                     public_surface->pitch);
+  SDL_RenderClear (main_renderer);
+  SDL_RenderCopy (main_renderer, main_texture, NULL, NULL);
+  SDL_RenderPresent (main_renderer);
+}
