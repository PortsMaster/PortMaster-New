#!/bin/bash
# Set GAMEDIR to the current directory and set logfile
GAMEDIR="$PWD"
LOGFILE="patchlog.txt"
LOGERR="patcherr.txt"

# Redirect output and error to the log file
rm -f "$GAMEDIR/$LOGERR"
# Save the patcher pipe (original stdout) on fd 3 before redirecting stdout
# through tee. This lets emit_fail_msg send dialog overrides straight to the
# patcher GUI without them appearing in patchlog.txt.
exec 3>&1
> "$GAMEDIR/$LOGFILE" && exec > >(tee "$GAMEDIR/$LOGFILE") 2>&1

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

echo "GAMEDIR is set to: $GAMEDIR"

# Exports
export DATADIR="$GAMEDIR/assets"
export SAVEDIR="$GAMEDIR/saves"
export DATAFILE="picayunedreams.port"

# Tight-RAM devices can't sustain a parallel astcenc / vorbis workload.
THREADS_FLAG=""
if [ "${DEVICE_RAM:-0}" -le 2 ]; then
    THREADS_FLAG="--threads 3"
fi

ORIG_MAX_FREQS=""
thermal_setup() {
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] && [ -f "$policy/scaling_max_freq" ] || continue
        orig=$(cat "$policy/scaling_max_freq") || continue
        target=$((orig * 8 / 10))
        $ESUDO sh -c "echo $target > '$policy/scaling_max_freq'" 2>/dev/null || true
        ORIG_MAX_FREQS="$ORIG_MAX_FREQS|$policy=$orig"
    done
}

thermal_restore() {
    OLDIFS=$IFS
    IFS='|'
    for entry in $ORIG_MAX_FREQS; do
        [ -z "$entry" ] && continue
        policy="${entry%=*}"
        orig="${entry#*=}"
        $ESUDO sh -c "echo $orig > '$policy/scaling_max_freq'" 2>/dev/null || true
    done
    IFS=$OLDIFS
}

prepare_files() {
    mkdir -p "$SAVEDIR"

	# Apply patch based on resolution
	if [ "$DISPLAY_WIDTH" -lt 1280 ]; then
		echo "Applying patch for low resolutions devices"
		$controlfolder/xdelta3 -d -s "$DATADIR/data.win" "tools/patchlowres.xdelta" "$DATADIR/game.droid"
	else
		echo "Applying a regular patch"
		$controlfolder/xdelta3 -d -s "$DATADIR/data.win" "tools/patch.xdelta" "$DATADIR/game.droid"
	fi

	# Move Mods folder
	mv "$DATADIR/mods" "$SAVEDIR/mods"

    # Delete excess files
    find "$DATADIR" -type f \( \
        -name "*.gitkeep" -o -name "*.exe" -o -name "*.dll" -o -name "*.hashdb" -o \
        -name "*.ico" -o -name "*.lnk" -o -name "*.msg" -o -name "*.zip" \
    \) -exec rm -f {} \;

    # Normalize CRLF -> LF on text assets
    find "$DATADIR" -type f \( -name "*.yarn" -o -name "*.csv" -o -name "*.json" -o -name "*.txt" -o -name "*.ini" \) \
        -exec sed -i 's/\r$//' {} \;

    if [ -d "$SAVEDIR/textures" ]; then
        rm -rf "$SAVEDIR/textures"
    fi
	


}
patch_datafile() {

# 1GB devices requires 6x6 ASTC compression due to RAM requirements
 if [[ "$DEVICE_RAM" -lt 2 ]]; then
        config="$GAMEDIR/tools/gmtoolkit-lowram.json"
        echo "Higher 6x6 compression is necessary on 1GB devices."
   else
	config="$GAMEDIR/tools/gmtoolkit.json"
    fi



if [[ "$DEVICE_RAM" -lt 4 ]]; then
	if ! "$GAMEDIR/tools/gmtoolkit.${DEVICE_ARCH}" --config "$config" $THREADS_FLAG "$DATADIR/game.droid"; then
        emit_fail_msg "gmtoolkit patch failed."
        return 1
    fi
	else
		return 0
	fi
}


# Zip it all into the .port file
zip_archive() {
    rm -f "$DATADIR/data.win"
    local zip_out
    if zip_out=$("$controlfolder/7zzs.${DEVICE_ARCH}" a -tzip -aoa -mx=0 "$GAMEDIR/$DATAFILE" "$DATADIR" 2>&1); then
        rm -rf "$DATADIR"/*
    else
        echo "$zip_out"
        emit_fail_msg "Failed to create $DATAFILE."
        return 1
    fi
}

process_game() {
    echo "Preparing game..."
    prepare_files || return 1
    thermal_setup
    echo "Applying patches..."
    patch_datafile
    rc=$?
    thermal_restore
    [ "$rc" -ne 0 ] && return 1
    echo "Finishing up..."
    zip_archive || return 1
}

if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Patching failed. Report on the PortMaster Discord with patcherr.txt."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
    exit 1
fi
echo "Patching process complete!"

