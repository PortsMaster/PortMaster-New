diff -ruN -x obj -x rafkill.aarch64 rafkill-1.2.3/Makefile.pm ../rafkill-1.2.3/Makefile.pm
--- rafkill-1.2.3/Makefile.pm	1970-01-01 00:00:00.000000000 +0000
+++ rafkill-1.2.3/Makefile.pm	2026-11-10 12:27:54.853273628 +0000
@@ -0,0 +1,31 @@
+# PortMaster build: Allegro Legacy on Allegro 5 (SDL2 + GLES2), DUMB 0.9.3 static.
+DEPS ?= ..
+A5 = $(DEPS)/allegro5
+AL = $(DEPS)/allegro-legacy
+DUMB = $(DEPS)/dumb-0.9.3
+
+CXX ?= g++
+CXXFLAGS ?= -O2 -g
+CPPFLAGS = -DPORTMASTER -DALLEGRO_LEGACY_NO_FIX_ALIASES -include $(DEPS)/patches/glibc-compat.h -iquote src \
+	-I$(DUMB)/include \
+	-I$(AL)/build-pm/include -I$(AL)/include \
+	-I$(A5)/build-pm/include -I$(A5)/include \
+	-I$(A5)/addons/audio -I$(A5)/addons/image -I$(A5)/addons/font -I$(A5)/addons/primitives -I$(A5)/addons/acodec
+LDLIBS = -L$(DUMB)/lib -laldmb -ldumb \
+	-L$(AL)/build-pm/lib -L$(A5)/build-pm/lib -lalleg -lallegro_audio -lallegro \
+	-lSDL2 -lpthread -lm
+
+SRCS = $(wildcard src/*.cpp src/guns/*.cpp src/hulls/*.cpp src/weapons/*.cpp)
+OBJS = $(SRCS:src/%.cpp=obj/%.o)
+
+rafkill.aarch64: $(OBJS)
+	$(CXX) -o $@ $(OBJS) $(LDLIBS)
+
+obj/%.o: src/%.cpp
+	@mkdir -p $(dir $@)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -w -c $< -o $@
+
+clean:
+	rm -rf obj rafkill.aarch64
+
+.PHONY: clean
