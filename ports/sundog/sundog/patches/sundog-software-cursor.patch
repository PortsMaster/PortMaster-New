+bool game_sdlscreen_get_cursor_image(struct game_screen *screen_, uint8_t *rgba, int *hot_x, int *hot_y)
+{
+    struct sdl_screen *screen = sdl_screen(screen_);
+    bool cursor_set           = false;
+    int i;
+    SDL_LockMutex(screen->mutex);
+    for (i = 0; i < CURSOR_WIDTH * CURSOR_WIDTH; ++i) {
+        int bit    = 7 - (i & 7);
+        int data   = (screen->cursor_data[i >> 3] >> bit) & 1;
+        int mask   = (screen->cursor_mask[i >> 3] >> bit) & 1;
+        /* Same meaning as SDL_CreateCursor: data+mask black, mask only white, data only inverted (black). */
+        uint8_t v  = (data || !mask) ? 0 : 255;
+        rgba[i * 4 + 0] = v;
+        rgba[i * 4 + 1] = v;
+        rgba[i * 4 + 2] = v;
+        rgba[i * 4 + 3] = (data || mask) ? 255 : 0;
+        if (data || mask) {
+            cursor_set = true;
+        }
+    }
+    *hot_x = screen->cursor_hot_x;
+    *hot_y = screen->cursor_hot_y;
+    SDL_UnlockMutex(screen->mutex);
+    return cursor_set;
+}
