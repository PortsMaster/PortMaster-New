+// The game polls key state, so a key that changes twice within one pump (an on-screen keyboard's
+// press+release, or gptokeyb's repeat release+press) would look unchanged. The second change is
+// held back until the next pump.
+int deferred_code = 0;
+bool deferred_down = false;
+
 void pump() {
+    if (deferred_code) { feed(deferred_code, deferred_down); deferred_code = 0; }
+    bool changed[SDL_NUM_SCANCODES] = {};
     SDL_Event ev;
     while (SDL_PollEvent(&ev)) {
         switch (ev.type) {
         case SDL_QUIT: quit = true; std::exit(0);   // window closed: leave like the DOS version on Ctrl-Break
         case SDL_KEYDOWN:
         case SDL_KEYUP:
+#ifndef PORTMASTER_BUILD   // fire (Alt) + use item (Enter) must not toggle the window
             if (ev.key.keysym.scancode == SDL_SCANCODE_RETURN && (ev.key.keysym.mod & KMOD_ALT)) {
                 if (ev.type == SDL_KEYDOWN && !ev.key.repeat) {
                     bool fs = SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN_DESKTOP;
@@ -149,6 +158,15 @@ void pump() {
                 }
                 break;
             }
+#endif
+            if (!ev.key.repeat) {
+                if (changed[ev.key.keysym.scancode]) {
+                    deferred_code = xt_code(ev.key.keysym.scancode);
+                    deferred_down = ev.type == SDL_KEYDOWN;
+                    return;
+                }
+                changed[ev.key.keysym.scancode] = true;
+            }
             feed(xt_code(ev.key.keysym.scancode), ev.type == SDL_KEYDOWN);
             break;
         default: break;
