+#ifdef PORTMASTER
+static const char *cursor_shape[] = {
+  "X           ",
+  "XX          ",
+  "X.X         ",
+  "X..X        ",
+  "X...X       ",
+  "X....X      ",
+  "X.....X     ",
+  "X......X    ",
+  "X.......X   ",
+  "X........X  ",
+  "X.........X ",
+  "X......XXXXX",
+  "X...X..X    ",
