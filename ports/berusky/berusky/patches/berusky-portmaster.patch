+  "X.X  X..X   ",
+  "XX   X..X   ",
+  "X     X..X  ",
+  "      X..X  ",
+  "       XX   ",
+};
+
+#define CURSOR_WIDTH   12
+#define CURSOR_HEIGHT  ((int)(sizeof(cursor_shape)/sizeof(cursor_shape[0])))
+
+// Draw the cursor to the screen and add its old and new area to the update list
+bool graph_2d::cursor_begin(void)
+{
+  SDL_Surface *p_surf = p_screen_surface ? p_screen_surface->surf_get() : NULL;
+  if(!p_surf)
+    return(FALSE);
+
+  if(cursor_drawn && !rect_whole && rect_last < RECT_NUM)
+    redraw_add(cursor_x, cursor_y, CURSOR_WIDTH, CURSOR_HEIGHT);
+  cursor_drawn = FALSE;
+
+  if(!cursor_visible)
+    return(FALSE);
+
+  if(!p_cursor_save) {
+    SDL_PixelFormat *p_fmt = p_surf->format;
+    p_cursor_save = SDL_CreateRGBSurface(SDL_SWSURFACE, CURSOR_WIDTH, CURSOR_HEIGHT,
+                                         p_fmt->BitsPerPixel, p_fmt->Rmask,
+                                         p_fmt->Gmask, p_fmt->Bmask, p_fmt->Amask);
+    if(!p_cursor_save)
+      return(FALSE);
+  }
+
+  int mx, my;
+  SDL_GetMouseState(&mx, &my);
+  cursor_x = mx;
+  cursor_y = my;
+
+  SDL_Rect src = { (Sint16)cursor_x, (Sint16)cursor_y, CURSOR_WIDTH, CURSOR_HEIGHT };
+  SDL_BlitSurface(p_surf, &src, p_cursor_save, NULL);
+
+  Uint32 black = SDL_MapRGB(p_surf->format, 0, 0, 0);
+  Uint32 white = SDL_MapRGB(p_surf->format, 255, 255, 255);
+  for(int y = 0; y < CURSOR_HEIGHT; y++) {
+    for(int x = 0; x < CURSOR_WIDTH; x++) {
+      char c = cursor_shape[y][x];
+      if(c == ' ')
+        continue;
+      SDL_Rect r = { (Sint16)(cursor_x+x), (Sint16)(cursor_y+y), 1, 1 };
+      SDL_FillRect(p_surf, &r, c == 'X' ? black : white);
+    }
+  }
+
+  if(!rect_whole && rect_last < RECT_NUM)
+    redraw_add(cursor_x, cursor_y, CURSOR_WIDTH, CURSOR_HEIGHT);
+  cursor_drawn = TRUE;
+  return(TRUE);
+}
+
+// Put the screen content back under the cursor
+void graph_2d::cursor_end(void)
+{
+  SDL_Rect dst = { (Sint16)cursor_x, (Sint16)cursor_y, CURSOR_WIDTH, CURSOR_HEIGHT };
+  SDL_BlitSurface(p_cursor_save, NULL, p_screen_surface->surf_get(), &dst);
+}
+
+// Present the screen again when the cursor moved or was hidden
+void graph_2d::cursor_update(void)
+{
+  int mx, my;
+  SDL_GetMouseState(&mx, &my);
+
+  if(cursor_visible ? (!cursor_drawn || mx != cursor_x || my != cursor_y) : cursor_drawn)
+    flip();
+}
