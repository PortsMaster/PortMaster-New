#!/bin/bash
LOGFILE="$GAMEDIR/patchlog.txt"
LOGERR="$GAMEDIR/patchlog_error.txt"
START_TIME=$(date +%s)

exec > >(tee -a "$LOGFILE") 2>&1
echo "GAMEDIR is set to: $GAMEDIR"

patch_failure() {
    mv "$LOGFILE" "$LOGERR"
    echo "Patching process failed."
    exit 1
}

export PATH="$controlfolder:$PATH"
export LD_LIBRARY_PATH="$GAMEDIR/libs:/usr/config/emuelec/lib:/usr/lib:$LD_LIBRARY_PATH"
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"

chmod 666 /dev/uinput

trap 'rm -rf "$TMPDIR"; echo "Cleaned up temporary files." >> "$LOGFILE"' 0

install_complete() {
    touch "install_completed"
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))
    echo "Script completed in $DURATION seconds"
    echo "Installation completed successfully!"
    echo "-----------------------------"
    echo "Process finished at: $(date)"
}

patch_game() {
    echo "Patching game..."

    DATA_DIR="$GAMEDIR/gamedata/data"
    GAME_DIR="$GAMEDIR/gamedata"
    TOOLS_DIR="$GAMEDIR/tools"
    WORKDIR="$GAMEDIR/patch_scratch"

    export LD_LIBRARY_PATH="$TOOLS_DIR/lib:$LD_LIBRARY_PATH"
    chmod +x "$TOOLS_DIR/oggenc" "$TOOLS_DIR/oggdec" "$TOOLS_DIR/sfxpack.py" 2>/dev/null

    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 not found on device - cannot compress audio archives."
        patch_failure
    fi

    mkdir -p "$WORKDIR"

    filesize() {
        wc -c < "$1" 2>/dev/null | tr -d ' '
    }

    compress_archive() {
        local name="$1"
        local src="$DATA_DIR/$name"
        local packed="$WORKDIR/${name}.oggpack"
        local before after

        if [ ! -f "$src" ]; then
            echo "  $name not found in $DATA_DIR, skipping."
            return
        fi

        before=$(filesize "$src")
        echo "  Compressing $name ($before bytes)..."

        if [ "$name" = "music.dat" ]; then
            # Maximum practical RAM reduction for music:
            # 48 kHz stereo source -> 22.05 kHz mono Vorbis.
            # The runtime bridge is compiled for this exact PCM format.
            python3 "$TOOLS_DIR/sfxpack.py" pack "$src" "$packed" \
                --quality 2 \
                --downmix \
                --resample 22050 \
                --oggenc "$TOOLS_DIR/oggenc" \
                --tmpdir "$WORKDIR" || patch_failure
        else
            # Keep SFX at higher quality. SFX RAM is much smaller overall.
            python3 "$TOOLS_DIR/sfxpack.py" pack "$src" "$packed" \
                --quality 2 \
				--downmix \
				--resample 22050 \
                --oggenc "$TOOLS_DIR/oggenc" \
                --tmpdir "$WORKDIR" || patch_failure
        fi

        after=$(filesize "$packed")
        mv -f "$packed" "$src"
        echo "  $name: $before -> $after bytes"
    }

    compress_archive "sfx.dat"
    compress_archive "music.dat"
    rm -rf "$WORKDIR"
	
	sleep 1
       
	# Patch CometStrikerDX.exe
	echo "Patching CometStrikerDX.exe ..."
    if ! $controlfolder/xdelta3 -d -s "$GAME_DIR/CometStrikerDX.exe" "$TOOLS_DIR/patch/cometstrikerdxexe.xdelta" "$GAME_DIR/CometStrikerDX.patched.exe"; then
        echo "Error: xdelta3 patch failed. Wrong installer version?"
        rm -f "$GAME_DIR/CometStrikerDX.patched.exe"
        patch_failure
    fi
    echo "CometStrikerDX.exe patched successfully..."
	sleep 1
	if [ ! -f "$GAME_DIR/CometStrikerDX.exe.orig" ]; then
        mv "$GAME_DIR/CometStrikerDX.exe" "$GAME_DIR/CometStrikerDX.exe.orig" || patch_failure
    fi
	mv "$GAME_DIR/CometStrikerDX.patched.exe" "$GAME_DIR/CometStrikerDX.exe" || patch_failure
    cp "$TOOLS_DIR/CometStrikerDX.exe.config" "$GAME_DIR/CometStrikerDX.exe.config" || patch_failure

    install_complete
    sleep 1
}

patch_game
