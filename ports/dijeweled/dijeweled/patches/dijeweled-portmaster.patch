diff -ruN -x .git -x '*.gmx' a/objects/obj_autotest/Create_0.gml b/objects/obj_autotest/Create_0.gml
--- a/objects/obj_autotest/Create_0.gml	1970-01-01 00:00:00.000000000 +0000
+++ b/objects/obj_autotest/Create_0.gml	2026-10-21 22:27:41.576098874 +0000
@@ -0,0 +1,170 @@
+/// @description PortMaster on-device test driver, only created when autotest.ini exists
+cases = []
+function add_case(_name, _kind, _data) {
+	_data.name = _name
+	_data.kind = _kind
+	array_push(cases, _data)
+}
+
+//single-player modes, started with the game's own menu buttons
+add_case("arcade", "mode", {button: obj_button_arcade, target: rm_timeattack, play: 40, fresh: "autosave_rm_timeattack"})
+add_case("arcade_continue", "mode", {button: obj_button_arcade, target: rm_timeattack, play: 10, dialog: 1})
+add_case("classic", "mode", {button: obj_button_classic, target: rm_classic, play: 40, fresh: "autosave_rm_classic"})
+add_case("classic_continue", "mode", {button: obj_button_classic, target: rm_classic, play: 10, dialog: 1})
+add_case("classic_new_over_save", "mode", {button: obj_button_classic, target: rm_classic, play: 10, dialog: 0})
+add_case("zen", "mode", {button: obj_button_zen, target: rm_zen, play: 40, fresh: "autosave_rm_zen"})
+add_case("blitz_1min_full", "mode", {button: obj_button_1min, target: rm_blitz, play: -1, twist: false})
+add_case("blitz_3min", "mode", {button: obj_button_3min, target: rm_blitz, play: 20, twist: false})
+add_case("blitz_5min", "mode", {button: obj_button_5min, target: rm_blitz, play: 20, twist: false})
+add_case("blitz_twist_1min_full", "mode", {button: obj_button_1min, target: rm_blitz, play: -1, twist: true})
+add_case("countdown", "mode", {button: obj_button_countdown, target: rm_countdown, play: 40})
+add_case("twist", "mode", {button: obj_button_twist, target: rm_twist, play: 40, fresh: "autosave_rm_twist"})
+add_case("compact", "mode", {button: obj_button_compact, target: rm_compact, play: 40, fresh: "autosave_rm_compact"})
+add_case("swift", "mode", {button: obj_button_swift, target: rm_swift, play: 40, fresh: "autosave_rm_swift"})
+add_case("survivor", "mode", {button: obj_button_survivor, target: rm_survivor, play: 40, fresh: "autosave_rm_survivor"})
+add_case("buyo", "mode", {button: obj_button_buyo, target: rm_buyobuyo, play: 40})
+
+//local multiplayer against the game's own bot
+//LOB_gamemode is 0-1, LOB_gamemode_2 is 0-2
+var lm = [[0, 0], [0, 1], [0, 2], [1, 0], [1, 1], [1, 2]]
+for (var i = 0; i < array_length(lm); i++) {
+	add_case("local_mode" + string(lm[i][0]) + "_" + string(lm[i][1]), "local", {gamemode: lm[i][0], gamemode2: lm[i][1], twist: false})
+}
+add_case("local_twist", "local", {gamemode: 0, gamemode2: 2, twist: true})
+
+//pause menu: every toggle, the controls screen, return, then main menu
+add_case("pause_all_buttons", "pause", {button: obj_button_classic, target: rm_classic, play: 999, fresh: "autosave_rm_classic"})
+
+//every main-menu button except Quit, from every button group
+//"tfjeweled" is only reachable after obj_button_tfjeweled connects to a server
+var groups = ["initial", "play", "single", "blitz", "secret", "online", "replays"]
+for (var g = 0; g < array_length(groups); g++) {
+	add_case("menu_group_" + groups[g], "menu", {group: groups[g], button: noone})
+}
+var menu_buttons = [obj_button_play, obj_button_options, obj_button_replays, obj_button_help, obj_button_credits,
+	obj_button_singleplayer, obj_button_multiplayer, obj_button_online, obj_button_back,
+	obj_button_secret, obj_button_challenge, obj_button_blitz,
+	obj_button_dedicated, obj_button_join, obj_button_host,
+	obj_button_online_replays, obj_button_search_replays]
+for (var b = 0; b < array_length(menu_buttons); b++) {
+	add_case("menu_" + object_get_name(menu_buttons[b]), "menu", {group: "", button: menu_buttons[b]})
+}
+add_case("stats_screen", "menu", {group: "", button: noone, goto: rm_menu_stats})
+add_case("credits_screen", "menu", {group: "", button: noone, goto: rm_menu_credits})
+add_case("options_screen", "menu", {group: "", button: noone, goto: rm_menu_options})
+
+//all 26 quest categories x 6 quests
+for (var c = 0; c < 26; c++) {
+	for (var q = 0; q < 6; q++) {
+		add_case("quest_" + string(c) + "_" + string(q), "quest", {cat: c, q: q, target: (c == 25 && q == 2) ? rm_quest252 : rm_quest, play: 20})
+	}
+}
+
+//input mapping, driven by tests/input_test.sh injecting real pad events; skipped in a normal run
+add_case("input_listen", "listen", {button: obj_button_classic, target: rm_classic, play: 0, fresh: "autosave_rm_classic", manual: true})
+
+//GML try/catch must survive under gmloader
+add_case("canary_try_catch", "canary", {})
+
+total = array_length(cases)
+ini_open("autotest.ini")
+	first = ini_read_real("run", "first", 0)
+	last = ini_read_real("run", "last", total - 1)
+	filter = ini_read_string("run", "filter", "")
+	//run the selected cases this many times in one process (memory checks)
+	rounds = ini_read_real("run", "repeat", 1)
+ini_close()
+
+function log_line(_s) {
+	var f = file_text_open_append("autotest_log.txt")
+	file_text_write_string(f, _s)
+	file_text_writeln(f)
+	file_text_close(f)
+	show_debug_message("AUTOTEST " + _s)
+}
+
+function finish(_pass, _why) {
+	var c = cases[current]
+	log_line((_pass ? "PASS " : "FAIL ") + string(current) + " " + c.name + " " + _why + " room=" + room_get_name(room))
+	state = "next"
+	t = 0
+}
+
+//one move for player1 the way the local bot does it (player_local Alarm_0)
+function bot_move() {
+	if (!instance_exists(player1) || !instance_exists(Gamerule_1)) return;
+	if (global.paused) return;
+	var g = Gamerule_1
+	if (!g.controlallowed || g.moving) return;
+	if (!g.IsGemActive2 && !g.multiswap_allowed) return;
+	var list_moves = -1
+	with(g) list_moves = check_summoves(true)
+	if (!is_array(list_moves)) return;
+	var k = irandom(array_length(list_moves) - 1)
+	var it = list_moves[k][0]
+	var jt = list_moves[k][1]
+	var im = it
+	var jm = jt
+	switch (list_moves[k][2]) {
+		case "up": im--; break;
+		case "down": im++; break;
+		case "left": jm--; break;
+		case "right": jm++; break;
+	}
+	with(player1) {
+		if (dont_swap || g.lightOn || !g.illegal_cando) exit;
+		gem1 = g.gem_board1[it, jt]
+		gem2 = g.gem_board1[im, jm]
+		if (instance_exists(gem1) && instance_exists(gem2) && gem1.acc == 0 && !gem1.ammoving && gem2.acc == 0 && !gem2.ammoving) {
+			xlim = jt
+			ylim = it
+			mouse_yy_pos = gem1.y
+			mouse_xx_pos = gem1.x
+			g.IsGemActive2 = 0
+			do_match(g)
+			other.moves++
+		}
+	}
+}
+
+function press(_obj) {
+	global.canbepressed = true
+	var found = false
+	with(_obj) {
+		found = true
+		if (variable_instance_exists(id, "unlocked")) unlocked = true
+		if (variable_instance_exists(id, "canclick")) canclick = true
+		event_perform(ev_mouse, ev_left_press)
+		break;
+	}
+	return found
+}
+
+function open_pause() {
+	toggle_pause()
+}
+
+//pausing deactivates every instance, this one included, so keep reactivating it
+reactivator = time_source_create(time_source_global, 5, time_source_units_frames,
+	method(undefined, function() { instance_activate_object(obj_autotest) }), [], -1)
+time_source_start(reactivator)
+
+exception_unhandled_handler(function(_e) {
+	var f = file_text_open_append("autotest_log.txt")
+	file_text_write_string(f, "ERROR " + string_replace_all(string(_e.longMessage), "\n", " | "))
+	file_text_writeln(f)
+	file_text_close(f)
+	return 0
+})
+
+binds = ["GP_swapdown", "GP_swapright", "GP_swapleft", "GP_swapup", "GP_pass", "GP_replay",
+	"GP_clockwise1", "GP_clockwise2", "GP_cclockwise1", "GP_cclockwise2"]
+last_room = -1
+last_paused = false
+
+current = first - 1
+state = "next"
+t = 0
+moves = 0
+step_i = 0
+log_line("TOTAL " + string(total) + " first=" + string(first) + " last=" + string(last))
diff -ruN -x .git -x '*.gmx' a/objects/obj_autotest/Step_0.gml b/objects/obj_autotest/Step_0.gml
--- a/objects/obj_autotest/Step_0.gml	1970-01-01 00:00:00.000000000 +0000
+++ b/objects/obj_autotest/Step_0.gml	2026-10-21 22:27:41.620582198 +0000
@@ -0,0 +1,237 @@
+/// @description Test case state machine
+t++
+if (state == "next") {
+	current++
+	while (current <= last && ((filter != "" && string_pos(filter, cases[current].name) == 0)
+		|| (filter == "" && variable_struct_exists(cases[current], "manual")))) current++
+	if (current > last && rounds > 1) {
+		rounds--
+		current = first
+		while (current <= last && filter != "" && string_pos(filter, cases[current].name) == 0) current++
+	}
+	if (current > last) {
+		log_line("DONE")
+		game_end()
+		exit;
+	}
+	var c = cases[current]
+	log_line("START " + string(current) + " " + c.name)
+	home = (c.kind == "quest") ? rm_menu_challenges : rm_menu
+	moves = 0
+	step_i = 0
+	home_asked = false
+	state = "home"
+	t = 0
+	exit;
+}
+
+var c = cases[current]
+
+switch (state) {
+	case "home":
+		//let the game boot through its loading and intro rooms by itself
+		if (room == rm_intro && t mod 120 == 119) with(obj_intro) click()
+		if (room == rm_loading_menu || room == rm_intro) {if (t > 3600) finish(false, "stuck in " + room_get_name(room)); break;}
+		if (room != home && !home_asked) {room_goto(home); home_asked = true}
+		if (room == home && t > 90) {state = "start"; t = 0}
+		else if (t > 900) finish(false, "never reached home room")
+		break;
+
+	case "start":
+		if (c.kind == "canary") {
+			var caught = false
+			try {
+				var n = path_get_number(-1)
+			}
+			catch(e) {
+				caught = true
+			}
+			finish(caught, "caught=" + string(caught))
+			break;
+		}
+		if (c.kind == "quest") {
+			with(obj_challenges_room) change_to_quest(other.cases[other.current].cat)
+			state = "quest_press"
+			t = 0
+			break;
+		}
+		if (variable_struct_exists(c, "goto")) {
+			room_goto(c.goto)
+			state = "linger"
+			t = 0
+			break;
+		}
+		var btn = (c.kind == "local") ? obj_button_multiplayer : c.button
+		var grp = variable_struct_exists(c, "group") ? c.group : ""
+		if (c.kind != "menu" || btn != noone) {
+			grp = ""
+			var names = variable_struct_get_names(global.button_group)
+			for (var i = 0; i < array_length(names); i++) {
+				var arr = global.button_group[$ names[i]]
+				for (var j = 0; j < array_length(arr); j++) if (arr[j] == btn) grp = names[i]
+			}
+		}
+		if (variable_struct_exists(c, "fresh")) file_delete(c.fresh)
+		if (grp != "") with(obj_menu_buttons_master) {kill_current_group(true); change_to_group(grp, false)}
+		state = (c.kind == "menu" && btn == noone) ? "linger" : "press"
+		t = 0
+		break;
+
+	case "press":
+		if (t < 20) break;
+		if (variable_struct_exists(c, "twist")) global.blitz_twist = c.twist
+		var btn = (c.kind == "local") ? obj_button_multiplayer : c.button
+		if (!press(btn)) {finish(false, "button " + object_get_name(btn) + " not on screen"); break;}
+		state = (c.kind == "menu") ? "linger" : ((c.kind == "local") ? "lobby" : "wait_target")
+		t = 0
+		break;
+
+	case "linger":
+		if (t > 180) finish(true, "")
+		break;
+
+	case "lobby":
+		if (room != rm_lobby_local) {if (t > 900) finish(false, "lobby not reached"); break;}
+		if (t < 60) break;
+		LOB_gamemode.val = c.gamemode
+		if (c.gamemode == 1) {
+			instance_destroy(LOB_gamemode_2)
+			if (!instance_exists(LOB_gamemode_defence)) instance_create_depth(16, 336, -1, LOB_gamemode_defence)
+			LOB_gamemode_defence.enabled = c.gamemode2
+		}
+		else if (c.gamemode == 0) {
+			instance_destroy(LOB_gamemode_defence)
+			if (!instance_exists(LOB_gamemode_2)) instance_create_depth(168, 336, -1, LOB_gamemode_2)
+			LOB_gamemode_2.val = c.gamemode2
+		}
+		else {instance_destroy(LOB_gamemode_defence); instance_destroy(LOB_gamemode_2)}
+		LOB_twist.enabled = c.twist
+		global.bot1 = true
+		with(obj_controller_choose) index = 3
+		if (!press(obj_button_ready)) {finish(false, "ready button missing"); break;}
+		c.target = rm_LOCAL
+		c.play = 40
+		state = "wait_target"
+		t = 0
+		break;
+
+	case "quest_press":
+		if (t < 30) break;
+		var pressed = false
+		with(obj_challenges_selection) if (index == other.cases[other.current].q) {
+			global.canbepressed = true
+			event_perform(ev_mouse, ev_left_press)
+			pressed = true
+		}
+		if (!pressed) {finish(false, "quest button missing"); break;}
+		state = "quest_locked"
+		t = 0
+		break;
+
+	case "quest_locked":
+		//locked quests ignore the press; start them the way the selection handler does
+		if (room == c.target) {state = "play"; t = 0; break;}
+		if (t < 120) break;
+		global.DIS_quest_category = c.cat
+		global.DIS_quest_incategory = c.q
+		global.challenge_index = string(c.cat) + string(c.q)
+		global.chl_to_unlock = (c.q == 5) ? "none" : string(c.cat) + ":" + string(c.q + 1)
+		global.chl_to_succeed = string(c.cat) + ":" + string(c.q)
+		global.challenge_desc = obj_challenges_room.AR_challenges[c.cat, c.q]
+		global.canbepressed = false
+		fade_to_room(c.target)
+		log_line("NOTE " + c.name + " was locked, started directly")
+		state = "wait_target"
+		t = 0
+		break;
+
+	case "wait_target":
+		if (variable_struct_exists(c, "dialog") && instance_exists(obj_neworcontinue) && t > 30) {
+			var bm = obj_neworcontinue.button_manager
+			with(bm[c.dialog]) event_perform(ev_mouse, ev_left_press)
+			t = 0
+			break;
+		}
+		if (room == c.target) {state = "play"; t = 0}
+		else if (t > 900) finish(false, "target room " + room_get_name(c.target) + " not reached")
+		break;
+
+	case "listen":
+		//report what the game sees from the real pad and mouse
+		var gp = global.gp[0]
+		for (var i = 0; i < array_length(binds); i++) {
+			if (gamepad_button_check_pressed(gp, variable_global_get(binds[i]))) log_line("INPUT " + binds[i])
+		}
+		if (gamepad_button_check_pressed(gp, gp_start)) log_line("INPUT start")
+		if (gamepad_button_check_pressed(gp, gp_padu)) log_line("INPUT padu")
+		if (gamepad_button_check_pressed(gp, gp_padr)) log_line("INPUT padr")
+		if (mouse_check_button_pressed(mb_left)) log_line("INPUT mouse_left")
+		if (mouse_check_button_pressed(mb_right)) log_line("INPUT mouse_right")
+		if (global.paused != last_paused) {last_paused = global.paused; log_line("INPUT paused=" + string(global.paused))}
+		if (room != last_room) {last_room = room; log_line("INPUT room=" + room_get_name(room))}
+		if (t == 2) log_line("LISTEN")
+		if (room == rm_menu && t > 60) finish(true, "pause Main Menu reached by pad")
+		else if (t > 120 * 60) finish(false, "listen timed out")
+		break;
+
+	case "play":
+		if (c.kind == "listen") {state = "listen"; t = 0; last_room = room; break;}
+		if (room != c.target) {
+			//a game can end on its own (no moves left, quest won or lost); check where it went
+			var results = [rm_stats_normal, rm_stats_blitz, rm_stats_survivor, rm_stats_countdown, rm_menu_saverep]
+			if (array_contains(results, room)) {state = "results"; t = 0}
+			else if (room == home) finish(true, "game ended by itself after " + string(t div 60) + "s, moves=" + string(moves))
+			else if (room != rm_loading_menu) finish(false, "left " + room_get_name(c.target) + " for " + room_get_name(room))
+			break;
+		}
+		if (t mod 20 == 0) bot_move()
+		if (c.kind == "pause" && t > 300) {open_pause(); state = "pause_buttons"; t = 0; break;}
+		if (c.play >= 0 && t > c.play * 60) {open_pause(); state = "pause_exit"; t = 0}
+		else if (c.play < 0 && t > 200 * 60) finish(false, "game never ended")
+		break;
+
+	case "results":
+		if (room == rm_menu_saverep && t > 120) {
+			if (!press(obj_replaysave_cancel)) finish(false, "replay cancel missing")
+			t = 0
+		}
+		else if ((room == rm_stats_normal || room == rm_stats_blitz || room == rm_stats_survivor || room == rm_stats_countdown) && t > 180) {
+			if (!instance_exists(obj_menu_gamepad)) {finish(false, "results screen has no gamepad handler"); break;}
+			if (!press(obj_button_statscontinue)) {finish(false, "continue missing"); break;}
+			state = "wait_home"
+			t = 0
+		}
+		else if (room == home && t > 30) finish(true, "game over went straight to " + room_get_name(home) + ", moves=" + string(moves))
+		else if (t > 900) finish(false, "stuck after game over")
+		break;
+
+	case "pause_buttons":
+		if (t < 40) break;
+		var seq = [obj_pause_tick_lighteffects, obj_pause_tick_lighteffects, obj_pause_tick_vsync, obj_pause_tick_vsync,
+			obj_pause_tick_shownum, obj_pause_tick_shownum, obj_pause_tick_transparent, obj_pause_tick_transparent,
+			obj_pause_tick_fullscreen, obj_pause_tick_fullscreen, obj_pause_controls, obj_bindings_return, obj_pause_return]
+		if (step_i < array_length(seq)) {
+			if (!press(seq[step_i])) {finish(false, object_get_name(seq[step_i]) + " not on screen"); break;}
+			step_i++
+			t = 20
+			break;
+		}
+		if (global.paused) {finish(false, "Return did not unpause"); break;}
+		open_pause()
+		state = "pause_exit"
+		t = 0
+		break;
+
+	case "pause_exit":
+		if (t < 40) break;
+		if (!instance_exists(obj_pause_mainmenu)) {finish(false, "pause menu did not open"); break;}
+		press(obj_pause_mainmenu)
+		state = "wait_home"
+		t = 0
+		break;
+
+	case "wait_home":
+		if (room == home && t > 30) finish(true, "moves=" + string(moves))
+		else if (t > 900) finish(false, "did not return to " + room_get_name(home))
+		break;
+}
