+        info.dlpi_addr = mod->base;
+        info.dlpi_name = mod->soname ? mod->soname : "";
+        info.dlpi_phdr = (const ElfW(Phdr) *)phdrs.data();
+        info.dlpi_phnum = phdrs.size();
+
+        int ret = callback(&info, sizeof(info), data);
+        if (ret)
+            return ret;
+    }
+
+    return 0;
