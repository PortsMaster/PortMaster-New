+    } else {
+        int count = static_cast<int>(s_cached_achievements.size());
+        s_ach_selected = std::clamp(s_ach_selected, 0, count - 1);
+        s_ach_scroll = std::clamp(s_ach_scroll, 0, count - 1);
+    }
+}
