@@ -0,0 +1,62 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <ctype.h>
+
+int main(int argc, char** argv) {
+    if (argc != 5) {
+        fprintf(stderr, "Usage: %s <input_file> <symbol_name> <out_c> <out_h>\n", argv[0]);
+        return EXIT_FAILURE;
+    }
+
+    const char* in_path = argv[1];
+    const char* sym_name = argv[2];
+    const char* out_c_path = argv[3];
+    const char* out_h_path = argv[4];
+
+    FILE* in = fopen(in_path, "rb");
+    if (!in) {
+        fprintf(stderr, "file_to_c: failed to open %s for reading\n", in_path);
+        return EXIT_FAILURE;
+    }
+
+    FILE* fc = fopen(out_c_path, "w");
+    if (!fc) {
+        fprintf(stderr, "file_to_c: failed to open %s for writing\n", out_c_path);
+        fclose(in);
+        return EXIT_FAILURE;
+    }
+
+    FILE* fh = fopen(out_h_path, "w");
+    if (!fh) {
+        fprintf(stderr, "file_to_c: failed to open %s for writing\n", out_h_path);
+        fclose(in);
+        fclose(fc);
+        return EXIT_FAILURE;
+    }
+
+    fprintf(fh, "#pragma once\n#include <stddef.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n");
+    fprintf(fh, "extern const unsigned char %s[];\n", sym_name);
+    fprintf(fh, "extern const size_t %s_size;\n", sym_name);
+    fprintf(fh, "#ifdef __cplusplus\n}\n#endif\n");
+    fclose(fh);
+
+    fprintf(fc, "#include <stddef.h>\nconst unsigned char %s[] = {", sym_name);
+    int c;
+    size_t count = 0;
+    while ((c = fgetc(in)) != EOF) {
+        if (count % 16 == 0) {
+            fprintf(fc, "\n   ");
+        }
+        fprintf(fc, " 0x%02x,", (unsigned char)c);
+        count++;
+    }
+    fclose(in);
+
+    if (count == 0) {
+        fprintf(fc, " 0");
+    }
+    fprintf(fc, "\n};\nconst size_t %s_size = %zu;\n", sym_name, count);
+    fclose(fc);
+
+    return EXIT_SUCCESS;
+}
diff --git a/tools/file_to_c.py b/tools/file_to_c.py
new file mode 100755
index 0000000..088ec43
--- /dev/null
+++ b/tools/file_to_c.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+import sys
+
+def main():
+    if len(sys.argv) != 5:
+        sys.stderr.write(f"Usage: {sys.argv[0]} <input_file> <symbol_name> <out_c> <out_h>\n")
+        sys.exit(1)
+
+    in_path, sym_name, out_c_path, out_h_path = sys.argv[1:5]
+    with open(in_path, "rb") as f:
+        data = f.read()
+
+    with open(out_h_path, "w") as fh:
+        fh.write("#pragma once\n#include <stddef.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n")
+        fh.write(f"extern const unsigned char {sym_name}[];\n")
+        fh.write(f"extern const size_t {sym_name}_size;\n")
+        fh.write("#ifdef __cplusplus\n}\n#endif\n")
+
+    with open(out_c_path, "w") as fc:
+        fc.write(f"#include <stddef.h>\nconst unsigned char {sym_name}[] = {{")
+        for i, b in enumerate(data):
+            if i % 16 == 0:
+                fc.write("\n   ")
+            fc.write(f" 0x{b:02x},")
+        if len(data) == 0:
+            fc.write(" 0")
+        fc.write(f"\n}};\nconst size_t {sym_name}_size = {len(data)};\n")
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/prepare_rom_for_recomp.py b/tools/prepare_rom_for_recomp.py
new file mode 100755
index 0000000..4dffde6
--- /dev/null
+++ b/tools/prepare_rom_for_recomp.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""
+Prepares a Sin and Punishment ROM for recompilation and handheld packaging.
+
+Accepts any .z64, .n64, or .v64 dump of either the Japanese release or an English
+fan translation. Normalizes endianness to big-endian .z64, validates the code
+fingerprint against the port's target, and if an English fan translation is supplied,
+reconstructs a build-only Japanese ROM ('Tsumi to Batsu - Hoshi no Keishousha (Japan).z64')
+so N64Recomp and RSPRecomp generate 100% matching code.
+
+Optionally stages the ROM into the PortMaster distribution directory.
+"""
+
+import argparse
+import hashlib
+import os
+import shutil
+import struct
+import sys
+
+Z64_MAGIC = bytes.fromhex("80371240")
+V64_MAGIC = bytes.fromhex("37804012")
+N64_MAGIC = bytes.fromhex("40123780")
+
+MAIN_VRAM = 0x80025C00
+MAIN_ROM = 0x1000
+MAIN_TEXT_SIZE = 0x31280
+LOAD_TABLE_ROM = 0x34BAC
+
+CODE_FINGERPRINT_JP = 0xe941bdc06663d9ad
+
+SHA1_JP = "581297b9d5c3a4c33169ae0aae218c742cd9cbcf"
+SHA1_EN_FAN = "5945ff3935d9d9531bbb5cfcabed7c198e2b2f41"
+
+VARYING_WORDS = [
+    0x80025C00, 0x80025C04, 0x80025C08, 0x80025C0C,
+    0x8002BD5C, 0x8002BD8C, 0x8002BD98,
+    0x8003AB28, 0x8003AB2C, 0x8003AB78, 0x8003AB7C, 0x8003ABA4, 0x8003ABA8, 0x8003ABF0, 0x8003ABF4,
+    0x8003C158, 0x8003C15C, 0x8003C198, 0x8003C19C, 0x8003C1EC, 0x8003C1F0
+]
+
+# Japanese instructions to restore in English ROMs for N64Recomp (snp.jp.toml lines 234-285)
+JP_INSTRUCTIONS = [
+    # func_8002BCE0 display list address constants
+    (0x8002BD5C, 0x24425D20),
+    (0x8002BD8C, 0x24425D20),
+    (0x8002BD98, 0x24425D20),
+    # func_8003C0D0 asset table ROM offset constants
+    (0x8003C158, 0x3C0200A9),
+    (0x8003C15C, 0x2443CA40),
+    (0x8003C198, 0x3C0200A9),
+    (0x8003C19C, 0x2442CA40),
+    (0x8003C1EC, 0x3C0200A9),
+    (0x8003C1F0, 0x2443CA40),
+    # func_8003A9CC wave table ROM offset constants
+    (0x8003AB28, 0x3C02013C),
+    (0x8003AB2C, 0x24442C20),
+    (0x8003AB78, 0x3C02013C),
+    (0x8003AB7C, 0x24432C20),
+    (0x8003ABA4, 0x3C02013C),
+    (0x8003ABA8, 0x24422C20),
+    (0x8003ABF0, 0x3C02013C),
+    (0x8003ABF4, 0x24432C20)
+]
+
+# Standard Japanese entry point IPL3 boot code (0x80025C00..0x80025C0C)
+JP_ENTRY_INSTRUCTIONS = [
+    (0x80025C00, 0x3C088006),
+    (0x80025C04, 0x25083450),
+    (0x80025C08, 0x3C090004),
+    (0x80025C0C, 0x25293C20)
+]
+
+
+def normalize_endianness(data: bytes) -> tuple[bytearray, str]:
+    magic = data[0:4]
+    out = bytearray(data)
+    if magic == Z64_MAGIC:
+        return out, "z64 (big-endian native)"
+    if magic == V64_MAGIC:
+        for i in range(0, len(out), 2):
+            out[i], out[i + 1] = out[i + 1], out[i]
+        return out, "v64 (byte-swapped 16-bit) -> normalized"
+    if magic == N64_MAGIC:
+        for i in range(0, len(out), 4):
+            out[i:i + 4] = out[i:i + 4][::-1]
+        return out, "n64 (little-endian 32-bit) -> normalized"
+    raise ValueError(f"Unrecognized ROM magic bytes: {magic.hex()}")
+
+
+def fnv1a_64(data: bytes, h: int) -> int:
+    for b in data:
+        h = ((h ^ b) * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
+    return h
+
+
+def compute_code_fingerprint(rom: bytes) -> int:
+    if len(rom) < MAIN_ROM + MAIN_TEXT_SIZE or len(rom) < LOAD_TABLE_ROM + 20:
+        return 0
+    main = bytearray(rom[MAIN_ROM:MAIN_ROM + MAIN_TEXT_SIZE])
+    for vram in VARYING_WORDS:
+        offset = vram - MAIN_VRAM
+        if offset + 4 <= len(main):
+            main[offset:offset + 4] = bytes(4)
+
+    h = fnv1a_64(main, 0xcbf29ce484222325)
+    p = LOAD_TABLE_ROM
+    while p + 20 <= len(rom):
+        entry = rom[p:p + 20]
+        rom_start, vram, text_end, _, _ = struct.unpack(">5I", entry)
+        h = fnv1a_64(entry, h)
+        if rom_start == 0 or vram == 0:
+            return h
+        if text_end < vram or rom_start + (text_end - vram) > len(rom):
+            return 0
+        h = fnv1a_64(rom[rom_start:rom_start + (text_end - vram)], h)
+        p += 20
+    return h
+
+
+def reconstruct_build_rom(normalized: bytearray) -> bytearray:
+    build_rom = bytearray(normalized)
+
+    # 1. Restore standard entrypoint IPL3 boot code if modified by PALadin / patching stub
+    for vram, word in JP_ENTRY_INSTRUCTIONS:
+        offset = MAIN_ROM + (vram - MAIN_VRAM)
+        struct.pack_into(">I", build_rom, offset, word)
+
+    # 2. Restore Japanese instructions for N64Recomp
+    for vram, word in JP_INSTRUCTIONS:
+        offset = MAIN_ROM + (vram - MAIN_VRAM)
+        struct.pack_into(">I", build_rom, offset, word)
+
+    # 3. Restore Japanese cartridge header
+    # Internal name: 'TSUMI TO BATSU      ' (20 bytes at 0x20)
+    jp_name = b"TSUMI TO BATSU      "
+    build_rom[0x20:0x34] = jp_name
+
+    # Game code: 'NGUJ' at 0x3C
+    build_rom[0x3C:0x40] = b"NGUJ"
+
+    # CRCs at 0x10 and 0x14
+    struct.pack_into(">I", build_rom, 0x10, 0xB6BC0FB0)
+    struct.pack_into(">I", build_rom, 0x14, 0xE3812198)
+
+    return build_rom
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Prepare Sin and Punishment ROM for recompilation and handheld packaging."
+    )
+    parser.add_argument("input_rom", help="Path to input .z64, .n64, or .v64 ROM file")
+    parser.add_argument(
+        "-o", "--output",
+        default="Tsumi to Batsu - Hoshi no Keishousha (Japan).z64",
+        help="Output path for build-ready Japanese ROM (default: 'Tsumi to Batsu - Hoshi no Keishousha (Japan).z64')"
+    )
+    parser.add_argument(
+        "--stage-portmaster",
+        action="store_true",
+        help="Stage the input ROM into portmaster/sinandpunishment/roms/ directory"
+    )
+    parser.add_argument(
+        "--portmaster-dir",
+        default="portmaster/sinandpunishment/roms",
+        help="Destination directory when --stage-portmaster is used"
+    )
+
+    args = parser.parse_args()
+
+    if not os.path.isfile(args.input_rom):
+        sys.exit(f"Error: input ROM file not found: {args.input_rom}")
+
+    with open(args.input_rom, "rb") as f:
+        raw_data = f.read()
+
+    normalized, format_note = normalize_endianness(raw_data)
+    sha1 = hashlib.sha1(normalized).hexdigest()
+    fingerprint = compute_code_fingerprint(normalized)
+
+    print(f"Format: {format_note}")
+    print(f"SHA-1 : {sha1}")
+    print(f"Code Fingerprint: 0x{fingerprint:016x}")
+
+    if fingerprint != CODE_FINGERPRINT_JP:
+        sys.exit(f"Error: ROM code fingerprint (0x{fingerprint:016x}) does not match Sin and Punishment (0x{CODE_FINGERPRINT_JP:016x})!")
+
+    if sha1 == SHA1_JP:
+        print("Detected original Japanese release ROM.")
+        with open(args.output, "wb") as f:
+            f.write(normalized)
+        print(f"Wrote build ROM -> {args.output}")
+    else:
+        print("Detected fan English translation or alternate dump with matching code.")
+        print("Reconstructing build-ready Japanese code segment for N64Recomp...")
+        build_rom = reconstruct_build_rom(normalized)
+        with open(args.output, "wb") as f:
+            f.write(build_rom)
+        print(f"Wrote build ROM -> {args.output}")
+
+    if args.stage_portmaster:
+        os.makedirs(args.portmaster_dir, exist_ok=True)
+        dest_filename = os.path.basename(args.input_rom)
+        if not dest_filename.lower().endswith(".z64"):
+            dest_filename = os.path.splitext(dest_filename)[0] + ".z64"
+        dest_path = os.path.join(args.portmaster_dir, dest_filename)
+        with open(dest_path, "wb") as f:
+            f.write(normalized)
+        print(f"Staged runtime ROM for PortMaster -> {dest_path}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/snp_patch.cpp b/tools/snp_patch.cpp
new file mode 100644
index 0000000..87102b6
--- /dev/null
+++ b/tools/snp_patch.cpp
@@ -0,0 +1,223 @@
+#include "snp_patch_lib.h"
+
+#include <iostream>
+#include <string_view>
+
+namespace {
+
+void print_usage(const char* prog_name) {
+    std::cerr << "Usage:\n"
+              << "  " << prog_name << " --verify <rom_path>\n"
+              << "  " << prog_name << " --normalize <in_rom> <out_z64>\n"
+              << "  " << prog_name << " --setup-rom <in_rom> <out_dir> [--patch <patch_file>]\n"
+              << "  " << prog_name << " --crypt <rom_path> <in_file> <out_file_or_dash>\n";
+}
+
+int handle_verify(const std::filesystem::path& rom_path) {
+    std::vector<uint8_t> raw_rom;
+    std::string err;
+    if (!snp::patch::read_file_bytes(rom_path, raw_rom, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    std::vector<uint8_t> z64_rom;
+    if (!snp::patch::normalize_rom_to_z64(raw_rom, z64_rom, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    std::vector<uint8_t> canonical_code;
+    std::string game_id;
+    if (!snp::patch::extract_canonical_code(z64_rom, canonical_code, game_id, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    std::cout << "GAME_ID=" << game_id << "\n";
+    return 0;
+}
+
+int handle_normalize(const std::filesystem::path& in_rom, const std::filesystem::path& out_z64) {
+    std::vector<uint8_t> raw_rom;
+    std::string err;
+    if (!snp::patch::read_file_bytes(in_rom, raw_rom, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    std::vector<uint8_t> z64_rom;
+    if (!snp::patch::normalize_rom_to_z64(raw_rom, z64_rom, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    if (!snp::patch::write_file_atomic(out_z64, z64_rom.data(), z64_rom.size(), err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    std::cerr << "snp-patch: normalized " << raw_rom.size() << " bytes to " << out_z64.filename().string() << "\n";
+    return 0;
+}
+
+int handle_setup_rom(const std::filesystem::path& in_rom, const std::filesystem::path& out_dir,
+                     const std::filesystem::path& patch_file) {
+    std::vector<uint8_t> raw_rom;
+    std::string err;
+    if (!snp::patch::read_file_bytes(in_rom, raw_rom, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    std::vector<uint8_t> z64_rom;
+    if (!snp::patch::normalize_rom_to_z64(raw_rom, z64_rom, err)) {
+        std::cerr << "snp-patch: " << err << "\n";
+        return 1;
+    }
+
+    if (!patch_file.empty()) {
+        std::vector<uint8_t> patch_bytes;
+        if (!snp::patch::read_file_bytes(patch_file, patch_bytes, err)) {
+            std::cerr << "snp-patch: failed reading translation patch: " << err << "\n";
+            return 1;
+        }
+
+        std::vector<uint8_t> patched_z64;
+        bool already_patched = false;
+        if (!snp::patch::apply_rom_patch(z64_rom, patch_bytes, patched_z64, already_patched, err)) {
+            std::cerr << "snp-patch: failed applying translation patch: " << err << "\n";
+            return 1;
+        }
+        if (already_patched) {
+            std::cerr << "snp-patch: translation patch already applied (" << patch_file.filename().string() << ")\n";
+        } else {
+            z64_rom = std::move(patched_z64);
+            std::cerr << "snp-patch: applied translation patch " << patch_file.filename().string()
+                      << " (" << z64_rom.size() << " bytes)\n";
+        }
+    }
+
+    std::vector<uint8_t> canonical_code;
+    std::string game_id;
+    if (!snp::patch::extract_canonical_code(z64_rom, canonical_code, game_id, err)) {
+        std::cerr << "snp-patch: ROM code verification failed: " << err << "\n";
+        return 1;
+    }
+
+    const std::filesystem::path target_path = out_dir / (game_id + ".z64");
+    bool skip_write = false;
+
+    std::error_code ec;
+    if (std::filesystem::exists(target_path, ec)) {
+        const uintmax_t existing_size = std::filesystem::file_size(target_path, ec);
+        if (!ec && existing_size == z64_rom.size()) {
+            std::vector<uint8_t> existing_rom;
+            std::string read_err;
+            if (snp::patch::read_file_bytes(target_path, existing_rom, read_err)) {
+                if (snp::patch::compute_crc32(existing_rom) == snp::patch::compute_crc32(z64_rom)) {
+                    skip_write = true;
+                }
+            }
+        }
+    }
+
+    if (skip_write) {
+        std::cerr << "snp-patch: reusing matching stored ROM " << target_path.filename().string() << "\n";
+    } else {
+        if (!snp::patch::write_file_atomic(target_path, z64_rom.data(), z64_rom.size(), err)) {
+            std::cerr << "snp-patch: failed saving verified ROM: " << err << "\n";
+            return 1;
+        }
+        std::cerr << "snp-patch: stored verified ROM " << target_path.filename().string()
+                  << " (" << z64_rom.size() << " bytes)\n";
+    }
+
+    std::cout << "GAME_ID=" << game_id << "\n";
+    std::cout << "STORED_ROM=" << target_path.string() << "\n";
+    return 0;
+}
+
+int handle_crypt(const std::filesystem::path& rom_path, const std::filesystem::path& in_file_path,
+                 const std::string& out_file_or_dash) {
+    std::vector<uint8_t> raw_rom;
+    std::string err;
+    if (!snp::patch::read_file_bytes(rom_path, raw_rom, err)) {
+        std::cerr << "snp-patch: failed to read key ROM: " << err << "\n";
+        return 1;
+    }
+
+    std::vector<uint8_t> z64_rom;
+    if (!snp::patch::normalize_rom_to_z64(raw_rom, z64_rom, err)) {
+        std::cerr << "snp-patch: failed to normalize key ROM: " << err << "\n";
+        return 1;
+    }
+
+    std::vector<uint8_t> canonical_code;
+    std::string game_id;
+    if (!snp::patch::extract_canonical_code(z64_rom, canonical_code, game_id, err)) {
+        std::cerr << "snp-patch: failed to extract key code: " << err << "\n";
+        return 1;
+    }
+
+    std::ifstream in_file(in_file_path, std::ios::binary);
+    if (!in_file.is_open()) {
+        std::cerr << "snp-patch: failed to open input payload: " << in_file_path.string() << "\n";
+        return 1;
+    }
+
+    FILE* out_fp = nullptr;
+    const bool write_stdout = (out_file_or_dash == "-");
+    if (write_stdout) {
+#ifdef _WIN32
+        _setmode(_fileno(stdout), _O_BINARY);
+#endif
+        out_fp = stdout;
+    } else {
+        out_fp = std::fopen(out_file_or_dash.c_str(), "wb");
+        if (!out_fp) {
+            std::cerr << "snp-patch: failed to open output file: " << out_file_or_dash << "\n";
+            return 1;
+        }
+    }
+
+    if (!snp::patch::crypt_stream(canonical_code, in_file, out_fp, err)) {
+        std::cerr << "snp-patch: cipher streaming error: " << err << "\n";
+        if (!write_stdout) {
+            std::fclose(out_fp);
+        }
+        return 1;
+    }
+
+    if (!write_stdout) {
+        std::fclose(out_fp);
+    }
+    return 0;
+}
+
+} // namespace
+
+int main(int argc, char* argv[]) {
+    if (argc >= 3 && std::string_view(argv[1]) == "--verify") {
+        return handle_verify(argv[2]);
+    }
+
+    if (argc >= 4 && std::string_view(argv[1]) == "--normalize") {
+        return handle_normalize(argv[2], argv[3]);
+    }
+
+    if (argc >= 4 && std::string_view(argv[1]) == "--setup-rom") {
+        std::filesystem::path patch_path;
+        if (argc >= 6 && std::string_view(argv[4]) == "--patch") {
+            patch_path = argv[5];
+        }
+        return handle_setup_rom(argv[2], argv[3], patch_path);
+    }
+
+    if (argc >= 5 && std::string_view(argv[1]) == "--crypt") {
+        return handle_crypt(argv[2], argv[3], argv[4]);
+    }
+
+    print_usage(argv[0]);
+    return 1;
+}
