+void ra_sync_now() {
+    if (s_is_syncing.load()) {
+        return;
+    }
+
+    if (s_state.load() == RaClientState::Offline && !s_is_offline_mode.load()) {
+        std::lock_guard<std::recursive_mutex> lock(s_client_mutex);
+        if (s_client != nullptr) {
+            trigger_login(s_client);
