+void add_string(float x, float y, float scale, const std::string& str, const ColorRgba& c) {
+    float cur_x = x;
+    float step = FONT_CHAR_WIDTH * scale;
+    for (char ch : str) {
+        add_char(cur_x, y, scale, ch, c);
+        cur_x += step;
+    }
+}
