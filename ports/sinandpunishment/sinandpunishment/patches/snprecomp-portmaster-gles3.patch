+        return;
+    }
+
+    HttpRequestTask task;
+    task.is_sync_task = true;
+
+    std::lock_guard<std::mutex> lock(s_worker_mutex);
+    s_request_queue.push_back(std::move(task));
+    s_worker_cv.notify_one();
