+ultramodern::renderer::WindowHandle create_window(ultramodern::gfx_callbacks_t::gfx_data_t) {
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+    SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+
+    uint32_t flags = SDL_WINDOW_OPENGL | SDL_WINDOW_RESIZABLE;
+    const char* video_driver = SDL_GetCurrentVideoDriver();
+    const char* windowed_env = std::getenv("SNP_WINDOWED");
+    if (!windowed_env && (!video_driver || std::strcmp(video_driver, "offscreen") != 0)) {
+        flags |= SDL_WINDOW_FULLSCREEN_DESKTOP;
+    }
+    int win_w = DEFAULT_WINDOW_WIDTH;
+    int win_h = DEFAULT_WINDOW_HEIGHT;
+    if (const char* env_w = std::getenv("SNP_WINDOW_W")) {
+        try { win_w = std::stoi(env_w); } catch (...) {}
+    }
+    if (const char* env_h = std::getenv("SNP_WINDOW_H")) {
+        try { win_h = std::stoi(env_h); } catch (...) {}
+    }
+
+    s_window = SDL_CreateWindow(PROGRAM_NAME.c_str(), SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, win_w, win_h, flags);
+    if (s_window == nullptr) {
+        fprintf(stderr, "Failed to create SDL window: %s\n", SDL_GetError());
+        std::exit(EXIT_FAILURE);
+    }
+    if (!windowed_env) {
+        SDL_ShowCursor(SDL_DISABLE);
+    }
+
+    return ultramodern::renderer::WindowHandle{ s_window };
+}
+
+void update_gfx(void*) {
+    snp::handheld::poll_input();
+
+    constexpr float kFourByThree = 4.0f / 3.0f;
+    float widescreen_scale = 1.0f;
+    float tallscreen_scale = 1.0f;
+    if (ultramodern::renderer::get_graphics_config().ar_option == ultramodern::renderer::AspectRatio::Expand) {
+        int width = 0, height = 0;
+        if (s_window != nullptr) {
+            SDL_GetWindowSize(s_window, &width, &height);
+            if (width > 0 && height > 0) {
+                float aspect = static_cast<float>(width) / static_cast<float>(height);
+                widescreen_scale = std::max(1.0f, aspect / kFourByThree);
+                tallscreen_scale = std::max(1.0f, kFourByThree / aspect);
+            }
+        }
+    }
+    snp::set_widescreen_scale(widescreen_scale);
+    snp::set_tallscreen_scale(tallscreen_scale);
+}
