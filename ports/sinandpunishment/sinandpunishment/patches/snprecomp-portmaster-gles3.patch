+constexpr uint32_t AUDIO_CHANNELS = 2;
+uint32_t s_game_frequency = 44100;
+constexpr uint32_t AUDIO_HEADROOM_VIS = 0;
+constexpr uint32_t AUDIO_SOFT_CAP_MS = 200;
+constexpr uint32_t AUDIO_HARD_CAP_MS = 500;
