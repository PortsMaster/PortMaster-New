+void ra_shutdown() {
+    s_workers_running.store(false);
+    s_worker_cv.notify_all();
+    for (auto& thread : s_worker_threads) {
+        if (thread.joinable()) {
+            thread.join();
+        }
+    }
+
+    {
+        std::lock_guard<std::recursive_mutex> lock(s_client_mutex);
+        if (s_client) {
+            rc_client_destroy(s_client);
+            s_client = nullptr;
+        }
+        reset_cached_summary();
+    }
+
+    if (s_libcurl_handle) {
+        dlclose(s_libcurl_handle);
+        s_libcurl_handle = nullptr;
+    }
+}
