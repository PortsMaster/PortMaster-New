@@ -0,0 +1,166 @@
+#include "gl_loader.h"
+#include <cstdio>
+
+namespace snp::gles3 {
+
+namespace gl {
+    PFNGLGETERRORPROC glGetError = nullptr;
+    PFNGLGETINTEGERVPROC glGetIntegerv = nullptr;
+    PFNGLGETSTRINGPROC glGetString = nullptr;
