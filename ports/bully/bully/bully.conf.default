# Bully: Anniversary Edition Final user configuration.
# Values outside these allowlists are ignored by the launcher.

# auto | es2 | es3
renderer=auto

# auto | profile | 0.5 | 0.75 | 1.0
render_scale=auto

# auto | low | medium | high
textures=auto

# auto keeps the engine choice and repairs reduced mip chains.
# on forces trilinear on complete/safe mip chains; off forces bilinear.
# auto | on | off
trilinear=auto

# auto | 50 | 60 | 70 | 75 | 80 | 100
# Numeric values map to BULLY2_STREAM_DISTANCE_PCT. auto leaves it unset.
stream_distance=auto

# auto uses device/evdev evidence, separates R36T/K36S from other GO-Super
# layouts, and applies the external ordinal fix only on its full signature.
# auto | normal | swap_xy | swap_ab | swap_both
face_buttons=auto

# on | off
input_debug=off

# on | off; off uses native SDL, on uses the editable bully.gptk fallback.
use_gptk=off

# native | touch; native uses the engine trigger axes without showing touch UI.
# touch keeps the old coordinate tap only as a compatibility fallback.
weapon_switch=native
