# Bully: Anniversary Edition
# Keep one value from each list.

# auto | es2 | es3
renderer=auto

# auto | profile | 0.5 | 0.75 | 1.0
render_scale=auto

# auto | low | medium | high
textures=auto

# auto | on | off
trilinear=auto

# auto | 50 | 60 | 70 | 75 | 80 | 100
stream_distance=auto

# auto | normal | swap_xy | swap_ab | swap_both
face_buttons=auto

# Native deferred shadows require RendererES3; RendererES2 ignores this value.
# off | on
shadows=off

# Native SDL is recommended. Enable this only to use bully.gptk.
# off | on
use_gptk=off
