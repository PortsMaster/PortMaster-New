# Optional GPTKey fallback. Native SDL is the default.

a = x
b = c
x = q
y = t

start = enter
back = esc

l1 = u
r1 = i
l2 = k
r2 = l
l3 = h
r3 = j

up = up
down = down
left = left
right = right

left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

mouse_scale = 512
deadzone_y = 15000
