# BULLY_GPTK_VERSION=3
# Bully2 -- editable gptokeyb fallback for PortMaster controls.
# Parser note: keep comments on their own lines.
#
# The right side is the fixed key contract understood by the loader:
#   x/c/q/t = final game face slots A/B/X/Y
#   u/i = L1/R1, k/l = eixos L2/R2, h/j = L3/R3
#   enter/esc = Start/Select, arrows = d-pad, WASD/mouse = analogs
#
# O default e neutro: o arquivo traduz cada controle para o mesmo slot Android.
# Trocas de face ficam explicitas aqui, sem uma segunda normalizacao automatica.

a = x
b = c
x = q
y = t

start = enter
back = esc

# L1/R1 miram/atiram. L2/R2 alimentam os eixos nativos de troca de item;
# weapon_switch=touch conserva o toque antigo apenas como fallback.
l1 = u
r1 = i
l2 = k
r2 = l
l3 = h
r3 = j

up = up
down = down
left = left
right = right

left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

mouse_scale = 512
deadzone_y = 15000
