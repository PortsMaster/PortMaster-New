#!/bin/bash
# Transactional first-run extractor for the user's legal Bully 1.4.311 data.
set -u
set -o pipefail

DEST="${2:-.}"
APK="${1:-}"
mkdir -p "$DEST" || exit 1
DEST="$(cd "$DEST" && pwd)"
BIN="${BULLY_BINARY:-$DEST/bully}"
GAMEDATA="${BULLY_GAMEDATA_DIR:-$DEST/gamedata}"
RUN_TOKEN="$$.$(date +%s 2>/dev/null || printf 0).${RANDOM:-0}.${RANDOM:-0}"
SETUPF="${BULLY_SETUP_FILE:-/tmp/bully_setup.$RUN_TOKEN.txt}"
STOPF="${BULLY_SETUP_STOP:-/tmp/bully_setup_stop.$RUN_TOKEN}"
SETUPLOG="${BULLY_SETUP_LOG:-$DEST/setup.log}"
MARKER="$DEST/.bully-v12-data.ok"
STAGE="$DEST/.bully-v12-stage.$RUN_TOKEN"
BACKUP="$DEST/.bully-v12-backup.$RUN_TOKEN"
LOCKDIR="$DEST/.bully-v12-extract.lock"
BUNDLE_DIR="$STAGE/.bundles"
PATCH_SCRIPT="$DEST/tools/patch-bully-menu.py"
VALIDATOR="$DEST/tools/validate-bully-data.py"
ENSURE_PATCH="$DEST/tools/ensure-bully-menu-patch"
LIBGAME_MD5=47468f5ce23ad05dc2a855b2801133b5
LIBGAME_BUILD_ID=6139a628aa7a260dd7bf443665bb822a459d5ba1
LIBCXX_SHA256=83269b3124a287fac36b17c9fb64beb398c83dad6677b19ce63cf80d09966fd7
PATCH_REVISION=1
EXTRACTION_TOTAL_BYTES=2910051840
SP=""
POLL=""
COMMIT_STARTED=0
COMMIT_DONE=0
LOCK_HELD=0
LIB_SOURCE=""
FILE_SIZE_BACKEND=""
declare -a SOURCES=()
declare -a SOURCE_PARENTS=()
declare -a VALID_SOURCES=()
declare -a USED_ORIGINALS=()
declare -a DATA_SOURCES=("" "" "" "" "")
declare -a DATA_PREFIXES=("" "" "" "" "")
declare -a IDX_SHA256=(
  357efd8fb79743807eecc1f4e451d13c5905b7fc6d05a273caa04ed0b5e05dcf
  7a7163f4a35633673aabf1a925582c6ac7de0b02380d9c070a57fc57107c8da2
  20b1deaf1a52ca09eb3cd672d29ee595ee4060642eeeffb6984788f9db21abd2
  47301aa41c4c18c206e3b7e1562de05c7fe43186a015f0b9a845fd6bff9138b2
  b25fe73bae7fac402ecbd0bb9f3c7b22444f7aff41104ab7a7977479e64db49d
)
declare -a DATA_ZIP_SIZES=(
  175603992 864079869 536975677 537122756 774609572
)
declare -a TOUCHED_FILES=()
declare -a INSTALL_FILES=(
  libGame.so libc++_shared.so
  assets/data_0.zip assets/data_0.zip.idx
  assets/data_1.zip assets/data_1.zip.idx
  assets/data_2.zip assets/data_2.zip.idx
  assets/data_3.zip assets/data_3.zip.idx
  assets/data_4.zip assets/data_4.zip.idx
