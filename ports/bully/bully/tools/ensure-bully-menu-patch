#!/bin/bash
# Generate and validate the Settings menu patch required by the Bully port.
set -u
set -o pipefail

GAMEDIR="${1:-.}"
data_zip="$GAMEDIR/assets/data_4.zip"
patch_zip="$GAMEDIR/assets/bully2_patch.zip"
patch_script="${BULLY_PATCH_SCRIPT:-$GAMEDIR/tools/patch-bully-menu.py}"

die() {
  echo "[menu] ERROR: $*" >&2
  exit 1
}

zip_has() {
  [ -f "$1" ] || return 1
  unzip -l "$1" "$2" 2>/dev/null \
    | awk -v entry="$2" \
      '$1 ~ /^[0-9]+$/ && $4 == entry { found=1 } END { exit !found }'
}

[ -s "$data_zip" ] || die "missing or empty $data_zip"
[ -s "$patch_script" ] || die "missing patch generator: $patch_script"
command -v python3 >/dev/null 2>&1 || die "python3 is required to generate the menu patch"
command -v unzip >/dev/null 2>&1 || die "unzip is required to validate the menu patch"

if ! python3 "$patch_script" "$data_zip" "$patch_zip"; then
  rm -f "$patch_zip.tmp"
  die "patch generator failed (wrong or damaged data_4.zip)"
fi

[ -s "$patch_zip" ] || die "patch generator produced an empty file"
unzip -tq "$patch_zip" >/dev/null 2>&1 || die "generated patch failed its ZIP test"
zip_has "$patch_zip" "resource_files.list" \
  || die "generated patch is missing resource_files.list"
zip_has "$patch_zip" "bully/MenuSettings.xml" \
  || die "generated patch is missing bully/MenuSettings.xml"

echo "[menu] patch ready: $patch_zip"
exit 0
