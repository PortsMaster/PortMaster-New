#!/bin/bash
# SPDX-License-Identifier: MIT
set -o pipefail
GAMEDIR=$(cd -- "$(dirname -- "$0")/.." && pwd -P) || exit 1
logfile="$GAMEDIR/repack.log"

# PortMaster's patcher reads these two lines from stdout.
pm_error() {
  echo "PATCH_FAIL_MSG:$1"
  echo "Patching process failed!"
}

echo "Streets of Rage 4 is checking the APK and preparing textures."
if bash "$GAMEDIR/repack.src" 2>&1 | tee "$logfile"; then
  echo "Patching process complete!"
else
  detail=$(tail -n 1 "$logfile" 2>/dev/null)
  detail=${detail#\[setup\] }
  pm_error "${detail:-Setup stopped.} See streetsofrage4/repack.log and launch again."
  exit 1
fi
