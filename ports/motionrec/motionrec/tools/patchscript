#!/bin/bash

GAMEDIR="$PWD"
LOGFILE="patchlog.txt"
LOGERR="patcherr.txt"

rm -f "$GAMEDIR/$LOGERR"
exec 3>&1
> "$GAMEDIR/$LOGFILE" && exec > >(tee "$GAMEDIR/$LOGFILE") 2>&1
echo "GAMEDIR is set to: $GAMEDIR"

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

export DATADIR="$GAMEDIR/assets"
export SAVEDIR="$GAMEDIR/saves"
export DATAFILE="motionrec.port"

# Tight-RAM devices can't sustain a parallel astcenc / vorbis workload.
THREADS_FLAG=""
if [ "${DEVICE_RAM:-0}" -lt 2 ]; then
    THREADS_FLAG="--threads 3"
fi

ORIG_MAX_FREQS=""
thermal_setup() {
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] && [ -f "$policy/scaling_max_freq" ] || continue
        orig=$(cat "$policy/scaling_max_freq") || continue
        target=$((orig * 8 / 10))
        $ESUDO sh -c "echo $target > '$policy/scaling_max_freq'" 2>/dev/null || true
        ORIG_MAX_FREQS="$ORIG_MAX_FREQS|$policy=$orig"
    done
}

thermal_restore() {
    OLDIFS=$IFS
    IFS='|'
    for entry in $ORIG_MAX_FREQS; do
        [ -z "$entry" ] && continue
        policy="${entry%=*}"
        orig="${entry#*=}"
        $ESUDO sh -c "echo $orig > '$policy/scaling_max_freq'" 2>/dev/null || true
    done
    IFS=$OLDIFS
}

prepare_files() {
    mkdir -p "$SAVEDIR"

    find "$DATADIR" -type f \( \
        -name "*.gitkeep" -o -name "*.exe" -o -name "*.dll" -o -name "*.hashdb" -o \
        -name "*.ico" -o -name "*.lnk" -o -name "*.msg" -o -name "*.zip" \
    \) -exec rm -f {} \;

    if [ -d "$SAVEDIR/textures" ]; then
        rm -rf "$SAVEDIR/textures"
    fi
}

apply_xdelta() {
    
    if ! "$controlfolder/xdelta3" -d -s "$DATADIR/data.win" -f "$GAMEDIR/tools/patch.xdelta" "$DATADIR/data2.win"; then
        emit_fail_msg "UTRY xdelta failed."
        return 1
    fi
    rm -f "$DATADIR/data.win"
    mv "$DATADIR/data2.win" "$DATADIR/game.droid"
}

patch_datafile() {
    if ! "$GAMEDIR/tools/gmtoolkit.${DEVICE_ARCH}" --config "$GAMEDIR/tools/gmtoolkit.json" $THREADS_FLAG "$DATADIR/game.droid"; then
     	emit_fail_msg "gmtoolkit patch failed."
    	return 1
    fi
}

zip_archive() {
    
    local zip_out
    if zip_out=$("$controlfolder/7zzs.${DEVICE_ARCH}" a -tzip -aoa -mx=0 "$GAMEDIR/$DATAFILE" "$DATADIR" 2>&1); then
        # Ensure the file write is fully flushed to the SD card
        sync   
        # Delete contents but ignore stubborn folders/symlinks gracefully
        rm -rf "$DATADIR"/* 2>/dev/null || true
    else
        echo "$zip_out"
        emit_fail_msg "Failed to create $DATAFILE."
        return 1
    fi
}
process_game() {
    echo "Applying xdelta..."
    apply_xdelta || return 1
    prepare_files || return 1
    echo "Preparing game..."
    thermal_setup
if [[ "$DEVICE_RAM" -lt 2 ]]; then
    echo "Compressing textures and audio..."
    patch_datafile
fi
    rc=$?
    thermal_restore
    [ "$rc" -ne 0 ] && return 1
    echo "Finishing up..."
    zip_archive || return 1
}
if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Patching failed. Report on the Portmaster Discord with patcherr.txt."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
    exit 1
fi
echo "Patching process complete!"
