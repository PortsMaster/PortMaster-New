# PortMaster GPTOKEYB Configuration for Station North SNfetchPLAYER
# Unified Face-Buttons: A=Enter, B=Esc, X=F, Y=Space, Start=P, Select=Tab

a = enter
b = esc
x = f
y = y

start = p
select = tab
back = tab
guide = tab

# PortMaster standard kill combo: SELECT + START
hotkey = select
hotkey_start = kill

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

l1 = left
r1 = right
l2 = esc
r2 = enter
