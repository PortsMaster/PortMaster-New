+
+/* SDL2 audio driver */
+
+#include "config.h"
+#include <stdio.h>
+#include "qdgdf_audio.h"
+
+#ifdef CONFOPT_SDL2
+
+#include <string.h>
+#include <stdlib.h>
+
+#include <SDL.h>
+
+/** data **/
+
+#define MIX_FREQUENCY       11025
+#define MIX_SAMPLES         512
+
+#define MAX_ORIGINAL_SOUNDS 64
+#define MAX_RESPAWN_SOUNDS  16
+#define MAX_SOUNDS          (MAX_ORIGINAL_SOUNDS + MAX_RESPAWN_SOUNDS)
+
+struct sound {
+    Sint16 *data;               /* stereo frames, MIX_FREQUENCY */
+    int frames;                 /* number of frames */
+    int offset;                 /* current playing frame */
+    int playing;                /* playing flag (0=off,1=on,2=loop) */
+    int pan;                    /* 1, 0, -1 */
+    int att;                    /* 63, full; 0, none */
+    int duped;                  /* sound-is-a-duplicate flag */
+};
+
+static struct sound _sounds[MAX_SOUNDS];
+
+static SDL_AudioDeviceID _audio_dev = 0;
+
+/* sequential sound handle */
+static int _program_seq = -1;
+
+
+/** code **/
+
+static void _audio_callback(void *userdata, Uint8 *stream, int len)
+{
+    Sint16 *out = (Sint16 *) stream;
+    int frames = len / (2 * sizeof(Sint16));
+    int n, m;
+
+    for (n = 0; n < frames; n++) {
+        int ls = 0, rs = 0;
+
+        for (m = 0; m < MAX_SOUNDS; m++) {
+            struct sound *ss = &_sounds[m];
+
+            if (ss->data && ss->playing) {
+                Sint16 *s = &ss->data[ss->offset * 2];
+
+                if (ss->pan != 1)
+                    ls += (s[0] * ss->att) / 63;
+                if (ss->pan != -1)
+                    rs += (s[1] * ss->att) / 63;
+
+                if (++ss->offset >= ss->frames) {
+                    ss->offset = 0;
+
+                    /* if not in loop, stop */
+                    if (ss->playing == 1)
+                        ss->playing = 0;
+                }
+            }
+        }
+
+        if (ls < -32768)
+            ls = -32768;
+        if (ls > 32767)
+            ls = 32767;
+        if (rs < -32768)
+            rs = -32768;
+        if (rs > 32767)
+            rs = 32767;
+
+        out[n * 2] = (Sint16) ls;
+        out[n * 2 + 1] = (Sint16) rs;
+    }
+}
+
+
+static Sint16 *_load_wav_frames(char *wavfile, int *frames)
+/* loads a .wav into memory, converted to the mixing format */
+{
+    FILE *f;
+    long size;
+    unsigned char *file_data;
+    SDL_AudioSpec spec;
+    Uint8 *wav_data;
+    Uint32 wav_len;
+    SDL_AudioCVT cvt;
+    Sint16 *ret = NULL;
+
+    if ((f = _qdgdfa_fopen(wavfile, "rb")) == NULL)
+        return NULL;
+
+    fseek(f, 0, SEEK_END);
+    size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+
+    file_data = malloc(size);
+
+    if (file_data == NULL || fread(file_data, 1, size, f) != (size_t) size) {
+        free(file_data);
+        fclose(f);
+        return NULL;
+    }
+
+    fclose(f);
+
+    if (SDL_LoadWAV_RW(SDL_RWFromConstMem(file_data, size), 1,
+                       &spec, &wav_data, &wav_len) == NULL) {
+        free(file_data);
+        return NULL;
+    }
+
+    free(file_data);
+
+    if (SDL_BuildAudioCVT(&cvt, spec.format, spec.channels, spec.freq,
+                          AUDIO_S16SYS, 2, MIX_FREQUENCY) < 0) {
+        SDL_FreeWAV(wav_data);
+        return NULL;
+    }
+
+    cvt.len = wav_len;
+    cvt.buf = malloc(wav_len * cvt.len_mult);
+
+    if (cvt.buf != NULL) {
+        memcpy(cvt.buf, wav_data, wav_len);
+
+        if (SDL_ConvertAudio(&cvt) == 0 && cvt.len_cvt >= 4) {
+            ret = (Sint16 *) cvt.buf;
+            *frames = cvt.len_cvt / (2 * sizeof(Sint16));
+        }
+        else
+            free(cvt.buf);
+    }
+
+    SDL_FreeWAV(wav_data);
+
+    return ret;
+}
+
+
+static int _valid(int snd)
+{
+    return snd >= 0 && snd < MAX_SOUNDS && snd <= _program_seq;
+}
+
+
+static int _qdgdfa_load_sound(char *wavfile)
+{
+    Sint16 *data;
+    int frames = 0;
+    struct sound *ss;
+
+    if (_program_seq == MAX_ORIGINAL_SOUNDS - 1)
+        return -1;
+
+    _program_seq++;
+
+    data = _load_wav_frames(wavfile, &frames);
+
+    SDL_LockAudioDevice(_audio_dev);
+
+    ss = &_sounds[_program_seq];
+    memset(ss, '\0', sizeof(*ss));
+    ss->data = data;
+    ss->frames = frames;
+    ss->att = 63;
+
+    SDL_UnlockAudioDevice(_audio_dev);
+
+    return _program_seq;
+}
+
+
+static int _qdgdfa_dup_sound(int snd)
+{
+    if (!_valid(snd) || _program_seq == MAX_ORIGINAL_SOUNDS - 1)
+        return -1;
+
+    _program_seq++;
+
+    SDL_LockAudioDevice(_audio_dev);
+
+    _sounds[_program_seq] = _sounds[snd];
+    _sounds[_program_seq].playing = 0;
+    _sounds[_program_seq].offset = 0;
+    _sounds[_program_seq].duped = 1;
+
+    SDL_UnlockAudioDevice(_audio_dev);
+
+    return _program_seq;
+}
+
+
+static void _qdgdfa_play_sound(int snd, int loop)
+{
+    if (!_valid(snd))
+        return;
+
+    SDL_LockAudioDevice(_audio_dev);
+
+    if (_sounds[snd].data && !_sounds[snd].playing)
+        _sounds[snd].playing = loop ? 2 : 1;
+
+    SDL_UnlockAudioDevice(_audio_dev);
+}
+
+
+static void _qdgdfa_respawn_sound(int snd)
+{
+    int n;
+
+    if (!_valid(snd))
+        return;
+
+    SDL_LockAudioDevice(_audio_dev);
+
+    /* find a usable slot */
+    for (n = MAX_ORIGINAL_SOUNDS; n < MAX_SOUNDS; n++) {
+        if (!_sounds[n].playing)
+            break;
+    }
+
+    if (n < MAX_SOUNDS && _sounds[snd].data) {
+        _sounds[n] = _sounds[snd];
+        _sounds[n].duped = 1;
+        _sounds[n].offset = 0;
+        _sounds[n].playing = 1;
+    }
+
+    SDL_UnlockAudioDevice(_audio_dev);
+}
+
+
+static void _qdgdfa_stop_sound(int snd)
+{
+    if (!_valid(snd))
+        return;
+
+    SDL_LockAudioDevice(_audio_dev);
+    _sounds[snd].playing = 0;
+    SDL_UnlockAudioDevice(_audio_dev);
+}
+
+
+static void _qdgdfa_set_pan(int snd, int pan)
+{
+    if (!_valid(snd))
+        return;
+
+    SDL_LockAudioDevice(_audio_dev);
+    _sounds[snd].pan = pan;
+    SDL_UnlockAudioDevice(_audio_dev);
+}
+
+
+static void _qdgdfa_set_attenuation(int snd, int att)
+{
+    if (!_valid(snd))
+        return;
+
+    SDL_LockAudioDevice(_audio_dev);
+    _sounds[snd].att = 63 - att;
+    SDL_UnlockAudioDevice(_audio_dev);
+}
+
+
+static void _qdgdfa_reset(void)
+{
+    int n;
+
+    SDL_LockAudioDevice(_audio_dev);
+
+    for (n = 0; n < MAX_SOUNDS; n++) {
+        if (_sounds[n].data != NULL && !_sounds[n].duped)
+            free(_sounds[n].data);
+    }
+
+    memset(_sounds, '\0', sizeof(_sounds));
+
+    SDL_UnlockAudioDevice(_audio_dev);
+
+    _program_seq = -1;
+}
+
+
+static void _qdgdfa_pause(int p)
+{
+    SDL_PauseAudioDevice(_audio_dev, p ? 1 : 0);
+}
+
+
+static int _qdgdfa_startup(void)
+{
+    SDL_AudioSpec want, have;
+
+    if (SDL_InitSubSystem(SDL_INIT_AUDIO) < 0) {
+        fprintf(stderr, "qdgdfa: SDL_InitSubSystem: %s\n", SDL_GetError());
+        return 0;
+    }
+
+    memset(&want, '\0', sizeof(want));
+    want.freq = MIX_FREQUENCY;
+    want.format = AUDIO_S16SYS;
+    want.channels = 2;
+    want.samples = MIX_SAMPLES;
+    want.callback = _audio_callback;
+
+    /* SDL converts to whatever the device really wants */
+    _audio_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
+
+    if (_audio_dev == 0) {
+        fprintf(stderr, "qdgdfa: SDL_OpenAudioDevice: %s\n", SDL_GetError());
+        SDL_QuitSubSystem(SDL_INIT_AUDIO);
+        return 0;
+    }
+
+    memset(_sounds, '\0', sizeof(_sounds));
+    _program_seq = -1;
+
+    SDL_PauseAudioDevice(_audio_dev, 0);
+
+    return 1;
+}
+
+
+static void _qdgdfa_shutdown(void)
+{
+    if (_audio_dev == 0)
+        return;
+
+    SDL_CloseAudioDevice(_audio_dev);
+    _audio_dev = 0;
+
+    _qdgdfa_reset();
+
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
+
+
+/* driver information */
+
+static struct _qdgdfa_driver drv = {
+    "sdl2",
+
+    _qdgdfa_load_sound,
+    _qdgdfa_dup_sound,
+    _qdgdfa_play_sound,
+    _qdgdfa_respawn_sound,
+    _qdgdfa_stop_sound,
+
+    _qdgdfa_set_pan,
+    _qdgdfa_set_attenuation,
+    _qdgdfa_reset,
+    _qdgdfa_pause,
+    _qdgdfa_startup,
+    _qdgdfa_shutdown
+};
+
+
+struct _qdgdfa_driver *sdl2a_drv_detect(void)
+/* detection function */
+{
+    if (_qdgdfa_startup())
+        return &drv;
+
+    return NULL;
+}
+
+#endif                          /* CONFOPT_SDL2 */
