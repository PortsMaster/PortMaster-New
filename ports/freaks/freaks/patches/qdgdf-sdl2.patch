+/*
+
+    Quick and Dirty Game Development Framework (QDGDF)
+
+    Angel Ortega <angel@triptico.com> et al.
+
+    This software is released into the public domain.
+    NO WARRANTY. See file LICENSE for details.
+
+*/
+
+/* SDL2 video driver */
+
+#include "config.h"
+#include <stdio.h>
+#include "qdgdf_video.h"
+
+#ifdef CONFOPT_SDL2
+
+#include <SDL.h>
+
+/** data **/
+
+static SDL_Window *_sdl_window = NULL;
+static SDL_Renderer *_sdl_renderer = NULL;
+static SDL_Texture *_sdl_texture = NULL;
+
+/* the ARGB screen sent to the texture */
+static unsigned char *_double_screen = NULL;
+
+/* last key pressed, for the release-on-next-poll logic */
+static SDL_Keycode _last_key = 0;
+
+
+/** code **/
+
+static void _qdgdfv_set_palette(void)
+{
+    /* the generic code fills _qdgdfv_extended_palette using the masks */
+}
+
+
+static void put_image(void)
+{
+    SDL_UpdateTexture(_sdl_texture, NULL, _double_screen,
+                      _qdgdfv_screen_x_size * sizeof(int));
+    SDL_RenderClear(_sdl_renderer);
+    SDL_RenderCopy(_sdl_renderer, _sdl_texture, NULL, NULL);
+    SDL_RenderPresent(_sdl_renderer);
+}
+
+
+static void _qdgdfv_dump_virtual_screen(void)
+{
+    _qdgdfv_scale_virtual_screen(_double_screen);
+    put_image();
+}
+
+
+static void _qdgdfv_dump_argb_screen(void)
+{
+    _qdgdfv_scale_argb_screen((int *) _double_screen);
+    put_image();
+}
+
+
+static void zero_2s_keys(void)
+{
+    int *keys[] = {
+        &_qdgdfv_key_up, &_qdgdfv_key_down, &_qdgdfv_key_left,
+        &_qdgdfv_key_right, &_qdgdfv_key_escape, &_qdgdfv_key_space,
+        &_qdgdfv_key_enter, &_qdgdfv_key_control, &_qdgdfv_key_shift_l,
+        &_qdgdfv_key_shift_r, &_qdgdfv_key_alnum, &_qdgdfv_key_pgup,
+        &_qdgdfv_key_pgdn, &_qdgdfv_key_home, &_qdgdfv_key_end,
+        &_qdgdfv_key_alt_l, &_qdgdfv_key_alt_r,
+        &_qdgdfv_key_f1, &_qdgdfv_key_f2, &_qdgdfv_key_f3,
+        &_qdgdfv_key_f4, &_qdgdfv_key_f5, &_qdgdfv_key_f6,
+        &_qdgdfv_key_f7, &_qdgdfv_key_f8, &_qdgdfv_key_f9,
+        &_qdgdfv_key_f10, NULL
+    };
+    int n;
+
+    for (n = 0; keys[n] != NULL; n++) {
+        if (*keys[n] == 2)
+            *keys[n] = 0;
+    }
+}
+
+
+static void key_set(SDL_Keycode k, int s)
+{
+    switch (k) {
+    case SDLK_UP:       _qdgdfv_key_up = s; break;
+    case SDLK_DOWN:     _qdgdfv_key_down = s; break;
+    case SDLK_LEFT:     _qdgdfv_key_left = s; break;
+    case SDLK_RIGHT:    _qdgdfv_key_right = s; break;
+    case SDLK_ESCAPE:   _qdgdfv_key_escape = s; break;
+    case SDLK_SPACE:    _qdgdfv_key_space = s; break;
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER: _qdgdfv_key_enter = s; break;
+    case SDLK_PAGEUP:   _qdgdfv_key_pgup = s; break;
+    case SDLK_PAGEDOWN: _qdgdfv_key_pgdn = s; break;
+    case SDLK_HOME:     _qdgdfv_key_home = s; break;
+    case SDLK_END:      _qdgdfv_key_end = s; break;
+    case SDLK_F1:       _qdgdfv_key_f1 = s; break;
+    case SDLK_F2:       _qdgdfv_key_f2 = s; break;
+    case SDLK_F3:       _qdgdfv_key_f3 = s; break;
+    case SDLK_F4:       _qdgdfv_key_f4 = s; break;
+    case SDLK_F5:       _qdgdfv_key_f5 = s; break;
+    case SDLK_F6:       _qdgdfv_key_f6 = s; break;
+    case SDLK_F7:       _qdgdfv_key_f7 = s; break;
+    case SDLK_F8:       _qdgdfv_key_f8 = s; break;
+    case SDLK_F9:       _qdgdfv_key_f9 = s; break;
+    case SDLK_F10:      _qdgdfv_key_f10 = s; break;
+    case SDLK_LALT:     _qdgdfv_key_alt_l = s; break;
+    case SDLK_RALT:     _qdgdfv_key_alt_r = s; break;
+    case SDLK_LCTRL:
+    case SDLK_RCTRL:    _qdgdfv_key_control = s; break;
+    case SDLK_LSHIFT:   _qdgdfv_key_shift_l = s; break;
+    case SDLK_RSHIFT:   _qdgdfv_key_shift_r = s; break;
+    default:
+        if ((k >= SDLK_0 && k <= SDLK_9) || (k >= SDLK_a && k <= SDLK_z)) {
+            _qdgdfv_key_alnum = s;
+            _qdgdfv_alnum = (char) k;
+        }
+        break;
+    }
+}
+
+
+static void _qdgdfv_input_poll(void)
+{
+    SDL_Event e;
+
+    zero_2s_keys();
+
+    while (SDL_PollEvent(&e)) {
+        switch (e.type) {
+        case SDL_KEYDOWN:
+            if (!e.key.repeat) {
+                _last_key = e.key.keysym.sym;
+                key_set(e.key.keysym.sym, 1);
+            }
+            break;
+
+        case SDL_KEYUP:
+            /* 2 indicates that the press will be removed next call */
+            key_set(e.key.keysym.sym, e.key.keysym.sym == _last_key ? 2 : 0);
+            break;
+
+        case SDL_QUIT:
+            _qdgdfv_key_escape = 1;
+            break;
+        }
+    }
+}
+
+
+static int _qdgdfv_timer(int reset)
+{
+    static Uint32 prev = 0;
+    Uint32 c;
+    int r;
+
+    c = SDL_GetTicks();
+    r = (int) (c - prev);
+
+    if (r < 0)
+        r = 0;
+
+    if (reset)
+        prev = c;
+
+    return r;
+}
+
+
+static int _qdgdfv_opengl(int onoff)
+{
+    return 0;
+}
+
+
+static int _qdgdfv_startup(void)
+{
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO | SDL_INIT_TIMER) < 0) {
+        qdgdfv_logger("qdgdfv_startup",
+                      qdgdfv_sprintf("SDL_Init: %s", SDL_GetError()));
+        return 0;
+    }
+
+    /* the scaling is done by the renderer */
+    _qdgdfv_scale = 1;
+    _qdgdfv_pixel_size = 4;
+
+    /* ARGB8888, in the mask/shift format fill_extended_palette() expects */
+    _qdgdfv_red_mask = _qdgdfv_green_mask = _qdgdfv_blue_mask = 0xff000000;
+    _qdgdfv_red_shift = 8;
+    _qdgdfv_green_shift = 16;
+    _qdgdfv_blue_shift = 24;
+
+    _sdl_window = SDL_CreateWindow(_qdgdfv_window_title,
+                                   SDL_WINDOWPOS_UNDEFINED,
+                                   SDL_WINDOWPOS_UNDEFINED,
+                                   _qdgdfv_screen_x_size,
+                                   _qdgdfv_screen_y_size,
+                                   SDL_WINDOW_FULLSCREEN_DESKTOP);
+
+    if (_sdl_window == NULL) {
+        qdgdfv_logger("qdgdfv_startup",
+                      qdgdfv_sprintf("SDL_CreateWindow: %s", SDL_GetError()));
+        return 0;
+    }
+
+    _sdl_renderer = SDL_CreateRenderer(_sdl_window, -1, 0);
+
+    if (_sdl_renderer == NULL) {
+        qdgdfv_logger("qdgdfv_startup",
+                      qdgdfv_sprintf("SDL_CreateRenderer: %s", SDL_GetError()));
+        return 0;
+    }
+
+    SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, "nearest");
+    SDL_RenderSetLogicalSize(_sdl_renderer, _qdgdfv_screen_x_size,
+                             _qdgdfv_screen_y_size);
+
+    _sdl_texture = SDL_CreateTexture(_sdl_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                     SDL_TEXTUREACCESS_STREAMING,
+                                     _qdgdfv_screen_x_size,
+                                     _qdgdfv_screen_y_size);
+
+    if (_sdl_texture == NULL) {
+        qdgdfv_logger("qdgdfv_startup",
+                      qdgdfv_sprintf("SDL_CreateTexture: %s", SDL_GetError()));
+        return 0;
+    }
+
+    SDL_SetTextureBlendMode(_sdl_texture, SDL_BLENDMODE_NONE);
+    SDL_SetRenderDrawColor(_sdl_renderer, 0, 0, 0, 255);
+    SDL_ShowCursor(SDL_DISABLE);
+
+    _qdgdfv_virtual_screen = (unsigned char *)
+        qdgdfv_malloc(_qdgdfv_screen_x_size * _qdgdfv_screen_y_size);
+
+    _double_screen = (unsigned char *)
+        qdgdfv_malloc(_qdgdfv_screen_x_size * _qdgdfv_screen_y_size * sizeof(int));
+
+    _qdgdfv_argb_screen = (int *) _double_screen;
+
+    _qdgdfv_set_palette();
+
+    qdgdfv_clear_virtual_screen();
+
+    _qdgdfv_full_screen = 1;
+
+    qdgdfv_logger("qdgdfv_startup", "SDL2 Driver startup");
+    return 1;
+}
+
+
+static void _qdgdfv_shutdown(void)
+{
+    if (_sdl_texture != NULL)
+        SDL_DestroyTexture(_sdl_texture);
+    if (_sdl_renderer != NULL)
+        SDL_DestroyRenderer(_sdl_renderer);
+    if (_sdl_window != NULL)
+        SDL_DestroyWindow(_sdl_window);
+
+    _sdl_texture = NULL;
+    _sdl_renderer = NULL;
+    _sdl_window = NULL;
+
+    SDL_QuitSubSystem(SDL_INIT_VIDEO | SDL_INIT_TIMER);
+
+    qdgdfv_logger("qdgdfv_shutdown", "SDL2 Driver shutdown");
+}
+
+
+/* driver information */
+
+static struct _qdgdfv_driver drv = {
+    "sdl2",
+    _qdgdfv_set_palette,
+    _qdgdfv_dump_virtual_screen,
+    _qdgdfv_dump_argb_screen,
+    _qdgdfv_input_poll,
+    _qdgdfv_timer,
+    _qdgdfv_opengl,
+    _qdgdfv_startup,
+    _qdgdfv_shutdown
+};
+
+
+struct _qdgdfv_driver *sdl2v_drv_detect(void)
+/* detection function */
+{
+    if (_qdgdfv_startup())
+        return &drv;
+
+    return NULL;
+}
+
+#endif                          /* CONFOPT_SDL2 */
