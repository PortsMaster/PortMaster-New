[config]
deadzone_triggers = 3000

# The game reads the pad itself through libGDX, and its circular action menu and
# pad prompts only exist while it sees a controller.
[controls]
exclusive = false

# F7/F8 are the game's L2/R2 keys; its pad mapping lacks the triggers, whose axis
# events freeze its SDL.
l2 = f7   # hold for diagonal movement, item slot 7
r2 = f8   # confirm move, item slot 8
back = hold_state extras
guide = hold_state extras

# Keyboard-only actions; the grab keeps the layer's buttons from also reaching the
# game as pad presses.
[controls:extras]
overlay = clear
exclusive = true

a = i     # inventory
b = m     # map
x = tab   # advanced skills
y = o     # character overview
up = l    # look around
down = k  # kick
left = q  # tumble
right = w # parry
l1 = x    # swap primary/secondary weapon
r1 = p    # swap weapon hands
