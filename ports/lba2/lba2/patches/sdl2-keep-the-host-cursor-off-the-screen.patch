diff --git a/src/video/sdl2/SDL_sdl2events.c b/src/video/sdl2/SDL_sdl2events.c
index 046c526..460f050 100644
--- a/src/video/sdl2/SDL_sdl2events.c
+++ b/src/video/sdl2/SDL_sdl2events.c
@@ -161,6 +161,14 @@ void SDL2_PumpEvents_Impl(SDL_VideoDevice *_this)
     if (_this->windows && !SDL_GetKeyboardFocus()) {
         SDL_SetKeyboardFocus(_this->windows);
     }
+
+    /* Same for mouse focus: with mouse->focus NULL, SDL_RedrawCursor() ignores
+     * cursor_visible and shows def_cursor, so SDL_HideCursor() does nothing.
+     * Focus is otherwise only set from SDL2_WINDOWEVENT_ENTER, which a
+     * KMSDRM/fbdev setup with no window manager never sends. */
+    if (_this->windows && !SDL_GetMouseFocus()) {
+        SDL_SetMouseFocus(_this->windows);
+    }
 }
 
 #endif /* SDL_VIDEO_DRIVER_SDL2 */
