 #define GAMEPAD_CAM_ALPHA_MAX_DEFAULT 10 /* elevation units per frame at full deflection, sens 10 (the ceiling) */
+
+/* Camera-relative movement (community; handheld ports) -----------------------*/
+/* With CameraRelativeMove on, the 8-way directional input names a direction in
+ * the CAMERA's frame and the hero auto-turns to face it and walks, instead of
+ * stock's tank rotate-in-place. The reference yaw is latched on a direction
+ * change rather than read live: Auto camera tracks the hero with loop gain 1, so
+ * a live mapping feeds back on itself and one held direction walks a circle.
+ * docs/CONTROLLER.md has the geometry, the latch and the scope. */
+#define CAM_RELATIVE_DEFAULT 1         /* on by default in this handheld fork; 0 = stock tank controls */
+#define CAM_RELATIVE_TURN_DEFAULT 2560 /* auto-turn rate, Beta units/sec (4096 = full circle; stock manual turn is 1024) */
+#define CAM_RELATIVE_TURN_MIN 512
+#define CAM_RELATIVE_TURN_MAX 4096
+
+/* Screen "up" in an isometric interior, as a world heading. LongProjectPointIso
+ * (LIB386/3D/LPROJISO.CPP) has no camera-angle term -- screen X from (x - z),
+ * screen Y from (x + z) -- so screen-up is fixed at Beta 2560 and screen-right
+ * at 1536, exactly 1024 apart like the 8-way offsets. Interiors therefore need
+ * no latch and read no camera. */
+#define ISO_SCREEN_UP_BETA 2560
