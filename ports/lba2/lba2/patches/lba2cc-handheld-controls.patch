+static S32 CamRelLatchYaw = 0;  /* camera yaw the current press was resolved against */
+static S32 CamRelLatchDir = -1; /* 8-way offset it was latched for; -1 = not driving */
+static S32 CamRelTarget = 0;    /* world Beta the hero is turning toward */
+
+/* Forget the latch, so the next press re-reads the camera. Called where the
+ * camera is deliberately re-oriented under the player (Center camera). */
+void CameraRelativeReset(void) {
+    CamRelLatchDir = -1;
+}
+
+/* The held 8-way direction as an offset from "away from the camera", in Beta
+ * units (4096 = full circle). +Beta is a left turn, matching ManualRealAngle's
+ * +1024 for I_LEFT. Returns -1 when nothing is held. */
+static S32 CamRelDirection(void) {
+    S32 up = (Input & I_UP) ? 1 : 0;
+    S32 down = (Input & I_DOWN) ? 1 : 0;
+    S32 left = (Input & I_LEFT) ? 1 : 0;
+    S32 right = (Input & I_RIGHT) ? 1 : 0;
+
+    /* Opposite pairs cancel. A physical D-pad cannot press both, but a stick, the
+     * keyboard and the console `input` harness can. */
+    if (up AND down)
+        up = down = 0;
+    if (left AND right)
+        left = right = 0;
+
+    if (up)
+        return left ? 512 : (right ? (4096 - 512) : 0);
+    if (down)
+        return left ? 1536 : (right ? (2048 + 512) : 2048);
+    if (left)
+        return 1024;
+    if (right)
+        return 4096 - 1024;
+
+    return -1;
+}
+
+/* Whether the scheme should drive the hero this frame: free player control only.
+ * It runs in interiors and exteriors and under every camera -- CamRelCameraYaw
+ * resolves the reference heading for each -- so nothing here tests CubeMode or
+ * the camera. Called at the top of the MOVE_MANUAL case, where Input is still
+ * the raw pad.
+ *
+ * Every term below is load-bearing; docs/CONTROLLER.md carries the reasoning.
+ * In short:
+ *   FlagAnim != ANIM_THEN / !(Jumping & 1023): a one-shot anim in flight. The
+ *     remap turns any held direction into a forward press, and the direction
+ *     block's unconditional InitAnim(GEN_ANIM_MARCHE, ANIM_REPEAT) overrides an
+ *     ANIM_THEN, restarting it every frame. Jumping needs its own term: stock
+ *     guards an in-flight jump on LastMyJoy, the previous frame's REAL pad,
+ *     which a synthetic Input makes miss.
+ *   !PtrZoneClimb: a ladder needs literal up AND down, and the remap only ever
+ *     emits up. The zone is known before the climb starts, so the scheme stands
+ *     down on approach rather than mid-climb.
+ *   !(Input & (I_ESQUIVE | I_THROW | I_ACTION_M)): while these are held, stock
+ *     steers by adding GetDeltaMove(&BoundAngle.Move) straight onto Beta -- the
+ *     same accumulator the auto-turn drives, so aiming snaps then crawls.
+ *
+ * Pushing, a jump in flight and an anim that owns rotation gate the auto-TURN
+ * (canturn at the call site), NOT the remap: it must keep feeding "forward"
+ * through them, or the stock block sees the real direction, never takes its
+ * `if (Pushing)` branch, and rotates out of contact. */
+static S32 CamRelActive(T_OBJET *ptrobj, U8 numobj) {
+    return CameraRelativeMove
+        AND(numobj == NUM_PERSO)
+            AND(ptrobj->Move == MOVE_MANUAL)
+                AND !CinemaMode
+                    AND !FlagClimbing
+                        AND !PtrZoneClimb
+                            AND(ptrobj->FlagAnim != ANIM_THEN)
+                                AND !(Jumping & 1023)
+                                    AND !(Input & (I_ESQUIVE | I_THROW | I_ACTION_M));
+}
+
+/* The world heading "away from the camera" -- what a forward press means.
+ * Interiors take the fixed isometric constant (derived in FOLLOWCAM_CFG.H).
+ * Outdoors, (2048 - BetaCam) is the heading the camera looks along, the same
+ * expression PERSO.CPP uses for the follow camera's forward lean: a stable
+ * per-scene angle under the classic cameras, hero-tracking under Auto camera,
+ * which is the case the caller's latch exists for. */
+static S32 CamRelCameraYaw(void) {
+    if (CubeMode == CUBE_INTERIEUR)
+        return ISO_SCREEN_UP_BETA;
+
+    return (2048 - BetaCam) & 4095;
+}
+
+/* Replaces ManualRealAngle while the scheme is driving: turn toward the latched
+ * world direction on the bound-angle MOVE accumulator (shortest arc, clamps on
+ * arrival, carries its sub-unit remainder so it is frame-rate independent --
+ * see README.md in the port's source package) instead of the rotation the tank
+ * path uses. */
+static void CamRelTurn(T_OBJET *ptrobj, S32 canturn) {
+    S32 beta = ptrobj->Obj.Beta & 4095;
+
+    /* The hero's facing is not ours to set: pushing a block, a jump in flight,
+     * or an anim that owns rotation. Park it exactly as ManualRealAngle does in
+     * the same situations, so no delta banks up in the accumulator and dumps
+     * into Beta the moment control comes back. */
+    if (!canturn) {
+        RestartMove(&ptrobj->BoundAngle.Move);
+        return;
+    }
+
+    /* BoundAngle.Cur is not maintained on the tank path (it only ever touches
+     * the raw .Move), and a collision, a script or a scene load can move Beta
+     * behind our back. Re-seed from the live Beta when they have drifted apart
+     * rather than turning from a stale origin. */
+    if (ptrobj->BoundAngle.Cur != beta)
+        InitBoundAngleMove(&ptrobj->BoundAngle, CameraRelativeTurnSpeed, beta, CamRelTarget);
+    else
+        ChangeSpeedBoundAngleMove(&ptrobj->BoundAngle, CameraRelativeTurnSpeed, CamRelTarget);
+
+    ptrobj->Obj.Beta = GetBoundAngleMove(&ptrobj->BoundAngle) & 4095;
+}
+
