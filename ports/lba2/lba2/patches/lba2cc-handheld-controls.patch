diff --git a/LIB386/SYSTEM/KEYBOARD.CPP b/LIB386/SYSTEM/KEYBOARD.CPP
index 42713d8..5d0800b 100644
--- a/LIB386/SYSTEM/KEYBOARD.CPP
+++ b/LIB386/SYSTEM/KEYBOARD.CPP
@@ -91,6 +91,18 @@ S32 GetAscii() {
 }
 
 S32 CheckKey(U32 key) {
+    /* 0 is the "unbound" sentinel everywhere in the config: DefKeysDefault95
+       leaves Key2 at 0, GamepadKeysDefault uses {0, 0} for actions a device has
+       no button for, and clearing a binding in the config menu writes 0. But 0
+       is also a real index here -- SDL_SCANCODE_UNKNOWN -- so without this guard
+       an unbound action reads TabKeys[0], and SDL sets that whenever a key it
+       cannot map is pressed. One unmappable key (a gpio-keys button on a
+       handheld, say) then fires *every* unbound action at once: the four item
+       shortcuts, the behaviour hotkeys, pause. Treat 0 as never pressed. */
+    if (key == 0) {
+        return 0;
+    }
+
     return ((key) < 256 ? TabKeys[(key)] & 0x80
                         : TabKeys[256 - 32 + ((key) >> 3)] & (1 << ((key) & 7)));
 }
