+/* ------------------------------------------------------------ */
+/* SDL2 - portable across every device/driver SDL2 itself        */
+/* already supports, no OSS/ALSA/PulseAudio device naming at all */
+/* ------------------------------------------------------------ */
+
+void slDSP::open ( const char *, int _rate, int _stereo, int _bps )
+{
+  (void) _bps ;
+
+  SDL_InitSubSystem ( SDL_INIT_AUDIO ) ;
+
+  SDL_AudioSpec want, have ;
+
+  SDL_zero ( want ) ;
+  want.freq     = _rate ;
+  want.format   = AUDIO_U8 ;
+  want.channels = _stereo ? 2 : 1 ;
+  want.samples  = 1024 ;
+  want.callback = NULL ;
+
+  sdlDevice = SDL_OpenAudioDevice ( NULL, 0, &want, &have, 0 ) ;
+
+  if ( sdlDevice == 0 )
+  {
+    fprintf ( stderr, "slDSP: SDL_OpenAudioDevice: %s\n", SDL_GetError () ) ;
+    error  = SL_TRUE ;
+    stereo = SL_FALSE ;
+    bps    = 1 ;
+    rate   = 8000 ;
+    init_bytes = 0 ;
+    return ;
+  }
+
+  error  = SL_FALSE ;
+  stereo = ( have.channels >= 2 ) ;
+  bps    = 8 ;
+  rate   = have.freq ;
+  init_bytes = 0 ;
+
+  SDL_PauseAudioDevice ( sdlDevice, 0 ) ;
+}
+
+void slDSP::close ()
+{
+  if ( ! error )
+    SDL_CloseAudioDevice ( sdlDevice ) ;
+}
+
+int slDSP::getDriverBufferSize ()
+{
+  if ( error )
+    return 0 ;
+
+  return 2048 ;
+}
+
+void slDSP::getBufferInfo ()
+{
+}
+
+void slDSP::write ( void *buffer, size_t length )
+{
+  if ( error || (int)length <= 0 )
+    return ;
+
+  /* Don't let the queue grow unbounded if the game falls behind. */
+  while ( SDL_GetQueuedAudioSize ( sdlDevice ) > (Uint32)( length * 4 ) )
+    SDL_Delay ( 1 ) ;
+
+  SDL_QueueAudio ( sdlDevice, buffer, (Uint32) length ) ;
+}
+
+void slDSP::stop ()
+{
+  if ( ! error )
+    SDL_ClearQueuedAudio ( sdlDevice ) ;
+}
+
+void slDSP::sync ()
+{
+  if ( ! error )
+    while ( SDL_GetQueuedAudioSize ( sdlDevice ) > 0 )
+      SDL_Delay ( 1 ) ;
+}
+
+float slDSP::secondsUsed ()
+{
+  if ( error )
+    return 0.0f ;
+
+  int samples_used = (int) SDL_GetQueuedAudioSize ( sdlDevice ) ;
+
+  if ( stereo )
+    samples_used /= 2 ;
+
+  return (float) samples_used / (float) rate ;
+}
+
+float slDSP::secondsRemaining ()
+{
+  if ( error )
+    return 0.0f ;
+
+  const int target_buffer_bytes = 8192 ;
+
+  int samples_left = target_buffer_bytes - (int) SDL_GetQueuedAudioSize ( sdlDevice ) ;
+
+  if ( samples_left < 0 )
+    samples_left = 0 ;
+
+  if ( stereo )
+    samples_left /= 2 ;
+
+  return (float) samples_left / (float) rate ;
+}
