 local DRAG = 0.15
 
+-- Coarser sampling: only scan every Nth pixel in each axis when building a
+-- sprite's cached splatter data (roughly a 1/(STEP^2) cut in point count).
+-- Trades a bit of visual density for a meaningful perf win on weak hardware.
+local PIXEL_SAMPLE_STEP = 2
+
+-- Per-texture cache of the (expensive) opaque-pixel scan: color, position,
+-- and bounding box only depend on the sprite itself, not on how/when it
+-- died, so this only needs to be computed once per distinct texture/quad
+-- rather than on every single death. Velocity is still computed fresh per
+-- death below, since that genuinely depends on hit direction/point.
+local pixel_scan_cache = {}
+
+local function get_or_build_pixel_scan(cache_key, data, width, height, offset_x, offset_y)
+    local cached = pixel_scan_cache[cache_key]
+    if cached then
+        return cached
+    end
+
+    local entries = {}
+    local c = 1
+    local true_start_x, true_start_y = math.huge, math.huge
+    local true_end_x, true_end_y = 0, 0
+
+    for y_ = 0, height - 1, PIXEL_SAMPLE_STEP do
+        for x_ = 0, width - 1, PIXEL_SAMPLE_STEP do
+            local r, g, b, a = data:getPixel(x_ + offset_x, y_ + offset_y)
+            if a == 0 then goto continue end
+
+            if x_ < true_start_x then true_start_x = x_ end
+            if y_ < true_start_y then true_start_y = y_ end
+            if x_ > true_end_x then true_end_x = x_ end
+            if y_ > true_end_y then true_end_y = y_ end
+
+            entries[c] = {
+                x_ = x_,
+                y_ = y_,
+                r = r,
+                g = g,
+                b = b,
+                a = a,
+                start_x = x_ - width / 2,
+                start_y = y_ - height / 2,
+            }
+            c = c + 1
+            ::continue::
+        end
+    end
+
+    cached = {
+        entries = entries,
+        true_start_x = true_start_x,
+        true_start_y = true_start_y,
+        true_end_x = true_end_x,
+        true_end_y = true_end_y,
+    }
+    pixel_scan_cache[cache_key] = cached
+    return cached
+end
+
