+-- Stub replacement for the native "https" module (github.com/love2d/lua-https).
+--
+-- The real module is a compiled C extension (https.so / https.dll) that ships
+-- as a separate per-platform binary alongside the game. No aarch64 Linux build
+-- exists for this handheld's LOVE runtime, so `require "https"` has nothing to
+-- resolve to and crashes at boot inside lib/async_https.lua / async_https_worker.lua.
+--
+-- This shim satisfies the require() call and mimics https.request()'s return
+-- shape (code, body) with a failure result, so the A2 web/leaderboard SDK's
+-- normal "request failed" handling takes over instead of crashing the game.
+-- Effectively: online leaderboard/analytics submission is disabled on this
+-- platform; offline play is unaffected.
+
+local https = {}
+
+function https.request(_url, _options)
+    return nil, "https module not available on this platform"
+end
+
+return https
