@@ -8,6 +8,39 @@
 local PIXEL_COUNT = 10
 local SPEED = 5.0
 
+-- Per-texture cache of the sprite's opaque-pixel bounding box. Only
+-- depends on the sprite itself (not on when/how it died), so this only
+-- needs to be scanned once per distinct texture/quad instead of on every
+-- single death -- this effect is spawned alongside DeathSplatter on
+-- nearly every enemy death, so it was previously doubling the cost of
+-- the full per-pixel getPixel() scan on every death.
+local bbox_cache = {}
+
+local function get_or_build_bbox(cache_key, data, width, height, offset_x, offset_y)
+    local cached = bbox_cache[cache_key]
+    if cached then
+        return cached[1], cached[2], cached[3], cached[4]
+    end
+
+    local true_start_x, true_start_y = math.huge, math.huge
+    local true_end_x, true_end_y = 0, 0
+
+    for y_ = 0, height - 1 do
+        for x_ = 0, width - 1 do
+            local r, g, b, a = data:getPixel(x_ + offset_x, y_ + offset_y)
+            if a == 0 then goto continue end
+            if x_ < true_start_x then true_start_x = x_ end
+            if y_ < true_start_y then true_start_y = y_ end
+            if x_ > true_end_x then true_end_x = x_ end
+            if y_ > true_end_y then true_end_y = y_ end
+            ::continue::
+        end
+    end
+
+    bbox_cache[cache_key] = { true_start_x, true_start_y, true_end_x, true_end_y }
+    return true_start_x, true_start_y, true_end_x, true_end_y
+end
+
