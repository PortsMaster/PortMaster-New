--- itch/screen/CanvasLayer.lua	2025-08-15 23:10:22.000000000 +0800
+++ online/screen/CanvasLayer.lua	2026-08-16 19:59:46.625978000 +0800
@@ -639,6 +639,58 @@
 end
 
 function CanvasLayer:draw_shared()
+    if self.needs_own_canvas == false then
+        -- Opt-in fast path: skip this layer's own Canvas entirely (no set_canvas
+        -- switch, no composite draw at the end) and draw directly onto whatever
+        -- canvas the parent already has bound. Each Canvas switch is a real cost
+        -- on tile-based GPUs (forces a tile-buffer sync), and layers that don't
+        -- need their own render target (no independent blend mode/stencil use/
+        -- post-processing) waste one every frame for nothing. Mirrors the normal
+        -- path below minus the canvas-specific calls; self.pos is applied here
+        -- via translate since there's no composite-time graphics.draw(self.canvas,
+        -- self.pos.x, self.pos.y) to apply it for us.
+        graphics.push("all")
+        graphics.translate(self.pos.x, self.pos.y)
+
+        if self.handling_render and self.visible then
+            self:pre_world_draw()
+
+            graphics.scale(self.zoom, self.zoom)
+            graphics.translate(self.offset.x, self.offset.y)
+
+            for _, world in ipairs(self.worlds) do
+                world.viewport_size = self.viewport_size
+
+                world:draw_shared()
+            end
+
+            self:draw()
+        end
+
+        local update_interp = true
+
+        local start_here = 1
+
+        for i = #self.children, 1, -1 do
+            local layer = self.children[i]
+            if layer.blocks_render then
+                start_here = i
+                break
+            end
+        end
+
+        for i = start_here, #self.children do
+            local layer = self.children[i]
+            graphics.push("all")
+            layer:draw_shared()
+            graphics.pop()
+            layer.interp_fraction = update_interp and self.interp_fraction or layer.interp_fraction
+        end
+
+        graphics.pop()
+        return
+    end
+
     if self.expand_viewport then
         local new_size_x = (graphics.main_viewport_size or conf.viewport_size).x
         local new_size_y = (graphics.main_viewport_size or conf.viewport_size).y
