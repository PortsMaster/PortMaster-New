@@ -748,5 +748,25 @@
 -- end
 -- print(love.timer.get_time() - time)
 
+-- Insertion sort: O(n) on nearly-sorted data, vs table.sort's O(n log n) minimum.
+-- Same comparator interface as table.sort (comp(a, b) -> true if a belongs before b),
+-- so it's a drop-in replacement anywhere the input is expected to already be close
+-- to sorted (e.g. re-sorting a list of moving objects by Y position every frame,
+-- where relative order barely changes frame to frame).
+function tabley.insertion_sort(t, comp)
+    comp = comp or function(a, b) return a < b end
+    local n = #t
+    for i = 2, n do
+        local key = t[i]
+        local j = i - 1
+        while j >= 1 and comp(key, t[j]) do
+            t[j + 1] = t[j]
+            j = j - 1
+        end
+        t[j + 1] = key
+    end
+    return t
+end
+
 return tabley
 
